---

<Layout title="Galeri Dokumentasi Kegiatan - SMA Negeri Alor Kecil">
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    
    <!-- Judul Halaman -->
    <div class="text-center max-w-2xl mx-auto mb-10">
      <span class="text-xs font-black text-emerald-700 uppercase tracking-widest">Album Dokumentasi</span>
      <h1 class="text-3xl sm:text-4xl font-black text-slate-900 mt-1">Galeri Kegiatan Sekolah</h1>
      <p class="text-slate-500 text-xs sm:text-sm mt-2">
        Merekam jejak dinamika belajar, pembentukan karakter, serta prestasi keluarga besar SMA Negeri Alor Kecil.
      </p>
    </div>

    <!-- Tombol Filter Kategori Interaktif -->
    <div class="flex flex-wrap justify-center gap-2 mb-12">
      {daftarKategori.map((kat, index) => (
        <button
          class={`filter-btn px-4 py-2 rounded-xl text-xs font-bold transition duration-200 cursor-pointer ${
            index === 0
              ? 'bg-emerald-800 text-white shadow-sm filter-active'
              : 'bg-white text-slate-600 hover:bg-emerald-50 hover:text-emerald-800 border border-slate-200/80'
          }`}
          data-category={kat.slug}
        >
          {kat.label}
        </button>
      ))}
    </div>

    <!-- Grid Kartu Galeri -->
    <div id="galleryGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {galeriItems.map((item) => (
        <div 
          class="gallery-card bg-white rounded-3xl overflow-hidden border border-slate-200/80 shadow-xs hover:shadow-xl hover:-translate-y-1 transition duration-300 flex flex-col group cursor-pointer"
          data-cat={item.kategori}
          data-img={item.gambar}
          data-title={item.judul}
          data-date={item.tanggal}
          data-badge={item.labelKategori}
          data-desc={item.deskripsi}
        >
          <div class="relative h-56 overflow-hidden bg-slate-100">
            <img 
              src={item.gambar} 
              alt={item.judul}
              loading="lazy"
              class="w-full h-full object-cover group-hover:scale-105 transition duration-500"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition duration-300 flex items-end p-4">
              <span class="text-white text-xs font-bold flex items-center gap-1.5">
                <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7"/></svg>
                Perbesar Foto
              </span>
            </div>
            <span class="absolute top-4 left-4 bg-emerald-900/90 backdrop-blur-md text-amber-300 font-bold text-[10px] px-3 py-1 rounded-full uppercase tracking-wider">
              {item.labelKategori}
            </span>
          </div>

          <div class="p-6 flex flex-col flex-1">
            <span class="text-[11px] font-mono text-slate-400 mb-1.5">🕒 {item.tanggal}</span>
            <h3 class="font-bold text-slate-900 text-sm sm:text-base leading-snug group-hover:text-emerald-700 transition line-clamp-2">
              {item.judul}
            </h3>
            <p class="text-xs text-slate-500 mt-2 line-clamp-2 leading-relaxed flex-1">
              {item.deskripsi}
            </p>
          </div>
        </div>
      ))}
    </div>

    <!-- State Jika Data Filter Kosong -->
    <div id="emptyGallery" class="hidden text-center py-20 bg-white rounded-3xl border border-dashed border-slate-200">
      <p class="text-slate-400 text-sm">Tidak ada foto dalam kategori ini.</p>
    </div>

  </main>

  <!-- MODAL LIGHTBOX (POP-UP PRATINJAU FOTO) -->
  <div 
    id="imageModal" 
    class="fixed inset-0 z-50 bg-slate-950/90 backdrop-blur-sm hidden items-center justify-center p-4 sm:p-6 transition-opacity duration-300"
    role="dialog"
    aria-modal="true"
  >
    <div class="relative bg-white rounded-3xl max-w-3xl w-full overflow-hidden shadow-2xl flex flex-col animate-scaleUp">
      <!-- Tombol Tutup Modal -->
      <button 
        id="closeModal" 
        aria-label="Tutup pratinjau"
        class="absolute top-4 right-4 z-10 w-9 h-9 rounded-full bg-slate-950/70 hover:bg-slate-950 text-white flex items-center justify-center transition focus:outline-none"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>

      <!-- Gambar di Modal -->
      <div class="h-64 sm:h-96 w-full bg-slate-900 overflow-hidden flex items-center justify-center">
        <img id="modalImg" src="" alt="" class="w-full h-full object-contain" />
      </div>

      <!-- Informasi Keterangan -->
      <div class="p-6 bg-white">
        <div class="flex items-center gap-2 mb-2">
          <span id="modalBadge" class="bg-emerald-100 text-emerald-800 text-[10px] font-black px-2.5 py-0.5 rounded-full uppercase"></span>
          <span id="modalDate" class="text-xs text-slate-400 font-mono"></span>
        </div>
        <h2 id="modalTitle" class="text-base sm:text-lg font-black text-slate-900 leading-tight"></h2>
        <p id="modalDesc" class="text-xs sm:text-sm text-slate-600 mt-2 leading-relaxed"></p>
      </div>
    </div>
  </div>

  <style>
    @keyframes scaleUp {
      from {
        opacity: 0;
        transform: scale(0.95);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }
    .animate-scaleUp {
      animation: scaleUp 0.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
  </style>

  <!-- Script Interaktivitas Filter & Lightbox Modal -->
  <script>
    const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const cards = document.querySelectorAll<HTMLElement>('.gallery-card');
    const emptyState = document.getElementById('emptyGallery')!;

    // 1. Logika Filter Kategori
    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        // Reset style tombol
        filterBtns.forEach((b) => {
          b.classList.remove('bg-emerald-800', 'text-white', 'shadow-sm', 'filter-active');
          b.classList.add('bg-white', 'text-slate-600', 'border', 'border-slate-200/80');
        });

        // Aktifkan tombol yang diklik
        btn.classList.add('bg-emerald-800', 'text-white', 'shadow-sm', 'filter-active');
        btn.classList.remove('bg-white', 'text-slate-600', 'border', 'border-slate-200/80');

        const targetCategory = btn.getAttribute('data-category') || 'all';
        let visibleCount = 0;

        cards.forEach((card) => {
          const cardCat = card.getAttribute('data-cat');
          if (targetCategory === 'all' || cardCat === targetCategory) {
            card.classList.remove('hidden');
            visibleCount++;
          } else {
            card.classList.add('hidden');
          }
        });

        if (visibleCount === 0) {
          emptyState.classList.remove('hidden');
        } else {
          emptyState.classList.add('hidden');
        }
      });
    });

    // 2. Logika Lightbox Modal
    const modal = document.getElementById('imageModal')!;
    const closeModalBtn = document.getElementById('closeModal')!;
    const modalImg = document.getElementById('modalImg') as HTMLImageElement;
    const modalTitle = document.getElementById('modalTitle')!;
    const modalDesc = document.getElementById('modalDesc')!;
    const modalDate = document.getElementById('modalDate')!;
    const modalBadge = document.getElementById('modalBadge')!;

    function openModal(card: HTMLElement) {
      modalImg.src = card.getAttribute('data-img') || '';
      modalImg.alt = card.getAttribute('data-title') || '';
      modalTitle.textContent = card.getAttribute('data-title') || '';
      modalDesc.textContent = card.getAttribute('data-desc') || '';
      modalDate.textContent = `🕒 ${card.getAttribute('data-date') || ''}`;
      modalBadge.textContent = card.getAttribute('data-badge') || '';

      modal.classList.remove('hidden');
      modal.classList.add('flex');
      document.body.style.overflow = 'hidden'; // Kunci scroll halaman saat modal aktif
    }

    function closeModal() {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      document.body.style.overflow = ''; // Kembalikan scroll halaman
    }

    cards.forEach((card) => {
      card.addEventListener('click', () => openModal(card));
    });

    closeModalBtn.addEventListener('click', closeModal);

    // Tutup saat mengklik area gelap di luar modal
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    // Tutup saat menekan tombol Escape di keyboard
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
        closeModal();
      }
    });
  </script>
</Layout>