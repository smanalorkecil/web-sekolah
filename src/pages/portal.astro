// Pengelompokan Kategori untuk Navigasi Cepat
const kategoriUnik = [...new Set(daftarAplikasi.map((app) => app.kategori))];
---

<Layout 
  title="Portal Aplikasi Sekolah - SMA Negeri Alor Kecil" 
  description="Pintu gerbang terpadu akses sistem informasi, ujian CBT, LMS, presensi digital, tata usaha, dan sarpras SMA Negeri Alor Kecil."
>
  <!-- Breadcrumb -->
  <div class="bg-slate-50 border-b border-slate-200/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3.5">
      <nav class="flex items-center gap-2 text-xs text-slate-500 font-medium">
        <a href="/" class="hover:text-emerald-700 transition">Beranda</a>
        <span>/</span>
        <span class="text-slate-400">Layanan Digital</span>
        <span>/</span>
        <span class="text-emerald-800 font-bold">Portal Aplikasi</span>
      </nav>
    </div>
  </div>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    
    <!-- Header Halaman -->
    <header class="text-center max-w-2xl mx-auto mb-12">
      <div class="inline-flex items-center gap-2 bg-emerald-50 border border-emerald-200/80 text-emerald-800 text-[11px] font-black px-3.5 py-1 rounded-full uppercase tracking-wider mb-3">
        🚀 Single Sign-On / Gateway
      </div>
      <h1 class="text-3xl sm:text-4xl font-black text-slate-900 leading-tight">
        Portal Aplikasi Sekolah
      </h1>
      <p class="text-slate-500 text-xs sm:text-sm mt-2 leading-relaxed">
        Pusat akses cepat sistem informasi terintegrasi untuk mendukung kegiatan belajar mengajar, administrasi, dan tata kelola kelembagaan.
      </p>
    </header>

    <!-- Info Banner Pengingat -->
    <div class="bg-emerald-950 text-emerald-100 rounded-3xl p-6 sm:p-8 mb-12 shadow-sm flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 border border-emerald-900">
      <div class="space-y-1">
        <span class="bg-amber-400 text-slate-950 text-[10px] font-black px-3 py-0.5 rounded-full uppercase tracking-wider">
          Panduan Akses
        </span>
        <h3 class="text-base sm:text-lg font-black text-white mt-2">
          Gunakan Akun Belajar / Akun Resmi Madrasah/Sekolah
        </h3>
        <p class="text-xs text-emerald-200/80 leading-relaxed max-w-2xl">
          Sebagian besar aplikasi internal memerlukan login menggunakan email dinas atau akun Google yang telah didaftarkan oleh administrator IT sekolah.
        </p>
      </div>
      <a 
        href="https://wa.me/6281234567890" 
        target="_blank" 
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 bg-emerald-800 hover:bg-emerald-700 text-white text-xs font-bold px-4 py-2.5 rounded-xl border border-emerald-600/60 transition flex-shrink-0"
      >
        <span>Bantuan Akun & Sandi</span>
        <span>&rarr;</span>
      </a>
    </div>

    <!-- DAFTAR APLIKASI (GRID 3 KOLOM) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
      {daftarAplikasi.map((app) => (
        <article class="bg-white rounded-3xl p-6 sm:p-7 border border-slate-200/80 shadow-xs hover:shadow-xl hover:border-emerald-300 hover:-translate-y-1 transition duration-300 flex flex-col justify-between group">
          
          <div>
            <!-- Header Kartu: Ikon & Tag -->
            <div class="flex items-start justify-between gap-3 mb-5">
              <div class={`w-14 h-14 rounded-2xl bg-gradient-to-br ${app.warnaAksen} text-white text-2xl flex items-center justify-center shadow-md group-hover:scale-110 transition duration-300`}>
                {app.ikon}
              </div>
              <div class="text-right">
                <span class="inline-block bg-slate-100 text-slate-600 text-[10px] font-bold px-2.5 py-0.5 rounded-md uppercase tracking-wider mb-1">
                  {app.badge}
                </span>
                <span class="block text-[10px] text-slate-400 font-medium">
                  Hak Akses: <strong class="text-slate-700">{app.akses}</strong>
                </span>
              </div>
            </div>

            <!-- Nama & Deskripsi -->
            <span class="text-[11px] font-bold text-emerald-700 uppercase tracking-wider block mb-1">
              {app.kategori}
            </span>
            <h2 class="text-base sm:text-lg font-black text-slate-900 group-hover:text-emerald-800 transition leading-snug">
              {app.nama}
            </h2>
            <p class="text-xs text-slate-500 mt-2.5 leading-relaxed">
              {app.deskripsi}
            </p>
          </div>

          <!-- Tombol Eksternal Menuju Aplikasi -->
          <div class="mt-6 pt-5 border-t border-slate-100">
            <a 
              href={app.url} 
              target="_blank" 
              rel="noopener noreferrer"
              class="w-full inline-flex items-center justify-center gap-2 bg-slate-50 group-hover:bg-emerald-700 text-slate-700 group-hover:text-white font-bold text-xs py-2.5 px-4 rounded-xl border border-slate-200 group-hover:border-emerald-700 transition duration-200 shadow-xs"
            >
              <span>Buka Aplikasi</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
            </a>
          </div>

        </article>
      ))}
    </div>

    <!-- Catatan Penutup Privasi & Keamanan -->
    <div class="bg-slate-50 border border-slate-200/80 rounded-2xl p-6 text-center max-w-3xl mx-auto">
      <h4 class="text-xs font-bold text-slate-700">Keamanan Data & Etika Penggunaan</h4>
      <p class="text-[11px] text-slate-500 mt-1 leading-relaxed">
        Seluruh rekaman data presensi, nilai CBT, log persuratan, dan inventaris dilindungi oleh kebijakan tata kelola digital SMA Negeri Alor Kecil. Dilarang membagikan kredensial akun kepada pihak yang tidak berkepentingan.
      </p>
    </div>

  </main>
</Layout>