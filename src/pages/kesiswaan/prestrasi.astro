---
import Layout from '../../layouts/Layout.astro';

const listPrestasi = [
  { tahun: "2026", judul: "Juara 1 Lomba Inovasi Sains & Teknologi Terapan", bidang: "Sains / Riset", tingkat: "Kabupaten Alor" },
  { tahun: "2025", judul: "Medali Perak Cabor Atletik Lari Cepat O2SN", bidang: "Olahraga", tingkat: "Provinsi NTT" },
  { tahun: "2025", judul: "Juara Harapan 1 Festival Lomba Seni Siswa (FLS2N) Kategori Tari", bidang: "Seni Budaya", tingkat: "Provinsi NTT" },
  { tahun: "2024", judul: "Regu Tergiat Lomba Tingkat Kepanduan Pramuka Penegak", bidang: "Kepramukaan", tingkat: "Kwartir Cabang Alor" }
];
---

<Layout title="Prestasi Siswa - SMA Negeri Alor Kecil">

    <main class="max-w-5xl mx-auto px-4 py-12">
      <div class="text-center max-w-xl mx-auto mb-10">
        <span class="text-xs font-bold text-emerald-700 uppercase tracking-widest">Etalase Kebanggaan</span>
        <h1 class="text-2xl sm:text-3xl font-black text-slate-900 mt-1">Prestasi Siswa</h1>
        <p class="text-slate-500 text-xs sm:text-sm mt-2">Daftar torehan piala dan medali siswa dalam bidang akademik, seni, dan olahraga.</p>
      </div>

      <div class="space-y-4">
        {listPrestasi.map((p) => (
          <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-xs flex flex-col sm:flex-row sm:items-center justify-between gap-3 hover:border-emerald-500 transition">
            <div>
              <div class="flex items-center gap-2 mb-1">
                <span class="text-xs font-black text-amber-600 bg-amber-50 px-2 py-0.5 rounded">{p.tahun}</span>
                <span class="text-xs font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded">{p.tingkat}</span>
              </div>
              <h3 class="font-bold text-slate-900 text-sm sm:text-base">{p.judul}</h3>
            </div>
            <span class="w-fit text-xs font-semibold text-slate-500 bg-slate-100 px-3 py-1 rounded-full">{p.bidang}</span>
          </div>
        ))}
      </div>
    </main>
</Layout>