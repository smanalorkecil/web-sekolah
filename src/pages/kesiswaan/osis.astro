---
import '../../styles/global.css';

const pengurusOsis = [
  { jabatan: "Ketua OSIS", nama: "Siswa Pilihan 1", kelas: "XI F-1" },
  { jabatan: "Wakil Ketua", nama: "Siswa Pilihan 2", kelas: "XI F-2" },
  { jabatan: "Sekretaris", nama: "Siswa Pilihan 3", kelas: "X E-3" },
  { jabatan: "Bendahara", nama: "Siswa Pilihan 4", kelas: "XI F-3" }
];
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Organisasi Siswa (OSIS) - SMA Negeri Alor Kecil</title>
  </head>
  <body class="bg-slate-50 text-slate-800 antialiased font-sans">
    <header class="bg-white border-b border-slate-200 py-4 px-6">
      <div class="max-w-5xl mx-auto flex justify-between items-center">
        <a href="/" class="font-bold text-xs sm:text-sm text-emerald-700 hover:text-emerald-800">&larr; Kembali ke Beranda</a>
        <span class="text-xs font-semibold text-slate-500">SMA Negeri Alor Kecil</span>
      </div>
    </header>

    <main class="max-w-5xl mx-auto px-4 py-12">
      <div class="text-center max-w-xl mx-auto mb-10">
        <span class="text-xs font-bold text-emerald-700 uppercase tracking-widest">Kepemimpinan Siswa</span>
        <h1 class="text-2xl sm:text-3xl font-black text-slate-900 mt-1">Pengurus OSIS & MPK</h1>
        <p class="text-slate-500 text-xs sm:text-sm mt-2">Wadah aspirasi, kreativitas, dan pembelajaran kepemimpinan demokratis peserta didik.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6 mb-12">
        {pengurusOsis.map((item) => (
          <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-xs text-center">
            <div class="w-16 h-16 rounded-full bg-emerald-100 text-emerald-800 flex items-center justify-center font-bold text-xl mx-auto mb-3">
              {item.nama.charAt(0)}
            </div>
            <span class="text-xs font-bold text-emerald-700 uppercase tracking-wider block">{item.jabatan}</span>
            <h3 class="font-bold text-slate-900 text-sm mt-1">{item.nama}</h3>
            <p class="text-xs text-slate-400 mt-1">{item.kelas}</p>
          </div>
        ))}
      </div>
    </main>
  </body>
</html>