---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Prestasi Siswa - SMA Negeri Alor Kecil">
  <main class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    
    <!-- Header Halaman -->
    <div class="text-center max-w-2xl mx-auto mb-10">
      <span class="text-xs font-black text-emerald-700 uppercase tracking-widest">Etalase Kebanggaan</span>
      <h1 class="text-3xl sm:text-4xl font-black text-slate-900 mt-1">Prestasi Siswa</h1>
      <p class="text-slate-500 text-xs sm:text-sm mt-2">
        Daftar torehan piala dan medali siswa dalam bidang akademik, seni, dan olahraga.
      </p>
    </div>

    <!-- Skeleton Loading -->
    <div id="prestasiLoading" class="space-y-4">
      {[1, 2, 3, 4].map(() => (
        <div class="h-24 bg-white border border-slate-200/80 rounded-2xl animate-pulse"></div>
      ))}
    </div>

    <!-- Kontainer Daftar Prestasi -->
    <div id="prestasiList" class="space-y-4 hidden"></div>

    <!-- Tampilan Jika Kosong -->
    <div id="prestasiEmpty" class="text-center py-16 bg-white rounded-3xl border border-dashed border-slate-200 hidden">
      <p class="text-slate-400 text-sm font-medium">Belum ada data prestasi yang dicatat di Spreadsheet.</p>
    </div>

  </main>

  <script>
    const SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbyznE6zNM03r4D0GVTQ1AixI2DhOlodr6pvW2hTyX4xUi476zuZQvpnNTeQPb81Q8lTNw/exec';
    const prestasiLoading = document.getElementById('prestasiLoading')!;
    const prestasiList = document.getElementById('prestasiList')!;
    const prestasiEmpty = document.getElementById('prestasiEmpty')!;

    // Peta Nama Bulan Bahasa Indonesia
    const bulanIndo: { [key: string]: number } = {
      jan: 0, januari: 0,
      feb: 1, februari: 1,
      mar: 2, maret: 2,
      apr: 3, april: 3,
      mei: 4,
      jun: 5, juni: 5,
      jul: 6, juli: 6,
      agu: 7, ags: 7, agustus: 7,
      sep: 8, september: 8,
      okt: 9, oktober: 9,
      nov: 10, november: 10,
      des: 11, desember: 11
    };

    // Fungsi Pengonversi Teks Tanggal Menjadi Timestamp Angka
    function ubahKeTimestamp(teksTgl: string, tahunFallback: string): number {
      if (!teksTgl && !tahunFallback) return 0;
      
      const str = (teksTgl || '').trim().toLowerCase();
      
      // 1. Cek jika format teks standar Indonesia (contoh: "11 Sep 2026" atau "11 September 2026")
      const bagian = str.split(/[\s,/-]+/);
      if (bagian.length >= 3) {
        let tgl = parseInt(bagian[0], 10);
        let blnKey = bagian[1];
        let thn = parseInt(bagian[2], 10);

        // Jika format terbalik (contoh: 2026-09-11)
        if (bagian[0].length === 4) {
          thn = parseInt(bagian[0], 10);
          blnKey = bagian[1];
          tgl = parseInt(bagian[2], 10);
        }

        let blnIdx = bulanIndo[blnKey];
        if (blnIdx === undefined) {
          blnIdx = parseInt(blnKey, 10) - 1;
        }

        if (!isNaN(tgl) && blnIdx >= 0 && !isNaN(thn)) {
          return new Date(thn, blnIdx, tgl).getTime();
        }
      }

      // 2. Coba parse otomatis lewat Date bawaan JS
      const parsed = Date.parse(teksTgl);
      if (!isNaN(parsed)) return parsed;

      // 3. Fallback jika hanya ada tahun (contoh: "2026")
      const thnOnly = parseInt(tahunFallback || teksTgl, 10);
      if (!isNaN(thnOnly)) {
        return new Date(thnOnly, 0, 1).getTime();
      }

      return 0;
    }

    // Fungsi pembantu pembaca nilai tanpa peduli spasi / huruf besar
    function ambilNilai(obj: any, daftarKunci: string[]): string {
      if (!obj || typeof obj !== 'object') return '';
      const keys = Object.keys(obj);
      for (const kunci of daftarKunci) {
        if (obj[kunci] !== undefined && obj[kunci] !== null && String(obj[kunci]).trim() !== '') {
          return String(obj[kunci]).trim();
        }
        const kunciBersih = kunci.toLowerCase().replace(/[\s_-]/g, '');
        const cocok = keys.find((k) => k.toLowerCase().replace(/[\s_-]/g, '') === kunciBersih);
        if (cocok && obj[cocok] !== undefined && obj[cocok] !== null && String(obj[cocok]).trim() !== '') {
          return String(obj[cocok]).trim();
        }
      }
      return '';
    }

    fetch(SCRIPT_URL + '?tab=Prestasi')
      .then((res) => res.json())
      .then((data) => {
        prestasiLoading.classList.add('hidden');

        if (Array.isArray(data) && data.length > 0) {
          prestasiList.classList.remove('hidden');
          prestasiList.innerHTML = '';

          // ========================================================
          // PENGURUTAN OTOMATIS: DARI TANGGAL PALING BARU KE PALING LAMA
          // ========================================================
          data.sort((a, b) => {
            const tglA = ambilNilai(a, ['Tanggal', 'TanggalLomba', 'tgl']);
            const thnA = ambilNilai(a, ['Tahun', 'thn']);
            const timeA = ubahKeTimestamp(tglA, thnA);

            const tglB = ambilNilai(b, ['Tanggal', 'TanggalLomba', 'tgl']);
            const thnB = ambilNilai(b, ['Tahun', 'thn']);
            const timeB = ubahKeTimestamp(tglB, thnB);

            return timeB - timeA; // Descending (terbaru di atas)
          });

          data.forEach((item) => {
            const tanggal = ambilNilai(item, ['Tanggal', 'TanggalLomba', 'tgl']);
            const tahun = ambilNilai(item, ['Tahun', 'thn']) || (tanggal ? tanggal.split(' ').pop() : '-');
            const tingkat = ambilNilai(item, ['Tingkat', 'tingkat']) || 'Sekolah';
            const namaPrestasi = ambilNilai(item, ['NamaPrestasi', 'prestasi', 'judul', 'nama']) || '-';
            const bidang = ambilNilai(item, ['Bidang', 'bidang', 'kategori']) || 'Umum';

            const card = document.createElement('div');
            card.className = 'bg-white rounded-2xl border border-slate-200/80 p-5 sm:p-6 shadow-xs hover:shadow-md transition-all duration-300 flex flex-col sm:flex-row sm:items-center justify-between gap-4 group';

            card.innerHTML = `
              <div class="space-y-2">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="bg-amber-100 text-amber-800 text-[11px] font-black px-2.5 py-0.5 rounded-md">
                    ${tahun}
                  </span>
                  <span class="bg-emerald-50 text-emerald-700 text-[11px] font-bold px-2.5 py-0.5 rounded-md">
                    ${tingkat}
                  </span>
                  ${tanggal ? `
                    <span class="text-[11px] text-slate-400 font-medium flex items-center gap-1">
                      <span>•</span> 📅 ${tanggal}
                    </span>
                  ` : ''}
                </div>
                <h3 class="font-bold text-slate-900 text-base sm:text-lg leading-snug group-hover:text-emerald-700 transition">
                  ${namaPrestasi}
                </h3>
              </div>
              <div class="self-start sm:self-center flex-shrink-0">
                <span class="inline-block bg-slate-50 border border-slate-200 text-slate-600 text-xs font-medium px-3.5 py-1 rounded-full">
                  ${bidang}
                </span>
              </div>
            `;

            prestasiList.appendChild(card);
          });
        } else {
          prestasiEmpty.classList.remove('hidden');
        }
      })
      .catch((err) => {
        console.error('Gagal mengambil data prestasi:', err);
        prestasiLoading.innerHTML = '<p class="text-rose-600 text-xs font-bold text-center py-8">Gagal memuat data prestasi dari Google Sheets.</p>';
      });
  </script>
</Layout>