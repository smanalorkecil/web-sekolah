---
import '../../styles/global.css';

const aturanSeragam = [
  { hari: "Senin – Selasa", seragam: "Seragam Putih Abu-abu lengkap (Dasi, Topi Upacara, Ikat Pinggang & Sepatu Hitam)" },
  { hari: "Rabu", seragam: "Pakaian Khas Sekolah / Batik / Tenun Tradisional Alor" },
  { hari: "Kamis", seragam: "Pakaian Olahraga Sekolah (Saat Jam Olahraga) / Khusus" },
  { hari: "Jumat – Sabtu", seragam: "Pakaian Seragam Pramuka Lengkap dengan Hasduk dan Baret/Boni" }
];
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Tata Tertib Siswa - SMA Negeri Alor Kecil</title>
  </head>
  <body class="bg-slate-50 text-slate-800 antialiased font-sans">
    <header class="bg-white border-b border-slate-200 py-4 px-6">
      <div class="max-w-5xl mx-auto flex justify-between items-center">
        <a href="/" class="font-bold text-xs sm:text-sm text-emerald-700 hover:text-emerald-800">&larr; Kembali ke Beranda</a>
        <span class="text-xs font-semibold text-slate-500">SMA Negeri Alor Kecil</span>
      </div>
    </header>

    <main class="max-w-4xl mx-auto px-4 py-12">
      <div class="text-center max-w-xl mx-auto mb-10">
        <span class="text-xs font-bold text-emerald-700 uppercase tracking-widest">Kedisiplinan & Karakter</span>
        <h1 class="text-2xl sm:text-3xl font-black text-slate-900 mt-1">Tata Tertib Peserta Didik</h1>
        <p class="text-slate-500 text-xs sm:text-sm mt-2">Pedoman norma, kehadiran, dan etika berbusana di lingkungan satuan pendidikan.</p>
      </div>

      <!-- Jam Masuk -->
      <div class="bg-emerald-900 text-white p-6 rounded-2xl mb-8 shadow-sm">
        <h2 class="font-bold text-base mb-2">⏰ Jam Kehadiran Sekolah</h2>
        <p class="text-xs sm:text-sm text-emerald-100 leading-relaxed">
          Seluruh siswa wajib hadir di sekolah sebelum pukul <strong>07.15 WITA</strong> untuk mengikuti literasi pagi / apel pagi bersama. Gerbang sekolah ditutup pukul 07.20 WITA.
        </p>
      </div>

      <!-- Ketentuan Seragam -->
      <div class="bg-white rounded-2xl border border-slate-200/80 shadow-xs p-6 mb-8">
        <h2 class="font-bold text-slate-900 text-base mb-4">👔 Ketentuan Seragam Harian</h2>
        <div class="divide-y divide-slate-100 text-xs sm:text-sm">
          {aturanSeragam.map((item) => (
            <div class="py-3 flex flex-col sm:flex-row sm:items-center justify-between gap-1">
              <span class="font-bold text-emerald-800 sm:w-36">{item.hari}</span>
              <span class="text-slate-600 flex-1">{item.seragam}</span>
            </div>
          ))}
        </div>
      </div>
    </main>
  </body>
</html>