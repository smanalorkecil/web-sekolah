---
import Layout from '../../layouts/Layout.astro';
import { daftarAlbum } from '../../data/galeri';

const daftarKategori = [
  { slug: "all", label: "Semua Album" },
  { slug: "p5", label: "KBM & P5" },
  { slug: "ekskul", label: "Ekstrakurikuler" },
  { slug: "upacara", label: "Upacara & Hari Besar" },
  { slug: "prestasi", label: "Prestasi" }
];
---

<Layout title="Galeri Dokumentasi & Album Kegiatan - SMA Negeri Alor Kecil">
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    
    <!-- Header Halaman -->
    <div class="text-center max-w-2xl mx-auto mb-10">
      <span class="text-xs font-black text-emerald-700 uppercase tracking-widest">Dokumentasi Sekolah</span>
      <h1 class="text-3xl sm:text-4xl font-black text-slate-900 mt-1">Album Galeri Kegiatan</h1>
      <p class="text-slate-500 text-xs sm:text-sm mt-2">
        Kumpulan dokumentasi foto kegiatan pembelajaran, kesiswaan, dan prestasi SMA Negeri Alor Kecil.
      </p>
    </div>

    <!-- Filter Kategori Album -->
    <div class="flex flex-wrap justify-center gap-2 mb-12">
      {daftarKategori.map((kat, index) => (
        <button
          class={`filter-btn px-4 py-2 rounded-xl text-xs font-bold transition duration-200 cursor-pointer ${
            index === 0
              ? 'bg-emerald-800 text-white shadow-sm filter-active'
              : 'bg-white text-slate-600 hover:bg-emerald-50 hover:text-emerald-800 border border-slate-200/80'
          }`}
          data-category={kat.slug}
        >
          {kat.label}
        </button>
      ))}
    </div>

    <!-- Grid Album -->
    <div id="albumGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {daftarAlbum.map((album) => (
        <article 
          class="album-card bg-white rounded-3xl overflow-hidden border border-slate-200/80 shadow-xs hover:shadow-xl hover:-translate-y-1.5 transition duration-300 flex flex-col group"
          data-cat={album.kategori}
        >
          <!-- Gambar Sampul Album -->
          <div class="relative h-56 overflow-hidden bg-slate-100">
            <img 
              src={album.cover} 
              alt={album.judul}
              loading="lazy"
              class="w-full h-full object-cover group-hover:scale-105 transition duration-500"
            />
            
            <!-- Badge Jumlah Foto (Khas Album) -->
            <div class="absolute bottom-3 right-3 bg-slate-950/80 backdrop-blur-md text-white text-[11px] font-bold px-3 py-1 rounded-full flex items-center gap-1.5 shadow-sm">
              <svg class="w-3.5 h-3.5 text-amber-400" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M4 3a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V5a2 2 0 00-2-2H4zm12 12H4l4-8 3 6 2-4 3 6z" clip-rule="evenodd"/>
              </svg>
              <span>{album.fotoList.length} Foto</span>
            </div>

            <span class="absolute top-3 left-3 bg-emerald-900/90 backdrop-blur-md text-amber-300 font-bold text-[10px] px-3 py-1 rounded-full uppercase tracking-wider">
              {album.labelKategori}
            </span>
          </div>

          <!-- Keterangan Album -->
          <div class="p-6 flex flex-col flex-1">
            <span class="text-[11px] font-mono text-slate-400 mb-1.5">🕒 {album.tanggal}</span>
            <h2 class="font-bold text-base sm:text-lg text-slate-900 group-hover:text-emerald-700 transition line-clamp-2 leading-snug">
              <a href={`/galeri/${album.slug}`}>{album.judul}</a>
            </h2>
            <p class="text-xs text-slate-500 mt-2 line-clamp-2 leading-relaxed flex-1">
              {album.deskripsi}
            </p>

            <!-- Tombol Buka Album -->
            <a 
              href={`/galeri/${album.slug}`} 
              class="mt-6 pt-4 border-t border-slate-100 text-xs font-bold text-emerald-700 hover:text-emerald-900 flex items-center justify-between"
            >
              <span>Buka Album ({album.fotoList.length} Foto)</span>
              <span>&rarr;</span>
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- State Kosong -->
    <div id="emptyAlbums" class="hidden text-center py-20 bg-white rounded-3xl border border-dashed border-slate-200">
      <p class="text-slate-400 text-sm">Belum ada album dalam kategori ini.</p>
    </div>

  </main>
</Layout>

<!-- Filter Script -->
<script>
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('.album-card');
  const emptyState = document.getElementById('emptyAlbums')!;

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => {
        b.classList.remove('bg-emerald-800', 'text-white', 'shadow-sm', 'filter-active');
        b.classList.add('bg-white', 'text-slate-600', 'border', 'border-slate-200/80');
      });

      btn.classList.add('bg-emerald-800', 'text-white', 'shadow-sm', 'filter-active');
      btn.classList.remove('bg-white', 'text-slate-600', 'border', 'border-slate-200/80');

      const targetCategory = btn.getAttribute('data-category') || 'all';
      let visibleCount = 0;

      cards.forEach((card) => {
        const cardCat = card.getAttribute('data-cat');
        if (targetCategory === 'all' || cardCat === targetCategory) {
          card.classList.remove('hidden');
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      if (visibleCount === 0) {
        emptyState.classList.remove('hidden');
      } else {
        emptyState.classList.add('hidden');
      }
    });
  });
</script>