---
import Layout from '../../layouts/Layout.astro';
---

<Layout 
  title="Galeri Dokumentasi Kegiatan - SMA Negeri Alor Kecil"
  description="Kumpulan arsip visual kegiatan pembelajaran, ekstrakurikuler, dan peristiwa penting di SMA Negeri Alor Kecil."
>
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    
    <div class="text-center max-w-2xl mx-auto mb-10">
      <span class="text-xs font-black text-emerald-700 uppercase tracking-widest">Dokumentasi Sekolah</span>
      <h1 class="text-3xl sm:text-4xl font-black text-slate-900 mt-1">Album Galeri Kegiatan</h1>
      <p class="text-slate-500 text-xs sm:text-sm mt-2">
        Kumpulan arsip visual kegiatan pembelajaran, ekstrakurikuler, dan peristiwa penting di SMA Negeri Alor Kecil.
      </p>
    </div>

    <!-- Indikator Loading -->
    <div id="galeriLoading" class="text-center py-16">
      <div class="inline-block animate-spin rounded-full h-9 w-9 border-4 border-emerald-600 border-t-transparent mb-3"></div>
      <p class="text-xs font-semibold text-slate-500 tracking-wide">Menghubungkan ke basis data Google Drive...</p>
    </div>

    <!-- Grid Album Foto Utama -->
    <div id="galeriGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 hidden"></div>

    <!-- State Kosong -->
    <div id="galeriEmpty" class="text-center py-16 bg-white rounded-3xl border border-dashed border-slate-200 hidden">
      <p class="text-slate-400 text-sm font-medium">Belum ada folder dokumentasi kegiatan di Google Drive.</p>
    </div>

    <!-- ==================== 1. MODAL ALBUM (DAFTAR GRID FOTO 1:1) ==================== -->
    <div id="modalAlbum" class="fixed inset-0 z-40 bg-slate-950/80 backdrop-blur-xs hidden flex items-center justify-center p-4 sm:p-6">
      <div class="bg-white w-full max-w-4xl max-h-[90vh] rounded-3xl overflow-hidden flex flex-col shadow-2xl">
        
        <!-- Header Modal -->
        <div class="p-5 border-b border-slate-100 flex items-center justify-between gap-4">
          <div class="min-w-0 flex-1">
            <span id="modalKategori" class="text-[10px] font-bold text-emerald-700 uppercase tracking-wider block"></span>
            <h3 id="modalJudul" class="text-base sm:text-lg font-black text-slate-900 leading-snug truncate"></h3>
          </div>
          
          <div class="flex items-center gap-2 shrink-0">
            <!-- Tombol Salin Tautan Album -->
            <button 
              id="btnShareAlbum" 
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-emerald-50 text-slate-600 hover:text-emerald-700 text-xs font-bold transition"
              title="Salin Tautan Album"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/></svg>
              <span id="shareText" class="hidden sm:inline">Salin Link</span>
            </button>

            <!-- Tombol Tutup Album -->
            <button 
              id="modalClose" 
              class="p-2 rounded-xl text-slate-400 hover:bg-slate-100 hover:text-slate-700 transition text-2xl font-bold leading-none"
              aria-label="Tutup"
            >
              &times;
            </button>
          </div>
        </div>

        <!-- Kontainer Grid Foto 1:1 Presisi -->
        <div id="modalFotoList" class="p-5 overflow-y-auto grid grid-cols-2 sm:grid-cols-3 gap-3.5 sm:gap-4"></div>
      
      </div>
    </div>

    <!-- ==================== 2. LIGHTBOX VIEWER ALA INSTAGRAM ==================== -->
    <div 
      id="photoLightbox" 
      class="fixed inset-0 z-50 bg-black/95 backdrop-blur-md hidden select-none touch-pan-y"
      role="dialog"
      aria-modal="true"
    >
      <!-- Bar Atas: Counter Foto & Tombol Tutup -->
      <div class="absolute top-0 inset-x-0 p-4 sm:p-6 flex items-center justify-between text-white z-20 bg-gradient-to-b from-black/60 to-transparent">
        <span id="lightboxCounter" class="text-xs sm:text-sm font-mono tracking-wider font-semibold text-slate-200"></span>
        <button 
          id="closeLightbox" 
          class="w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 text-white flex items-center justify-center transition text-2xl font-bold"
          aria-label="Tutup Tampilan Penuh"
        >
          &times;
        </button>
      </div>

      <!-- Tombol Prev (Kiri) -->
      <button 
        id="btnPrevPhoto" 
        class="absolute left-3 sm:left-6 top-1/2 -translate-y-1/2 z-20 w-11 h-11 sm:w-14 sm:h-14 rounded-full bg-white/10 hover:bg-emerald-600 text-white flex items-center justify-center transition backdrop-blur-sm cursor-pointer shadow-lg"
        aria-label="Foto Sebelumnya"
      >
        <svg class="w-6 h-6 sm:w-8 sm:h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/></svg>
      </button>

      <!-- Tombol Next (Kanan) -->
      <button 
        id="btnNextPhoto" 
        class="absolute right-3 sm:right-6 top-1/2 -translate-y-1/2 z-20 w-11 h-11 sm:w-14 sm:h-14 rounded-full bg-white/10 hover:bg-emerald-600 text-white flex items-center justify-center transition backdrop-blur-sm cursor-pointer shadow-lg"
        aria-label="Foto Berikutnya"
      >
        <svg class="w-6 h-6 sm:w-8 sm:h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
      </button>

      <!-- Area Tampilan Foto Tengah -->
      <div id="lightboxArea" class="w-full h-full flex items-center justify-center p-4 sm:p-12">
        <img 
          id="lightboxImage" 
          src="" 
          alt="Dokumentasi Kegiatan" 
          referrerpolicy="no-referrer"
          class="max-w-full max-h-[85vh] object-contain rounded-xl shadow-2xl transition-opacity duration-200" 
        />
      </div>
    </div>

  </main>

  <script>
    const SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbyznE6zNM03r4D0GVTQ1AixI2DhOlodr6pvW2hTyX4xUi476zuZQvpnNTeQPb81Q8lTNw/exec';
    
    // Elemen DOM Halaman
    const galeriLoading = document.getElementById('galeriLoading')!;
    const galeriGrid = document.getElementById('galeriGrid')!;
    const galeriEmpty = document.getElementById('galeriEmpty')!;

    // Elemen DOM Modal Album
    const modalAlbum = document.getElementById('modalAlbum')!;
    const modalJudul = document.getElementById('modalJudul')!;
    const modalKategori = document.getElementById('modalKategori')!;
    const modalFotoList = document.getElementById('modalFotoList')!;
    const modalClose = document.getElementById('modalClose')!;
    const btnShareAlbum = document.getElementById('btnShareAlbum')!;
    const shareText = document.getElementById('shareText')!;

    // Elemen DOM Lightbox Viewer
    const photoLightbox = document.getElementById('photoLightbox')!;
    const lightboxImage = document.getElementById('lightboxImage') as HTMLImageElement;
    const lightboxCounter = document.getElementById('lightboxCounter')!;
    const closeLightbox = document.getElementById('closeLightbox')!;
    const btnPrevPhoto = document.getElementById('btnPrevPhoto')!;
    const btnNextPhoto = document.getElementById('btnNextPhoto')!;
    const lightboxArea = document.getElementById('lightboxArea')!;

    let dataAlbum: any[] = [];
    let currentAlbumIndex: number = -1;
    let currentPhotoIndex: number = 0;
    let activeSlug: string = '';

    function buatSlug(teks: string) {
      return teks
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/(^-|-$)/g, '');
    }

    function formatTgl(tglStr: string) {
      if (!tglStr) return '-';
      const date = new Date(tglStr);
      if (isNaN(date.getTime())) return tglStr;
      return date.toLocaleDateString('id-ID', {
        day: 'numeric',
        month: 'short',
        year: 'numeric',
      });
    }

    // Ambil Data Album dari Google Apps Script
    fetch(SCRIPT_URL + '?tab=galeri')
      .then((res) => res.json())
      .then((data) => {
        galeriLoading.classList.add('hidden');

        if (Array.isArray(data) && data.length > 0) {
          data.sort((a, b) => new Date(b.tanggal).getTime() - new Date(a.tanggal).getTime());
          dataAlbum = data;
          galeriGrid.classList.remove('hidden');
          galeriGrid.innerHTML = '';

          data.forEach((album, idx) => {
            const card = document.createElement('div');
            card.className = 'bg-white rounded-3xl overflow-hidden border border-slate-200/80 shadow-xs hover:shadow-xl transition-all duration-300 flex flex-col group cursor-pointer';
            
            const coverUrl = album.fotoSampul || album.cover || (album.foto && album.foto[0]?.thumbnail) || '/logo.png';
            const jumlah = album.totalFoto || album.jumlahFoto || (album.foto ? album.foto.length : 0);
            const tanggalFormatted = formatTgl(album.tanggal);

            card.innerHTML = `
              <div class="relative aspect-[4/3] overflow-hidden bg-slate-900">
                <img 
                  src="${coverUrl}" 
                  alt="${album.judul}" 
                  class="w-full h-full object-cover object-center group-hover:scale-105 transition duration-500" 
                  loading="lazy" 
                  referrerpolicy="no-referrer"
                />
                <span class="absolute top-3 right-3 bg-slate-950/80 backdrop-blur-md text-amber-300 text-[10px] font-bold px-2.5 py-1 rounded-lg">
                  📷 ${jumlah} Foto
                </span>
                <span class="absolute bottom-3 left-3 bg-emerald-700/90 backdrop-blur-md text-white text-[10px] font-bold px-2.5 py-1 rounded-lg uppercase">
                  ${album.kategori || 'Kegiatan'}
                </span>
              </div>
              <div class="p-5 flex flex-col flex-1 justify-between">
                <div>
                  <span class="text-[11px] text-slate-400 font-medium mb-1.5 block">📅 ${tanggalFormatted}</span>
                  <h3 class="font-bold text-slate-900 text-sm leading-snug group-hover:text-emerald-700 transition line-clamp-2">
                    ${album.judul}
                  </h3>
                </div>
                <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs font-bold text-emerald-700">
                  <span>Buka Seluruh Album</span>
                  <span>&rarr;</span>
                </div>
              </div>
            `;

            card.addEventListener('click', () => {
              bukaModalAlbum(idx, true);
            });

            galeriGrid.appendChild(card);
          });

          periksaParameterUrl();
        } else {
          galeriEmpty.classList.remove('hidden');
        }
      })
      .catch(() => {
        galeriLoading.innerHTML = '<p class="text-rose-600 text-xs font-bold">Gagal memuat album galeri dari Google Drive.</p>';
      });

    // BUKA MODAL ALBUM (Menampilkan semua foto 1:1)
    function bukaModalAlbum(index: number, updateUrl = true) {
      currentAlbumIndex = index;
      const album = dataAlbum[index];
      if (!album) return;

      activeSlug = buatSlug(album.judul);
      modalJudul.innerText = album.judul;
      modalKategori.innerText = `${album.kategori || 'Kegiatan'} • ${formatTgl(album.tanggal)}`;
      modalFotoList.innerHTML = '';

      if (Array.isArray(album.foto)) {
        album.foto.forEach((itemFoto: any, fotoIdx: number) => {
          const thumbUrl = typeof itemFoto === 'string' ? itemFoto : (itemFoto.thumbnail || itemFoto.url);

          // Gunakan tag DIV/BUTTON yang memicu Lightbox (bukan tag <a> open tab baru)
          const item = document.createElement('div');
          item.className = 'aspect-square w-full rounded-2xl overflow-hidden bg-slate-900 block shadow-xs hover:shadow-md transition group relative cursor-pointer';
          
          item.innerHTML = `
            <img 
              src="${thumbUrl}" 
              alt="${album.judul}"
              class="w-full h-full object-cover object-center group-hover:scale-105 transition duration-300" 
              loading="lazy" 
              referrerpolicy="no-referrer"
            />
            <div class="absolute inset-0 bg-black/20 opacity-0 group-hover:opacity-100 transition flex items-center justify-center">
              <svg class="w-6 h-6 text-white drop-shadow" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
            </div>
          `;

          // Ketuk foto untuk membuka Lightbox viewer
          item.addEventListener('click', () => {
            bukaLightbox(fotoIdx);
          });

          modalFotoList.appendChild(item);
        });
      }

      modalAlbum.classList.remove('hidden');
      document.body.style.overflow = 'hidden';

      if (updateUrl) {
        const urlBaru = new URL(window.location.href);
        urlBaru.searchParams.set('album', activeSlug);
        window.history.pushState({ modalOpen: true, slug: activeSlug }, '', urlBaru.toString());
      }
    }

    function tutupModalAlbum(updateUrl = true) {
      modalAlbum.classList.add('hidden');
      document.body.style.overflow = '';

      if (updateUrl) {
        const urlBersih = new URL(window.location.href);
        urlBersih.searchParams.delete('album');
        window.history.pushState({}, '', urlBersih.pathname);
      }
    }

    // ==================== LOGIKA LIGHTBOX ALA INSTAGRAM ====================
    function bukaLightbox(fotoIdx: number) {
      currentPhotoIndex = fotoIdx;
      tampilkanFotoLightbox();
      photoLightbox.classList.remove('hidden');
      photoLightbox.classList.add('flex');
    }

    function tutupLightboxModal() {
      photoLightbox.classList.add('hidden');
      photoLightbox.classList.remove('flex');
    }

    function tampilkanFotoLightbox() {
      const album = dataAlbum[currentAlbumIndex];
      if (!album || !Array.isArray(album.foto) || album.foto.length === 0) return;

      const foto = album.foto[currentPhotoIndex];
      const fullUrl = typeof foto === 'string' ? foto : foto.url;

      lightboxImage.style.opacity = '0.3';
      lightboxImage.src = fullUrl;
      lightboxImage.onload = () => {
        lightboxImage.style.opacity = '1';
      };

      lightboxCounter.innerText = `Foto ${currentPhotoIndex + 1} dari ${album.foto.length}`;
    }

    function fotoSebelumnya() {
      const album = dataAlbum[currentAlbumIndex];
      if (!album || !album.foto) return;
      currentPhotoIndex = (currentPhotoIndex - 1 + album.foto.length) % album.foto.length;
      tampilkanFotoLightbox();
    }

    function fotoBerikutnya() {
      const album = dataAlbum[currentAlbumIndex];
      if (!album || !album.foto) return;
      currentPhotoIndex = (currentPhotoIndex + 1) % album.foto.length;
      tampilkanFotoLightbox();
    }

    // Tombol Navigasi Lightbox
    btnPrevPhoto.addEventListener('click', (e) => {
      e.stopPropagation();
      fotoSebelumnya();
    });

    btnNextPhoto.addEventListener('click', (e) => {
      e.stopPropagation();
      fotoBerikutnya();
    });

    closeLightbox.addEventListener('click', tutupLightboxModal);

    // Ketuk area kosong di luar foto untuk menutup lightbox
    photoLightbox.addEventListener('click', (e) => {
      if (e.target === photoLightbox || e.target === lightboxArea) {
        tutupLightboxModal();
      }
    });

    // FITUR GESER (SWIPE GESTURE) DI LAYAR PONSEL / HP
    let touchStartX = 0;
    let touchEndX = 0;

    photoLightbox.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });

    photoLightbox.addEventListener('touchend', (e) => {
      touchEndX = e.changedTouches[0].screenX;
      handleSwipe();
    }, { passive: true });

    function handleSwipe() {
      const ambangBatas = 45; // Jarak minimal sapuan jari (pixel)
      if (touchEndX < touchStartX - ambangBatas) {
        // Geser ke kiri -> Foto berikutnya
        fotoBerikutnya();
      }
      if (touchEndX > touchStartX + ambangBatas) {
        // Geser ke kanan -> Foto sebelumnya
        fotoSebelumnya();
      }
    }

    // DUKUNGAN KEYBOARD (Panah Kiri, Kanan, Escape)
    window.addEventListener('keydown', (e) => {
      // Jika Lightbox sedang terbuka
      if (!photoLightbox.classList.contains('hidden')) {
        if (e.key === 'Escape') tutupLightboxModal();
        if (e.key === 'ArrowLeft') fotoSebelumnya();
        if (e.key === 'ArrowRight') fotoBerikutnya();
        return;
      }

      // Jika hanya Modal Album yang terbuka
      if (!modalAlbum.classList.contains('hidden')) {
        if (e.key === 'Escape') tutupModalAlbum(true);
      }
    });

    // Pengecekan URL Parameter awal
    function periksaParameterUrl() {
      const urlParams = new URLSearchParams(window.location.search);
      const targetAlbum = urlParams.get('album');

      if (targetAlbum) {
        const indexKetemu = dataAlbum.findIndex((alb) => buatSlug(alb.judul) === targetAlbum);
        if (indexKetemu !== -1) {
          bukaModalAlbum(indexKetemu, false);
        }
      }
    }

    // Modal Album Event Listeners
    modalClose.addEventListener('click', () => tutupModalAlbum(true));
    modalAlbum.addEventListener('click', (e) => {
      if (e.target === modalAlbum) tutupModalAlbum(true);
    });

    window.addEventListener('popstate', () => {
      const urlParams = new URLSearchParams(window.location.search);
      if (!urlParams.get('album')) {
        tutupLightboxModal();
        tutupModalAlbum(false);
      } else {
        periksaParameterUrl();
      }
    });

    // Salin Link Album
    btnShareAlbum?.addEventListener('click', () => {
      const linkLengkap = `${window.location.origin}${window.location.pathname}?album=${activeSlug}`;
      navigator.clipboard.writeText(linkLengkap).then(() => {
        if (shareText) shareText.textContent = 'Tersalin!';
        setTimeout(() => {
          if (shareText) shareText.textContent = 'Salin Link';
        }, 2000);
      });
    });
  </script>
</Layout>