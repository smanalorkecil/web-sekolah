---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Galeri Dokumentasi Kegiatan - SMA Negeri Alor Kecil">
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    
    <div class="text-center max-w-2xl mx-auto mb-10">
      <span class="text-xs font-black text-emerald-700 uppercase tracking-widest">Dokumentasi Sekolah</span>
      <h1 class="text-3xl sm:text-4xl font-black text-slate-900 mt-1">Album Galeri Kegiatan</h1>
      <p class="text-slate-500 text-xs sm:text-sm mt-2">
        Kumpulan arsip visual kegiatan pembelajaran, ekstrakurikuler, dan peristiwa penting di SMA Negeri Alor Kecil.
      </p>
    </div>

    <!-- Indikator Loading -->
    <div id="galeriLoading" class="text-center py-16">
      <div class="inline-block animate-spin rounded-full h-9 w-9 border-4 border-emerald-600 border-t-transparent mb-3"></div>
      <p class="text-xs font-semibold text-slate-500 tracking-wide">Menghubungkan ke basis data Google Drive...</p>
    </div>

    <!-- Grid Album Foto -->
    <div id="galeriGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 hidden"></div>

    <!-- State Kosong -->
    <div id="galeriEmpty" class="text-center py-16 bg-white rounded-3xl border border-dashed border-slate-200 hidden">
      <p class="text-slate-400 text-sm font-medium">Belum ada folder dokumentasi kegiatan di Google Drive.</p>
    </div>

    <!-- Modal Popup Tampilan Seluruh Foto -->
    <div id="modalAlbum" class="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-xs hidden flex items-center justify-center p-4 sm:p-6">
      <div class="bg-white w-full max-w-4xl max-h-[90vh] rounded-3xl overflow-hidden flex flex-col shadow-2xl">
        <div class="p-5 border-b border-slate-100 flex items-center justify-between">
          <div>
            <span id="modalKategori" class="text-[10px] font-bold text-emerald-700 uppercase tracking-wider block"></span>
            <h3 id="modalJudul" class="text-base sm:text-lg font-black text-slate-900 leading-snug"></h3>
          </div>
          <button id="modalClose" class="p-2 rounded-xl text-slate-400 hover:bg-slate-100 hover:text-slate-700 transition text-2xl font-bold leading-none">
            &times;
          </button>
        </div>
        <div id="modalFotoList" class="p-5 overflow-y-auto grid grid-cols-2 sm:grid-cols-3 gap-3"></div>
      </div>
    </div>

  </main>

  <script>
    const SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbyznE6zNM03r4D0GVTQ1AixI2DhOlodr6pvW2hTyX4xUi476zuZQvpnNTeQPb81Q8lTNw/exec';
    const galeriLoading = document.getElementById('galeriLoading')!;
    const galeriGrid = document.getElementById('galeriGrid')!;
    const galeriEmpty = document.getElementById('galeriEmpty')!;

    const modalAlbum = document.getElementById('modalAlbum')!;
    const modalJudul = document.getElementById('modalJudul')!;
    const modalKategori = document.getElementById('modalKategori')!;
    const modalFotoList = document.getElementById('modalFotoList')!;
    const modalClose = document.getElementById('modalClose')!;

    let dataAlbum: any[] = [];

    // Fungsi format tanggal Indonesia
    function formatTgl(tglStr: string) {
      if (!tglStr) return '-';
      const date = new Date(tglStr);
      if (isNaN(date.getTime())) return tglStr;
      return date.toLocaleDateString('id-ID', {
        day: 'numeric',
        month: 'short',
        year: 'numeric',
      });
    }

    fetch(SCRIPT_URL + '?tab=galeri')
      .then((res) => res.json())
      .then((data) => {
        galeriLoading.classList.add('hidden');

        if (Array.isArray(data) && data.length > 0) {
          dataAlbum = data;
          galeriGrid.classList.remove('hidden');
          galeriGrid.innerHTML = '';

          data.forEach((album, idx) => {
            const card = document.createElement('div');
            card.className = 'bg-white rounded-3xl overflow-hidden border border-slate-200/80 shadow-xs hover:shadow-xl transition-all duration-300 flex flex-col group cursor-pointer';
            
            const coverUrl = album.fotoSampul || album.cover || (album.foto && album.foto[0]?.thumbnail) || '/logo.png';
            const jumlah = album.totalFoto || album.jumlahFoto || (album.foto ? album.foto.length : 0);
            const tanggalFormatted = formatTgl(album.tanggal);

            card.innerHTML = `
              <div class="relative aspect-[4/3] overflow-hidden bg-slate-900">
                <img src="${coverUrl}" alt="${album.judul}" class="w-full h-full object-cover group-hover:scale-105 transition duration-500" loading="lazy" />
                <span class="absolute top-3 right-3 bg-slate-950/80 backdrop-blur-md text-amber-300 text-[10px] font-bold px-2.5 py-1 rounded-lg">
                  📷 ${jumlah} Foto
                </span>
                <span class="absolute bottom-3 left-3 bg-emerald-700/90 backdrop-blur-md text-white text-[10px] font-bold px-2.5 py-1 rounded-lg uppercase">
                  ${album.kategori || 'Kegiatan'}
                </span>
              </div>
              <div class="p-5 flex flex-col flex-1 justify-between">
                <div>
                  <span class="text-[11px] text-slate-400 font-medium mb-1.5 block">📅 ${tanggalFormatted}</span>
                  <h3 class="font-bold text-slate-900 text-sm leading-snug group-hover:text-emerald-700 transition line-clamp-2">
                    ${album.judul}
                  </h3>
                </div>
                <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs font-bold text-emerald-700">
                  <span>Buka Seluruh Album</span>
                  <span>&rarr;</span>
                </div>
              </div>
            `;

            card.addEventListener('click', () => {
              bukaModalAlbum(idx);
            });

            galeriGrid.appendChild(card);
          });
        } else {
          galeriEmpty.classList.remove('hidden');
        }
      })
      .catch(() => {
        galeriLoading.innerHTML = '<p class="text-rose-600 text-xs font-bold">Gagal memuat album galeri dari Google Drive.</p>';
      });

    function bukaModalAlbum(index: number) {
      const album = dataAlbum[index];
      if (!album) return;

      modalJudul.innerText = album.judul;
      modalKategori.innerText = `${album.kategori || 'Kegiatan'} • ${formatTgl(album.tanggal)}`;
      modalFotoList.innerHTML = '';

      if (Array.isArray(album.foto)) {
        album.foto.forEach((itemFoto: any) => {
          const fullUrl = typeof itemFoto === 'string' ? itemFoto : itemFoto.url;
          const thumbUrl = typeof itemFoto === 'string' ? itemFoto : (itemFoto.thumbnail || itemFoto.url);

          const item = document.createElement('a');
          item.href = fullUrl;
          item.target = '_blank';
          item.rel = 'noopener noreferrer';
          item.className = 'aspect-square rounded-2xl overflow-hidden bg-slate-100 block shadow-xs hover:opacity-90 transition group relative';
          item.innerHTML = `
            <img src="${thumbUrl}" class="w-full h-full object-cover group-hover:scale-105 transition duration-300" loading="lazy" />
          `;
          modalFotoList.appendChild(item);
        });
      }

      modalAlbum.classList.remove('hidden');
    }

    modalClose.addEventListener('click', () => {
      modalAlbum.classList.add('hidden');
    });

    modalAlbum.addEventListener('click', (e) => {
      if (e.target === modalAlbum) modalAlbum.classList.add('hidden');
    });
  </script>
</Layout>