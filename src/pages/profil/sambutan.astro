---
import Layout from '../../layouts/Layout.astro';

// Data Kepala Sekolah (Dapat disesuaikan sewaktu-waktu)
const kepalaSekolah = {
  nama: "Rahmad Kapitan, S.Pd",
  nip: "19770310 200212 1 011",
  pangkatGolongan: "Pembina Tk. I / IV/a",
  jabatan: "Kepala SMA Negeri Alor Kecil",
  foto: "https://media.discordapp.net/attachments/381265047957012484/1551432779537977405/9510047C-9FCD-427A-AC5E-AC78F6C21D76.png?ex=6ab1f3de&is=6ab0a25e&hm=809e1121eabd202ba8d181bfe6a8fd645ad6bf83b2c197f9eb0a9d18a3cce66c&=&format=webp&quality=lossless", // Ganti dengan path foto resmi di /public
  periode: "2013 - Sekarang"
};
---

<Layout 
  title="Sambutan Kepala Sekolah - SMA Negeri Alor Kecil" 
  description="Prakata dan sambutan resmi Kepala SMA Negeri Alor Kecil mengenai visi, misi, dan arah transformasi pendidikan sekolah."
>
  <!-- Breadcrumb -->
  <div class="bg-slate-50 border-b border-slate-200/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3.5">
      <nav class="flex items-center gap-2 text-xs text-slate-500 font-medium">
        <a href="/" class="hover:text-emerald-700 transition">Beranda</a>
        <span>/</span>
        <span class="text-slate-400">Profil</span>
        <span>/</span>
        <span class="text-emerald-800 font-bold">Sambutan Kepala Sekolah</span>
      </nav>
    </div>
  </div>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      
      <!-- ==================== SISI KIRI: KARTU PROFIL KEPALA SEKOLAH ==================== -->
      <aside class="lg:col-span-4 lg:sticky lg:top-24">
        <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200/80 shadow-xs text-center">
          
          <!-- Frame Foto Formal -->
          <div class="relative w-48 h-60 sm:w-56 sm:h-72 mx-auto rounded-2xl overflow-hidden shadow-md border-4 border-white ring-1 ring-slate-200 mb-6 bg-slate-100">
            <img 
              src={kepalaSekolah.foto} 
              alt={kepalaSekolah.nama} 
              class="w-full h-full object-cover object-top"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-emerald-950/60 via-transparent to-transparent"></div>
            <span class="absolute bottom-3 left-1/2 -translate-x-1/2 bg-amber-400 text-slate-950 text-[10px] font-black px-3 py-0.5 rounded-full uppercase tracking-wider whitespace-nowrap shadow-xs">
              Kepala Sekolah
            </span>
          </div>

          <!-- Keterangan Identitas -->
          <h2 class="text-lg font-black text-slate-900 leading-snug">
            {kepalaSekolah.nama}
          </h2>
          <p class="text-xs font-mono text-slate-500 mt-1">
            NIP. {kepalaSekolah.nip}
          </p>
          <div class="inline-block bg-emerald-50 text-emerald-800 text-[11px] font-bold px-3 py-1 rounded-lg mt-3 border border-emerald-100">
            {kepalaSekolah.pangkatGolongan}
          </div>

          <div class="mt-6 pt-6 border-t border-slate-100 text-left space-y-2.5 text-xs text-slate-600">
            <div class="flex justify-between">
              <span class="text-slate-400">Instansi:</span>
              <span class="font-bold text-slate-800">SMAN Alor Kecil</span>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-400">Wilayah:</span>
              <span class="font-semibold text-slate-700">Kabupaten Alor, NTT</span>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-400">Masa Tugas:</span>
              <span class="font-semibold text-slate-700">{kepalaSekolah.periode}</span>
            </div>
          </div>

        </div>
      </aside>

      <!-- ==================== SISI KANAN: NASKAH SAMBUTAN ==================== -->
      <div class="lg:col-span-8">
        <article class="bg-white rounded-3xl p-6 sm:p-12 border border-slate-200/80 shadow-xs leading-relaxed text-slate-700 space-y-6">
          
          <!-- Judul Header -->
          <header class="border-b border-slate-100 pb-6 mb-6">
            <span class="text-xs font-black text-emerald-700 uppercase tracking-widest block mb-1">Prakata Pimpinan</span>
            <h1 class="text-2xl sm:text-4xl font-black text-slate-900 leading-tight">
              Membangun Generasi Cerdas Berkarakter Berakar pada Kearifan Lokal
            </h1>
          </header>

          <!-- Salam Pembuka -->
          <p class="text-base sm:text-lg font-semibold text-slate-900 italic font-serif">
            "Salam sejahtera bagi kita semua, Tabea, Salve, Om Swastyastu, Namo Buddhaya, Salam Kebajikan."
          </p>

          <!-- Paragraf Isi Sambutan -->
          <p class="text-sm sm:text-base leading-relaxed text-justify">
            Puji dan syukur kita panjatkan ke hadirat Tuhan Yang Maha Esa atas limpahan rahmat dan karunia-Nya, sehingga portal digital resmi <strong>SMA Negeri Alor Kecil</strong> ini dapat hadir sebagai wadah representasi sekolah, media transparansi informasi, serta sarana komunikasi edukatif antara sekolah, orang tua, peserta didik, dan masyarakat luas.
          </p>

          <p class="text-sm sm:text-base leading-relaxed text-justify">
            Dunia pendidikan saat ini melaju pesat seiring akselerasi teknologi dan implementasi <strong>Kurikulum Merdeka</strong>. Kami di SMA Negeri Alor Kecil berkomitmen penuh untuk menghadirkan ruang belajar yang humanis, transformatif, dan berdaya saing, tanpa menanggalkan nilai-nilai luhur kearifan budaya daerah Alor serta semangat <em>Profil Pelajar Pancasila</em>.
          </p>

          <!-- Kotak Kutipan / Visi -->
          <div class="bg-emerald-50/70 border-l-4 border-emerald-700 rounded-r-2xl p-5 my-6">
            <p class="text-sm font-semibold text-emerald-950 italic">
              "Setiap peserta didik memiliki potensi istimewa. Tugas kami bersama dewan guru adalah menuntun potensi kodrat tersebut agar mereka mampu mandiri, berbudi pekerti luhur, dan siap menghadapi tantangan masa depan."
            </p>
          </div>

          <p class="text-sm sm:text-base leading-relaxed text-justify">
            Digitalisasi layanan sekolah—mulai dari sistem presensi digital, direktori civitas, pelaporan capaian kompetensi, hingga keterbukaan warta kegiatan—merupakan wujud kesungguhan kami dalam menghadirkan tata kelola sekolah yang akuntabel, adaptif, dan transparan.
          </p>

          <p class="text-sm sm:text-base leading-relaxed text-justify">
            Akhir kata, kami menyampaikan penghargaan setinggi-tingginya kepada seluruh dewan guru, tenaga kependidikan, komite sekolah, dan orang tua wali atas sinergi yang terus terbangun. Mari bersama-sama melangkah membawa SMA Negeri Alor Kecil menjadi sekolah yang unggul dalam prestasi dan kokoh dalam budi pekerti.
          </p>

          <!-- Tanda Tangan & Penutup Resmi -->
          <div class="mt-12 pt-8 border-t border-slate-200 flex flex-col sm:flex-row justify-between items-start sm:items-end gap-6">
            <div class="text-xs text-slate-500">
              <span class="block font-semibold text-slate-700">Dikeluarkan di: Alor Kecil</span>
              <span>Kecamatan Alor Barat Laut, Kab. Alor</span>
            </div>
            
            <div class="text-left sm:text-right">
              <p class="text-xs text-slate-500">Kepala Sekolah,</p>
              <div class="h-16 flex items-center justify-start sm:justify-end py-2">
                <!-- Ruang tanda tangan atau stempel digital jika ada -->
                <span class="text-xs font-mono text-slate-300 italic">[ Tanda Tangan Digital ]</span>
              </div>
              <p class="text-sm font-black text-slate-900 underline underline-offset-4">{kepalaSekolah.nama}</p>
              <p class="text-xs font-mono text-slate-500 mt-0.5">NIP. {kepalaSekolah.nip}</p>
            </div>
          </div>

        </article>
      </div>

    </div>
  </main>
</Layout>