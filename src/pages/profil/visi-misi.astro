---
import Layout from '../../layouts/Layout.astro';

const visiUtama = "Terwujudnya Peserta Didik yang Beriman dan Bertakwa, Unggul dalam Prestasi, Berkarakter Profil Pelajar Pancasila, Berwawasan Lingkungan, serta Berakar pada Kearifan Lokal.";

const misiList = [
  {
    nomor: "01",
    judul: "Keimanan dan Budi Pekerti",
    uraian: "Menumbuhkembangkan penghayatan dan pengamalan nilai keagamaan serta etika budi pekerti luhur dalam keseharian civitas akademika."
  },
  {
    nomor: "02",
    judul: "Pembelajaran Bermakna & Inovatif",
    uraian: "Melaksanakan proses belajar mengajar yang mendalam, berdiferensiasi, serta adaptif terhadap perkembangan sains dan teknologi digital."
  },
  {
    nomor: "03",
    judul: "Penguatan Profil Pelajar Pancasila",
    uraian: "Menyelenggarakan Projek Penguatan Profil Pelajar Pancasila (P5) yang mengasah kemandirian, nalar kritis, dan gotong royong peserta didik."
  },
  {
    nomor: "04",
    judul: "Pelestarian Budaya & Kearifan Lokal",
    uraian: "Mengintegrasikan identitas budaya dan tradisi luhur pesisir Alor ke dalam program pendidikan dan karya kreativitas siswa."
  },
  {
    nomor: "05",
    judul: "Pengembangan Prestasi Akademik & Non-Akademik",
    uraian: "Memfasilitasi pembinaan minat, bakat, olahraga, seni budaya, serta kompetisi sains di tingkat kabupaten, provinsi, dan nasional."
  },
  {
    nomor: "06",
    judul: "Lingkungan Belajar Ramah Anak & Asri",
    uraian: "Menciptakan iklim sekolah yang aman, inklusif, bebas perundungan, serta berbudaya peduli pelestarian lingkungan hidup."
  }
];

const tujuanSekolah = [
  "Meningkatkan proporsi lulusan yang berhasil melanjutkan pendidikan ke perguruan tinggi negeri/swasta maupun kedinasan.",
  "Mengoptimalkan pemanfaatan ekosistem digital dalam tata kelola administrasi, presensi, serta pelaporan capaian kompetensi siswa.",
  "Meraih capaian kejuaraan pada ajang OSN, O2SN, FLS2N, dan lomba literasi di tingkat kabupaten maupun provinsi NTT.",
  "Mewujudkan kemitraan kolaboratif yang erat bersama komite sekolah, dunia industri, dan orang tua wali murid."
];

const dimensiPancasila = [
  { nama: "Beriman, Bertakwa, & Berakhlak Mulia", icon: "✨" },
  { nama: "Berkebinekaan Global", icon: "🌏" },
  { nama: "Bergotong Royong", icon: "🤝" },
  { nama: "Mandiri", icon: "🌱" },
  { nama: "Bernalar Kritis", icon: "💡" },
  { nama: "Kreatif", icon: "🎨" }
];
---

<Layout 
  title="Visi & Misi - SMA Negeri Alor Kecil" 
  description="Visi, misi, dan arah tujuan pendidikan SMA Negeri Alor Kecil dalam mewujudkan Profil Pelajar Pancasila."
>
  <!-- Breadcrumb -->
  <div class="bg-slate-50 border-b border-slate-200/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3.5">
      <nav class="flex items-center gap-2 text-xs text-slate-500 font-medium">
        <a href="/" class="hover:text-emerald-700 transition">Beranda</a>
        <span>/</span>
        <span class="text-slate-400">Profil</span>
        <span>/</span>
        <span class="text-emerald-800 font-bold">Visi & Misi</span>
      </nav>
    </div>
  </div>

  <main class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    
    <!-- Header Halaman -->
    <header class="text-center max-w-2xl mx-auto mb-12">
      <span class="text-xs font-black text-emerald-700 uppercase tracking-widest block mb-1">Arah & Landasan Institusi</span>
      <h1 class="text-3xl sm:text-4xl font-black text-slate-900 leading-tight">
        Visi, Misi, & Tujuan
      </h1>
      <p class="text-slate-500 text-xs sm:text-sm mt-2 leading-relaxed">
        Pedoman strategis penyelenggaraan pendidikan berkualitas dan berkarakter di SMA Negeri Alor Kecil.
      </p>
    </header>

    <!-- 1. KOTAK VISI UTAMA -->
    <section class="relative bg-gradient-to-br from-emerald-950 via-emerald-900 to-emerald-950 rounded-3xl p-8 sm:p-12 text-white shadow-lg overflow-hidden mb-14 text-center">
      <div class="relative z-10 max-w-3xl mx-auto">
        <div class="inline-flex items-center gap-2 bg-emerald-800/80 border border-emerald-700 text-amber-300 text-[11px] font-black px-4 py-1.5 rounded-full uppercase tracking-wider mb-5">
          <span>🎯</span> Visi Satuan Pendidikan
        </div>
        <h2 class="text-xl sm:text-3xl font-black leading-snug tracking-tight text-amber-50">
          “{visiUtama}”
        </h2>
        <p class="text-emerald-200 text-xs sm:text-sm mt-4 leading-relaxed font-light">
          SMA Negeri Alor Kecil, Kabupaten Alor, Nusa Tenggara Timur
        </p>
      </div>
    </section>

    <!-- 2. ENAM DIMENSI PROFIL PELAJAR PANCASILA -->
    <section class="mb-14">
      <div class="text-center mb-8">
        <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block">Kurikulum Merdeka</span>
        <h3 class="text-xl sm:text-2xl font-black text-slate-900 mt-1">Fondasi Karakter Pelajar Pancasila</h3>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 gap-3.5">
        {dimensiPancasila.map((dimensi) => (
          <div class="bg-white rounded-2xl p-4 sm:p-5 border border-slate-200/80 shadow-xs flex items-center gap-3">
            <span class="text-2xl flex-shrink-0">{dimensi.icon}</span>
            <span class="text-xs sm:text-sm font-bold text-slate-800 leading-snug">
              {dimensi.nama}
            </span>
          </div>
        ))}
      </div>
    </section>

    <!-- 3. MISI SEKOLAH (GRID 2 KOLOM) -->
    <section class="mb-14">
      <div class="flex items-center gap-3 pb-3 mb-8 border-b border-slate-200">
        <span class="w-3 h-3 rounded-full bg-emerald-600"></span>
        <h3 class="text-2xl font-black text-slate-900">Misi Sekolah</h3>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {misiList.map((misi) => (
          <div class="bg-white rounded-3xl p-6 sm:p-7 border border-slate-200/80 shadow-xs hover:border-emerald-200 hover:shadow-md transition duration-200 flex flex-col justify-between">
            <div>
              <span class="inline-block text-emerald-800 font-mono font-black text-sm bg-emerald-50 px-3 py-1 rounded-xl mb-3">
                Misi {misi.nomor}
              </span>
              <h4 class="font-bold text-base text-slate-900 leading-snug">
                {misi.judul}
              </h4>
              <p class="text-xs sm:text-sm text-slate-600 mt-2 leading-relaxed">
                {misi.uraian}
              </p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 4. TUJUAN SATUAN PENDIDIKAN -->
    <section class="bg-white rounded-3xl p-6 sm:p-10 border border-slate-200/80 shadow-xs mb-14">
      <div class="flex items-center gap-3 pb-3 mb-6 border-b border-slate-100">
        <span class="w-3 h-3 rounded-full bg-amber-500"></span>
        <h3 class="text-xl sm:text-2xl font-black text-slate-900">Tujuan Sekolah</h3>
      </div>
      
      <p class="text-slate-600 text-xs sm:text-sm mb-6 leading-relaxed">
        Guna mewujudkan visi dan menjalankan misi tersebut, SMA Negeri Alor Kecil menetapkan target capaian kelembagaan:
      </p>

      <div class="space-y-3.5">
        {tujuanSekolah.map((tujuan, idx) => (
          <div class="flex items-start gap-3.5 bg-slate-50 rounded-2xl p-4 border border-slate-100">
            <span class="flex-shrink-0 w-6 h-6 rounded-full bg-emerald-700 text-white font-black text-xs flex items-center justify-center mt-0.5">
              {idx + 1}
            </span>
            <p class="text-xs sm:text-sm text-slate-700 font-medium leading-relaxed">
              {tujuan}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- Navigasi Pintas ke Profil Lainnya -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <a 
        href="/profil/sambutan" 
        class="bg-emerald-50/60 hover:bg-emerald-100/70 border border-emerald-200/80 rounded-2xl p-5 transition text-left group"
      >
        <span class="text-[11px] font-bold text-emerald-800 block mb-1">&larr; Profil Pimpinan</span>
        <h4 class="font-black text-sm text-slate-900 group-hover:text-emerald-900">
          Sambutan Kepala Sekolah
        </h4>
      </a>

      <a 
        href="/profil/sejarah" 
        class="bg-slate-50 hover:bg-slate-100 border border-slate-200 rounded-2xl p-5 transition text-left group"
      >
        <span class="text-[11px] font-bold text-slate-500 block mb-1">Rekam Jejak &rarr;</span>
        <h4 class="font-black text-sm text-slate-900 group-hover:text-emerald-800">
          Sejarah Singkat Sekolah
        </h4>
      </a>
    </div>

  </main>
</Layout>