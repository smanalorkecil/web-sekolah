---
import Layout from '../../layouts/Layout.astro';

// Komponen Filosofis Lambang
const elemenLambang = [
  {
    unsur: "Perisai Segi Lima",
    makna: "Melambangkan Pancasila sebagai fondasi ideologi bangsa, kepribadian luhur, dan benteng pertahanan moral seluruh civitas akademika dalam menghadapi arus globalisasi.",
    kategori: "Bentuk Dasar"
  },
  {
    unsur: "Moko / Simbol Budaya Alor",
    makna: "Representasi kehormatan, martabat, dan warisan kebudayaan luhur kepulauan Alor. Menegaskan komitmen sekolah untuk berakar kokoh pada kearifan lokal.",
    kategori: "Kearifan Lokal"
  },
  {
    unsur: "Buku Terbuka & Obor Menyala",
    makna: "Buku melambangkan jendela ilmu pengetahuan dan literasi, sedangkan kobaran api obor menyimbolkan semangat belajar abadi yang menerangi masa depan.",
    kategori: "Pendidikan"
  },
  {
    unsur: "Tiga Riak Gelombang Laut",
    makna: "Menggambarkan letak geografis Alor Kecil di pesisir Selat Pantar, mencerminkan ketangguhan, keluasan wawasan, dan adaptabilitas terhadap dinamika zaman.",
    kategori: "Geografis"
  },
  {
    unsur: "Untaian Padi & Kapas",
    makna: "Simbol kemakmuran, keadilan sosial, dan keselarasan rohani-jasmani yang diikhtiarkan bagi seluruh peserta didik melalui pendidikan bermutu.",
    kategori: "Kesejahteraan"
  },
  {
    unsur: "Pita Bertuliskan SMAN Alor Kecil",
    makna: "Tali pengikat persatuan, soliditas keluarga besar sekolah, serta identitas resmi satuan pendidikan di bawah naungan Dinas Pendidikan Provinsi NTT.",
    kategori: "Identitas"
  }
];

// Palet Warna Resmi Institusi
const paletWarna = [
  {
    nama: "Hijau Zamrud (Emerald)",
    hex: "#065f46",
    filosofi: "Kesuburan alam Alor, kedamaian, dan pertumbuhan karakter positif peserta didik."
  },
  {
    nama: "Kuning Emas (Amber)",
    hex: "#f59e0b",
    filosofi: "Kejayaan, kemuliaan cita-cita, integritas, dan capaian prestasi tertinggi."
  },
  {
    nama: "Putih Murni",
    hex: "#ffffff",
    filosofi: "Ketulusan niat para pendidik, kemurnian budi pekerti, dan transparansi tata kelola."
  },
  {
    nama: "Biru Bahari",
    hex: "#0284c7",
    filosofi: "Kedalaman ilmu pengetahuan, ketenangan jiwa, dan wawasan bahari yang luas."
  }
];
---

<Layout 
  title="Lambang & Makna Logo - SMA Negeri Alor Kecil" 
  description="Filosofi lambang resmi, unsur visual kearifan lokal Alor, dan pedoman identitas visual SMA Negeri Alor Kecil."
>
  <!-- Breadcrumb -->
  <div class="bg-slate-50 border-b border-slate-200/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3.5">
      <nav class="flex items-center gap-2 text-xs text-slate-500 font-medium">
        <a href="/" class="hover:text-emerald-700 transition">Beranda</a>
        <span>/</span>
        <span class="text-slate-400">Profil</span>
        <span>/</span>
        <span class="text-emerald-800 font-bold">Lambang & Makna Logo</span>
      </nav>
    </div>
  </div>

  <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    
    <!-- Header Halaman -->
    <header class="text-center max-w-2xl mx-auto mb-14">
      <span class="text-xs font-black text-emerald-700 uppercase tracking-widest block mb-1">Identitas Kelembagaan</span>
      <h1 class="text-3xl sm:text-4xl font-black text-slate-900 leading-tight">
        Lambang & Filosofi Logo
      </h1>
      <p class="text-slate-500 text-xs sm:text-sm mt-2 leading-relaxed">
        Pengejawantahan nilai-nilai luhur, visi keilmuan, dan kearifan budaya bahari SMA Negeri Alor Kecil.
      </p>
    </header>

    <!-- 1. DISPLAY LOGO RESMI -->
    <section class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center mb-16">
      
      <!-- Preview Logo Box -->
      <div class="lg:col-span-5 bg-gradient-to-br from-emerald-950 to-emerald-900 rounded-3xl p-8 sm:p-12 text-center text-white shadow-md relative overflow-hidden flex flex-col items-center justify-center min-h-[380px]">
        <div class="w-36 h-36 sm:w-44 sm:h-44 rounded-3xl bg-white p-4 shadow-xl border-4 border-emerald-400/30 flex items-center justify-center mb-6">
          <!-- Ganti path logo resmi di /public/images/logo.png -->
          <img 
            src="/logo.png" 
            alt="Logo Resmi SMAN Alor Kecil" 
            class="max-w-full max-h-full object-contain"
            onerror="this.onerror=null; this.parentElement.innerHTML='<div class=\'w-full h-full rounded-2xl bg-emerald-900 text-amber-300 font-black text-4xl flex items-center justify-center\'>AK</div>';"
          />
        </div>
        <h2 class="text-lg font-black tracking-wide text-amber-300">SMA NEGERI ALOR KECIL</h2>
        <p class="text-xs text-emerald-200 mt-1 font-mono">Kabupaten Alor, Nusa Tenggara Timur</p>

        <!-- Tombol Unduh Format Digital -->
        <a 
          href="/logo.png" 
          download="Logo-SMAN-Alor-Kecil.png" 
          class="mt-6 inline-flex items-center gap-2 bg-emerald-800/80 hover:bg-emerald-700 text-white text-xs font-bold px-4 py-2.5 rounded-xl border border-emerald-600/50 transition shadow-xs"
        >
          <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
          Unduh Logo Resolusi Tinggi
        </a>
      </div>

      <!-- Narasi Pengantar Identitas -->
      <div class="lg:col-span-7 bg-white rounded-3xl p-6 sm:p-10 border border-slate-200/80 shadow-xs leading-relaxed space-y-4 text-slate-700 text-sm sm:text-base">
        <h3 class="text-xl font-black text-slate-900 border-b border-slate-100 pb-3 flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-emerald-600"></span>
          Esensi Identitas Visual
        </h3>
        <p class="text-justify">
          Lambang <strong>SMA Negeri Alor Kecil</strong> bukan sekadar tanda pengenal formalitas dinas, melainkan cerminan doa, cita-cita, serta jati diri seluruh warga sekolah.
        </p>
        <p class="text-justify">
          Dirancang dengan memadukan unsur tradisi kepulauan Alor, semangat kemerdekaan belajar, dan wawasan bahari kawasan Alor Barat Laut, lambang ini menjadi pedoman moral bagi para pendidik dalam membimbing generasi penerus yang berilmu amaliah dan berkarakter luhur.
        </p>
        <div class="bg-emerald-50/70 border-l-4 border-emerald-700 p-4 rounded-r-2xl mt-4">
          <p class="text-xs sm:text-sm font-semibold text-emerald-950 italic">
            “Ketinggian ilmu diimbangi luhurnya budi pekerti, kokoh berakar pada adat budaya luhur tanah Alor.”
          </p>
        </div>
      </div>

    </section>

    <!-- 2. ANATOMI & FILOSOFI UNSUR LAMBANG -->
    <section class="mb-16">
      <div class="flex items-center gap-3 pb-3 mb-8 border-b border-slate-200">
        <span class="w-3 h-3 rounded-full bg-emerald-600"></span>
        <h3 class="text-2xl font-black text-slate-900">Uraian Makna Unsur Lambang</h3>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {elemenLambang.map((item, idx) => (
          <div class="bg-white rounded-3xl p-6 border border-slate-200/80 shadow-xs hover:border-emerald-200 hover:shadow-md transition duration-200 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-3">
                <span class="text-[10px] font-bold text-emerald-800 bg-emerald-50 px-2.5 py-0.5 rounded-full uppercase tracking-wider">
                  {item.kategori}
                </span>
                <span class="font-mono text-xs text-slate-300 font-bold">0{idx + 1}</span>
              </div>
              <h4 class="font-bold text-base text-slate-900 leading-snug">
                {item.unsur}
              </h4>
              <p class="text-xs sm:text-sm text-slate-600 mt-2 leading-relaxed text-justify">
                {item.makna}
              </p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 3. PALET WARNA IDENTITAS (BRANDING GUIDELINES) -->
    <section class="bg-white rounded-3xl p-6 sm:p-10 border border-slate-200/80 shadow-xs mb-14">
      <div class="pb-4 mb-6 border-b border-slate-100">
        <h3 class="text-xl font-black text-slate-900 flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-amber-500"></span>
          Palet Warna Resmi & Pedoman Visual
        </h3>
        <p class="text-xs text-slate-500 mt-1">Standar kode warna untuk publikasi digital, kop dinas, seragam, dan spanduk sekolah.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {paletWarna.map((w) => (
          <div class="border border-slate-200/80 rounded-2xl p-4 flex flex-col justify-between">
            <div>
              <div class="w-full h-12 rounded-xl mb-3 border border-slate-100 shadow-inner" style={`background-color: ${w.hex};`}></div>
              <h5 class="font-bold text-xs sm:text-sm text-slate-900">{w.nama}</h5>
              <code class="text-[11px] font-mono text-slate-400 block mt-0.5 uppercase">{w.hex}</code>
              <p class="text-xs text-slate-600 mt-2 leading-relaxed">
                {w.filosofi}
              </p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Navigasi Pintas Antar-Profil -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-4 border-t border-slate-200">
      <a 
        href="/profil/sejarah" 
        class="bg-white hover:bg-emerald-50 border border-slate-200 rounded-2xl p-4 transition text-center group"
      >
        <span class="text-[11px] font-bold text-slate-400 group-hover:text-emerald-700 block">Jejak Lembaga</span>
        <h4 class="font-black text-xs sm:text-sm text-slate-800 mt-0.5">Sejarah Singkat &rarr;</h4>
      </a>

      <a 
        href="/profil/visi-misi" 
        class="bg-white hover:bg-emerald-50 border border-slate-200 rounded-2xl p-4 transition text-center group"
      >
        <span class="text-[11px] font-bold text-slate-400 group-hover:text-emerald-700 block">Landasan Kerja</span>
        <h4 class="font-black text-xs sm:text-sm text-slate-800 mt-0.5">Visi & Misi &rarr;</h4>
      </a>

      <a 
        href="/profil/struktur-organisasi" 
        class="bg-white hover:bg-emerald-50 border border-slate-200 rounded-2xl p-4 transition text-center group"
      >
        <span class="text-[11px] font-bold text-slate-400 group-hover:text-emerald-700 block">Tata Kelola</span>
        <h4 class="font-black text-xs sm:text-sm text-slate-800 mt-0.5">Struktur Organisasi &rarr;</h4>
      </a>
    </div>

  </main>
</Layout>