---
import Layout from '../../layouts/Layout.astro';

// Tonggak Sejarah (Lini Masa Perkembangan)
const liniMasa = [
  {
    tahun: "Masa Rintisan",
    judul: "Prakarsa Pendidikan Masyarakat Alor Kecil",
    uraian: "Didorong oleh tingginya kebutuhan akses pendidikan menengah atas bagi lulusan SMP di kawasan Alor Barat Laut, tokoh masyarakat, dewan guru, dan pemerintah daerah menginisiasi pendirian ruang belajar rintisan."
  },
  {
    tahun: "Penegerian Resmi",
    judul: "SK Operasional & Kelembagaan Definitif",
    uraian: "Pemerintah Provinsi Nusa Tenggara Timur secara resmi menerbitkan surat keputusan kelembagaan sekolah negeri, menandai berdirinya SMA Negeri Alor Kecil sebagai satuan pendidikan formal di bawah naungan Dinas Pendidikan dan Kebudayaan Provinsi NTT."
  },
  {
    tahun: "Pengembangan Sarana",
    judul: "Pembangunan Gedung & Fasilitas Belajar",
    uraian: "Perluasan sarana fisik secara bertahap meliputi penambahan ruang kelas representatif, perpustakaan sekolah, laboratorium komputer, dan sarana olahraga untuk menunjang aktivitas belajar peserta didik."
  },
  {
    tahun: "Era Sekarang",
    judul: "Akselerasi Kurikulum Merdeka & Ekosistem Digital",
    uraian: "Penerapan pembelajaran berbasis Projek Penguatan Profil Pelajar Pancasila (P5), keterbukaan portal publikasi online, serta implementasi sistem presensi dan tata kelola digital sekolah."
  }
];

// Data Legalitas Sekolah
const legalitas = [
  { label: "Nama Satuan Pendidikan", nilai: "SMA Negeri Alor Kecil" },
  { label: "NPSN", nilai: "69900000" }, // Sesuaikan dengan NPSN resmi
  { label: "Bentuk Pendidikan", nilai: "Sekolah Menengah Atas (SMA)" },
  { label: "Status Sekolah", nilai: "Negeri" },
  { label: "Naungan", nilai: "Dinas Pendidikan & Kebudayaan Pemprov NTT" },
  { label: "Kecamatan", nilai: "Alor Barat Laut" },
  { label: "Kabupaten", nilai: "Kabupaten Alor, Nusa Tenggara Timur" },
  { label: "Kurikulum", nilai: "Kurikulum Merdeka" },
];
---

<Layout 
  title="Sejarah Singkat - SMA Negeri Alor Kecil" 
  description="Kilasan sejarah pendirian, tonggak perkembangan, dan legalitas resmi SMA Negeri Alor Kecil di Kabupaten Alor, NTT."
>
  <!-- Breadcrumb -->
  <div class="bg-slate-50 border-b border-slate-200/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3.5">
      <nav class="flex items-center gap-2 text-xs text-slate-500 font-medium">
        <a href="/" class="hover:text-emerald-700 transition">Beranda</a>
        <span>/</span>
        <span class="text-slate-400">Profil</span>
        <span>/</span>
        <span class="text-emerald-800 font-bold">Sejarah Sekolah</span>
      </nav>
    </div>
  </div>

  <main class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    
    <!-- Header Halaman -->
    <header class="text-center max-w-2xl mx-auto mb-12">
      <span class="text-xs font-black text-emerald-700 uppercase tracking-widest block mb-1">Rekam Jejak & Memori</span>
      <h1 class="text-3xl sm:text-4xl font-black text-slate-900 leading-tight">
        Sejarah Singkat Sekolah
      </h1>
      <p class="text-slate-500 text-xs sm:text-sm mt-2 leading-relaxed">
        Dedikasi membangun peradaban dan memperluas akses pendidikan bermutu bagi generasi muda di pesisir Alor Barat Laut.
      </p>
    </header>

    <!-- Narasi Latar Belakang -->
    <section class="bg-white rounded-3xl p-6 sm:p-10 border border-slate-200/80 shadow-xs mb-12">
      <h2 class="text-xl sm:text-2xl font-black text-slate-900 mb-4 pb-3 border-b border-slate-100 flex items-center gap-2">
        <span class="w-3 h-3 rounded-full bg-emerald-600"></span>
        Latar Belakang Pendirian
      </h2>
      <div class="space-y-4 text-slate-700 text-sm sm:text-base leading-relaxed text-justify">
        <p>
          Berdirinya <strong>SMA Negeri Alor Kecil</strong> berakar dari cita-cita luhur masyarakat dan tokoh pendidik setempat untuk mendekatkan akses pendidikan jenjang menengah atas bagi anak-anak di wilayah pesisir Kecamatan Alor Barat Laut, Kabupaten Alor.
        </p>
        <p>
          Sebelum sekolah ini hadir, para lulusan SMP/MTs di kawasan sekitar harus menempuh jarak yang relatif jauh menuju pusat kota Kalabahi demi melanjutkan studi. Kondisi geografis dan tantangan akses transportasi kala itu melahirkan dorongan kuat dari para orang tua, perangkat desa, serta tokoh pendidikan untuk memperjuangkan sebuah satuan pendidikan setingkat SMA yang dapat menampung putra-putri daerah secara terjangkau dan berkualitas.
        </p>
        <p>
          Melalui gotong royong dan dukungan penuh dari Pemerintah Kabupaten Alor beserta Dinas Pendidikan dan Kebudayaan Provinsi Nusa Tenggara Timur, SMA Negeri Alor Kecil resmi disahkan dan beroperasi melayani kegiatan belajar mengajar dengan mengedepankan pembinaan budi pekerti luhur berlandaskan kearifan lokal.
        </p>
      </div>
    </section>

    <!-- Lini Masa Tonggak Perkembangan (Timeline) -->
    <section class="mb-12">
      <div class="text-center mb-10">
        <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block">Jejak Langkah</span>
        <h2 class="text-2xl font-black text-slate-900 mt-1">Lini Masa Transformasi</h2>
      </div>

      <div class="relative border-l-2 border-emerald-600/30 ml-4 sm:ml-32 space-y-8 pb-4">
        {liniMasa.map((item) => (
          <div class="relative pl-6 sm:pl-8 group">
            <!-- Lingkaran Titik Timeline -->
            <div class="absolute -left-[9px] top-1.5 w-4 h-4 rounded-full bg-white border-4 border-emerald-700 group-hover:scale-125 transition duration-200"></div>

            <!-- Label Tahun / Periode di Kiri (Khusus Layar Desktop) -->
            <div class="hidden sm:block absolute -left-36 top-1 text-right w-28">
              <span class="text-xs font-black text-emerald-800 bg-emerald-50 border border-emerald-200/80 px-2.5 py-1 rounded-md">
                {item.tahun}
              </span>
            </div>

            <!-- Konten Kartu Timeline -->
            <div class="bg-white rounded-2xl p-5 sm:p-6 border border-slate-200/80 shadow-xs hover:border-emerald-200 hover:shadow-md transition duration-200">
              <span class="sm:hidden inline-block text-[11px] font-black text-emerald-800 bg-emerald-50 px-2.5 py-0.5 rounded mb-2">
                {item.tahun}
              </span>
              <h3 class="font-bold text-base text-slate-900 leading-snug">
                {item.judul}
              </h3>
              <p class="text-xs sm:text-sm text-slate-600 mt-2 leading-relaxed">
                {item.uraian}
              </p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Tabel Legalitas & Identitas Satuan Pendidikan -->
    <section class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200/80 shadow-xs mb-12">
      <h2 class="text-xl font-black text-slate-900 mb-6 pb-3 border-b border-slate-100 flex items-center gap-2">
        <span class="w-3 h-3 rounded-full bg-amber-500"></span>
        Identitas & Legalitas Kelembagaan
      </h2>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs sm:text-sm">
          <tbody class="divide-y divide-slate-100">
            {legalitas.map((item) => (
              <tr class="hover:bg-slate-50/70 transition">
                <td class="py-3 px-3 font-semibold text-slate-500 w-1/3 sm:w-1/4">
                  {item.label}
                </td>
                <td class="py-3 px-3 font-bold text-slate-900">
                  {item.nilai}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Navigasi Pintas ke Profil Lainnya -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <a 
        href="/profil/sambutan" 
        class="bg-emerald-50/60 hover:bg-emerald-100/70 border border-emerald-200/80 rounded-2xl p-5 transition text-left group"
      >
        <span class="text-[11px] font-bold text-emerald-800 block mb-1">Prakata Pimpinan &rarr;</span>
        <h3 class="font-black text-sm text-slate-900 group-hover:text-emerald-900">
          Sambutan Kepala Sekolah
        </h3>
      </a>

      <a 
        href="/profil/visi-misi" 
        class="bg-slate-50 hover:bg-slate-100 border border-slate-200 rounded-2xl p-5 transition text-left group"
      >
        <span class="text-[11px] font-bold text-slate-500 block mb-1">Arah Pengembangan &rarr;</span>
        <h3 class="font-black text-sm text-slate-900 group-hover:text-emerald-800">
          Visi, Misi, & Tujuan Sekolah
        </h3>
      </a>
    </div>

  </main>
</Layout>