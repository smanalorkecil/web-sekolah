---

<Layout title="Kontak & Pengaduan - SMA Negeri Alor Kecil">
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    
    <!-- ==================== 1. HEADER HALAMAN ==================== -->
    <div class="text-center max-w-2xl mx-auto mb-12">
      <span class="text-xs font-black text-emerald-700 uppercase tracking-widest">Layanan Informasi Terpadu</span>
      <h1 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight mt-1">Hubungi Kami</h1>
      <p class="text-slate-500 text-xs sm:text-sm mt-2 leading-relaxed">
        Pintu komunikasi terbuka bagi masyarakat, orang tua peserta didik, alumni, dan kemitraan kelembagaan dengan civitas SMA Negeri Alor Kecil.
      </p>
    </div>

    <!-- ==================== 2. KARTU INFORMASI KONTAK CEPAT ==================== -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-12">
      
      <!-- Alamat -->
      <div class="bg-white rounded-2xl p-6 border border-slate-200/80 shadow-xs flex flex-col justify-between">
        <div>
          <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-700 flex items-center justify-center text-xl mb-4">
            📍
          </div>
          <h3 class="font-bold text-slate-900 text-sm">Alamat Sekolah</h3>
          <p class="text-xs text-slate-500 mt-2 leading-relaxed">
            Jl. Kalabahi - Kokar KM. 14, Desa Lefokisu, Kec. Alor Barat Laut, Kabupaten Alor, Nusa Tenggara Timur (NTT).
          </p>
        </div>
        <span class="text-[11px] font-bold text-emerald-700 mt-4 block">Kode Pos 85223</span>
      </div>

      <!-- WhatsApp / TU -->
      <div class="bg-white rounded-2xl p-6 border border-slate-200/80 shadow-xs flex flex-col justify-between">
        <div>
          <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-700 flex items-center justify-center text-xl mb-4">
            💬
          </div>
          <h3 class="font-bold text-slate-900 text-sm">Layanan WhatsApp & TU</h3>
          <p class="text-xs text-slate-500 mt-2 leading-relaxed">
            Konsultasi administrasi siswa, surat rekomendasi, legalisir, dan konfirmasi pendaftaran.
          </p>
        </div>
        <a 
          href="https://wa.me/6281234567890" 
          target="_blank" 
          rel="noopener noreferrer"
          class="text-xs font-bold text-emerald-700 hover:text-emerald-800 underline mt-4 inline-block"
        >
          +62 812-3456-7890 &rarr;
        </a>
      </div>

      <!-- Surel / Email -->
      <div class="bg-white rounded-2xl p-6 border border-slate-200/80 shadow-xs flex flex-col justify-between">
        <div>
          <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-700 flex items-center justify-center text-xl mb-4">
            ✉️
          </div>
          <h3 class="font-bold text-slate-900 text-sm">Surat Elektronik</h3>
          <p class="text-xs text-slate-500 mt-2 leading-relaxed">
            Pengiriman berkas kedinasan dinas pendidikan, proposal kemitraan, dan surat undangan resmi.
          </p>
        </div>
        <a 
          href="mailto:info@smanalorkecil.web.id" 
          class="text-xs font-bold text-emerald-700 hover:text-emerald-800 underline mt-4 inline-block truncate"
        >
          smanalorkecil2013@gmail.com
        </a>
      </div>

      <!-- Jam Layanan -->
      <div class="bg-white rounded-2xl p-6 border border-slate-200/80 shadow-xs flex flex-col justify-between">
        <div>
          <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-700 flex items-center justify-center text-xl mb-4">
            ⏰
          </div>
          <h3 class="font-bold text-slate-900 text-sm">Jam Operasional Kantor</h3>
          <p class="text-xs text-slate-500 mt-2 leading-relaxed">
            Senin &ndash; Kamis: 07.30 &ndash; 14.00 WITA<br/>
            Jumat: 07.30 &ndash; 11.30 WITA<br/>
            Sabtu: 07.30 &ndash; 14.00 WITA
          </p>
        </div>
        <span class="text-[11px] font-semibold text-slate-400 mt-4 block">Minggu & Libur Nasional Tutup</span>
      </div>

    </div>

    <!-- ==================== 3. GRID UTAMA: FORM KOTAK SARAN & MEDIA SOSIAL ==================== -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-12 items-start">
      
      <!-- FORM KOTAK SARAN / ASPIRASI (7 KOLOM) -->
      <div class="lg:col-span-7 bg-white rounded-3xl p-6 sm:p-8 border border-slate-200/80 shadow-xs">
        <div class="flex items-center gap-2 mb-2">
          <span class="w-2.5 h-2.5 rounded-full bg-amber-400"></span>
          <span class="text-xs font-bold uppercase tracking-wider text-emerald-800">Aspirasi Civitas</span>
        </div>
        <h2 class="text-xl sm:text-2xl font-black text-slate-900 mb-2">
          Kotak Saran & Pertanyaan
        </h2>
        <p class="text-xs sm:text-sm text-slate-500 mb-6 leading-relaxed">
          Punya pertanyaan seputar program sekolah atau ingin memberikan saran yang membangun? Masukan Anda akan langsung tercatat di pangkalan data resmi Tata Usaha.
        </p>

        <!-- Pesan Berhasil Terkirim -->
        <div id="alertSukses" class="hidden mb-6 p-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-900 text-xs sm:text-sm flex items-start gap-3">
          <span class="text-emerald-700 text-lg">✅</span>
          <div>
            <h4 class="font-bold">Terima Kasih!</h4>
            <p class="text-emerald-800/80 mt-0.5">Saran dan aspirasi Anda telah berhasil tersimpan di sistem sekolah dan akan ditindaklanjuti oleh staf Tata Usaha.</p>
          </div>
        </div>

        <!-- Formulir Pure JS Event Listener -->
        <div id="formKontakWrapper" class="space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1.5">Nama Lengkap *</label>
              <input 
                type="text" 
                id="inputNama" 
                placeholder="Contoh: Bpk. Ahmad / Maria"
                class="w-full text-xs sm:text-sm px-4 py-3 rounded-xl border border-slate-200 focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600 outline-none transition"
              />
            </div>
            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1.5">Kategori Hubungan *</label>
              <select 
                id="inputPeran"
                class="w-full text-xs sm:text-sm px-4 py-3 rounded-xl border border-slate-200 focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600 outline-none bg-white transition"
              >
                <option value="Orang Tua / Wali Siswa">Orang Tua / Wali Siswa</option>
                <option value="Siswa SMAN Alor Kecil">Peserta Didik</option>
                <option value="Alumni">Alumni</option>
                <option value="Masyarakat Umum">Masyarakat Umum / Mitra</option>
              </select>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1.5">Nomor WhatsApp / HP Pengirim</label>
              <input 
                type="tel" 
                id="inputKontak" 
                placeholder="08xxxxxxxxxx (Opsional)"
                class="w-full text-xs sm:text-sm px-4 py-3 rounded-xl border border-slate-200 focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600 outline-none transition"
              />
            </div>
            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1.5">Jenis Informasi *</label>
              <select 
                id="inputKategori"
                class="w-full text-xs sm:text-sm px-4 py-3 rounded-xl border border-slate-200 focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600 outline-none bg-white transition"
              >
                <option value="Saran & Masukan">Saran & Masukan Konstruktif</option>
                <option value="Pertanyaan Informasi">Pertanyaan Informasi Sekolah / SPMB</option>
                <option value="Pelayanan Administrasi">Layanan Administrasi / Dokumen</option>
                <option value="Pengaduan Terkait">Pengaduan Layanan</option>
              </select>
            </div>
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1.5">Pesan / Saran *</label>
            <textarea 
              id="inputPesan" 
              rows="4"
              placeholder="Tuliskan uraian masukan, kritik membangun, atau pertanyaan Anda..."
              class="w-full text-xs sm:text-sm px-4 py-3 rounded-xl border border-slate-200 focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600 outline-none transition"
            ></textarea>
          </div>

          <button 
            type="button" 
            id="btnKirimPesan"
            class="w-full bg-emerald-700 hover:bg-emerald-800 disabled:opacity-50 disabled:cursor-not-allowed active:scale-[0.99] text-white font-bold py-3.5 px-6 rounded-xl transition duration-200 text-xs sm:text-sm uppercase tracking-wider flex items-center justify-center gap-2 shadow-sm"
          >
            <span id="btnKirimText">Kirim Masukan ke Sekolah</span>
          </button>
        </div>
      </div>

      <!-- KANAL MEDIA SOSIAL (5 KOLOM) -->
      <div class="lg:col-span-5 space-y-6">
        
        <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200/80 shadow-xs">
          <span class="text-xs font-bold uppercase tracking-wider text-emerald-800 block mb-1">Ruang Digital</span>
          <h2 class="text-xl font-black text-slate-900 mb-2">Media Sosial Resmi</h2>
          <p class="text-xs text-slate-500 mb-6 leading-relaxed">
            Ikuti akun resmi kami untuk melihat dokumentasi karya siswa, siaran langsung kegiatan, dan konten edukatif terkini.
          </p>

          <div class="space-y-3">
            {sosmedList.map((sosmed) => (
              <a 
                href={sosmed.link} 
                target="_blank" 
                rel="noopener noreferrer"
                class={`p-3.5 rounded-2xl border border-slate-200/70 hover:shadow-xs transition duration-200 flex items-center justify-between group ${sosmed.warna}`}
              >
                <div class="flex items-center gap-3.5">
                  <div class="w-9 h-9 rounded-xl bg-slate-50 flex items-center justify-center text-slate-700 group-hover:scale-110 transition">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" set:html={sosmed.ikon} />
                  </div>
                  <div>
                    <h4 class="font-bold text-xs text-slate-900 group-hover:text-inherit transition">{sosmed.nama}</h4>
                    <span class="text-[11px] text-slate-400">{sosmed.username}</span>
                  </div>
                </div>
                <span class="text-xs text-slate-400 group-hover:translate-x-1 transition">&rarr;</span>
              </a>
            ))}
          </div>
        </div>

        <!-- Banner Maklumat Tata Tertib Komunikasi -->
        <div class="bg-gradient-to-br from-emerald-950 to-emerald-900 text-white rounded-3xl p-6">
          <span class="text-[10px] font-black uppercase tracking-widest text-amber-300 block mb-1">Maklumat Pelayanan</span>
          <h3 class="font-bold text-sm text-white">Etika Komunikasi Publik</h3>
          <p class="text-xs text-emerald-100/80 mt-2 leading-relaxed">
            Demi kenyamanan bersama, seluruh pesan yang masuk melalui kanal WhatsApp dan Kotak Saran akan diproses sesuai jam kerja operasional sekolah.
          </p>
        </div>

      </div>

    </div>

    <!-- ==================== 4. PETA LOKASI GOOGLE MAPS ==================== -->
    <div class="bg-white rounded-3xl border border-slate-200/80 shadow-xs overflow-hidden">
      <div class="p-6 border-b border-slate-100 flex flex-col sm:flex-row justify-between sm:items-center gap-2">
        <div>
          <span class="text-xs font-bold text-emerald-700 uppercase tracking-wider">Lokasi Sekolah</span>
          <h3 class="font-black text-slate-900 text-lg sm:text-xl">Peta SMA Negeri Alor Kecil</h3>
        </div>
        <a 
          href="https://maps.google.com/?q=SMA+Negeri+Alor+Kecil" 
          target="_blank" 
          rel="noopener noreferrer"
          class="text-xs font-bold text-emerald-700 hover:text-emerald-800 underline self-start sm:self-auto"
        >
          Buka di Google Maps Langsung &rarr;
        </a>
      </div>

      <!-- Embed Google Maps -->
      <div class="w-full h-80 sm:h-96 bg-slate-100 relative">
        <iframe
          title="Lokasi Google Maps SMA Negeri Alor Kecil"
          src="https://maps.google.com/maps?q=SMA%20Negeri%20Alor%20Kecil,%20Alor%20Barat%20Laut,%20Nusa%20Tenggara%20Timur&t=&z=15&ie=UTF8&iwloc=&output=embed"
          width="100%"
          height="100%"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>

  </main>
</Layout>

<script>
  const SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbyznE6zNM03r4D0GVTQ1AixI2DhOlodr6pvW2hTyX4xUi476zuZQvpnNTeQPb81Q8lTNw/exec';

  const btnKirim = document.getElementById('btnKirimPesan') as HTMLButtonElement;
  const btnText = document.getElementById('btnKirimText') as HTMLSpanElement;
  const alertSukses = document.getElementById('alertSukses') as HTMLDivElement;

  btnKirim?.addEventListener('click', () => {
    const inputNama = document.getElementById('inputNama') as HTMLInputElement;
    const inputPeran = document.getElementById('inputPeran') as HTMLSelectElement;
    const inputKontak = document.getElementById('inputKontak') as HTMLInputElement;
    const inputKategori = document.getElementById('inputKategori') as HTMLSelectElement;
    const inputPesan = document.getElementById('inputPesan') as HTMLTextAreaElement;

    const nama = inputNama?.value.trim();
    const peran = inputPeran?.value;
    const kontak = inputKontak?.value.trim();
    const kategori = inputKategori?.value;
    const pesan = inputPesan?.value.trim();

    if (!nama || !pesan) {
      alert('Mohon isi Nama Lengkap dan Pesan/Saran terlebih dahulu.');
      return;
    }

    // Ubah status tombol jadi proses loading
    btnKirim.disabled = true;
    btnText.innerText = 'Mengirim ke Database...';

    const payload = {
      nama: nama,
      peran: peran,
      kontak: kontak,
      kategori: kategori,
      pesan: pesan
    };

    // Kirim menggunakan POST via mode no-cors agar lolos keamanan browser
    fetch(SCRIPT_URL, {
      method: 'POST',
      mode: 'no-cors',
      headers: {
        'Content-Type': 'text/plain;charset=utf-8'
      },
      body: JSON.stringify(payload)
    })
      .then(() => {
        // Tampilkan kotak sukses
        alertSukses.classList.remove('hidden');

        // Kosongkan form isian
        inputNama.value = '';
        inputKontak.value = '';
        inputPesan.value = '';

        // Kembalikan tombol
        btnKirim.disabled = false;
        btnText.innerText = 'Kirim Masukan ke Sekolah';

        // Scroll halus ke pesan sukses
        alertSukses.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      })
      .catch((err) => {
        console.error('Gagal mengirim saran:', err);
        alert('Maaf, terjadi gangguan saat mengirim pesan. Silakan coba beberapa saat lagi.');
        btnKirim.disabled = false;
        btnText.innerText = 'Kirim Masukan ke Sekolah';
      });
  });
</script>