<!-- Script Bersatu: Slider Banner & Slider Guru Realtime -->
<script>
  // ==========================================
  // 1. KONTROL SLIDER BANNER ATAS
  // ==========================================
  let currentIndex = 0;
  const slides = document.querySelectorAll<HTMLElement>('.slide-banner');
  const dots = document.querySelectorAll<HTMLElement>('.dot-slider');
  const totalSlides = slides.length;
  let timer: any;

  function goToSlide(targetIndex: number) {
    if (slides.length === 0) return;
    slides[currentIndex]?.classList.remove('opacity-100', 'z-10');
    slides[currentIndex]?.classList.add('opacity-0', 'z-0', 'pointer-events-none');
    dots[currentIndex]?.classList.remove('bg-amber-400', 'w-8');
    dots[currentIndex]?.classList.add('bg-white/40', 'w-2');

    currentIndex = (targetIndex + totalSlides) % totalSlides;

    slides[currentIndex]?.classList.remove('opacity-0', 'z-0', 'pointer-events-none');
    slides[currentIndex]?.classList.add('opacity-100', 'z-10');
    dots[currentIndex]?.classList.remove('bg-white/40', 'w-2');
    dots[currentIndex]?.classList.add('bg-amber-400', 'w-8');
  }

  function startTimer() {
    timer = setInterval(() => {
      goToSlide(currentIndex + 1);
    }, 6000);
  }

  function resetTimer() {
    clearInterval(timer);
    startTimer();
  }

  document.getElementById('btnNextSlide')?.addEventListener('click', () => {
    goToSlide(currentIndex + 1);
    resetTimer();
  });

  document.getElementById('btnPrevSlide')?.addEventListener('click', () => {
    goToSlide(currentIndex - 1);
    resetTimer();
  });

  dots.forEach((dot) => {
    dot.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLElement;
      const idx = parseInt(target.getAttribute('data-slide') || '0', 10);
      goToSlide(idx);
      resetTimer();
    });
  });

  startTimer();

  // ==========================================
  // 2. SLIDER DAFTAR GURU DARI GOOGLE SHEETS
  // ==========================================
  const SCRIPT_URL_GURU = 'https://script.google.com/macros/s/AKfycbyznE6zNM03r4D0GVTQ1AixI2DhOlodr6pvW2hTyX4xUi476zuZQvpnNTeQPb81Q8lTNw/exec';
  const homeGuruTrack = document.getElementById('homeGuruTrack');
  const btnGuruPrev = document.getElementById('btnSliderGuruPrev');
  const btnGuruNext = document.getElementById('btnSliderGuruNext');

  if (btnGuruPrev && homeGuruTrack) {
    btnGuruPrev.addEventListener('click', () => {
      homeGuruTrack.scrollBy({ left: -260, behavior: 'smooth' });
    });
  }
  if (btnGuruNext && homeGuruTrack) {
    btnGuruNext.addEventListener('click', () => {
      homeGuruTrack.scrollBy({ left: 260, behavior: 'smooth' });
    });
  }

  function ambilNilai(obj: any, daftarNamaKunci: string[]) {
    if (!obj || typeof obj !== 'object') return '';
    const keys = Object.keys(obj);
    for (const kunci of daftarNamaKunci) {
      if (obj[kunci] !== undefined && obj[kunci] !== null && String(obj[kunci]).trim() !== '') {
        return String(obj[kunci]).trim();
      }
      const kunciBersih = kunci.toLowerCase().replace(/[\s_-]/g, '');
      const keyCocok = keys.find((k) => k.toLowerCase().replace(/[\s_-]/g, '') === kunciBersih);
      if (keyCocok && obj[keyCocok] !== undefined && obj[keyCocok] !== null && String(obj[keyCocok]).trim() !== '') {
        return String(obj[keyCocok]).trim();
      }
    }
    return '';
  }

  if (homeGuruTrack) {
    fetch(SCRIPT_URL_GURU + '?tab=Guru')
      .then((res) => res.json())
      .then((data) => {
        if (Array.isArray(data) && data.length > 0) {
          homeGuruTrack.innerHTML = '';

          data.forEach((guru) => {
            const card = document.createElement('div');
            card.className = 'w-52 sm:w-60 flex-shrink-0 aspect-[3/4] rounded-2xl overflow-hidden relative shadow-md bg-slate-900 snap-start group select-none';

            // 1. Ambil Nama Lengkap
            const nama = ambilNilai(guru, [
              'NamaLengkap',
              'Nama Lengkap',
              'namalengkap',
              'Nama',
              'nama'
            ]) || 'Nama Guru';

            // 2. Ambil Nilai Tugas Tambahan, Mapel, & Jabatan
            const tugas = ambilNilai(guru, ['TugasTambaha', 'TugasTambahan', 'Tugas Tambahan', 'tugastambahan', 'tugas']);
            const mapel = ambilNilai(guru, ['Mapel', 'mapel', 'Mata Pelajaran', 'matapelajaran']);
            const jabatan = ambilNilai(guru, ['Jabatan', 'jabatan']);

            // 3. Susun 2 Baris Keterangan
            let baris1 = '';
            let baris2 = '';

            const teksMapel = (mapel && mapel !== '-') 
              ? (mapel.toLowerCase().startsWith('guru') ? mapel : `Guru ${mapel}`) 
              : '';

            if (tugas && tugas !== '-') {
              baris1 = tugas;
              baris2 = teksMapel || 'Tenaga Pendidik';
            } else {
              baris1 = teksMapel || (jabatan && jabatan !== '-' ? jabatan : 'Guru Mata Pelajaran');
              baris2 = 'Tenaga Pendidik';
            }

            // 4. Ambil Foto
            let foto = ambilNilai(guru, ['Foto', 'foto', 'avatar', 'image']);
            if (foto && foto.includes('drive.google.com')) {
              const fileIdMatch = foto.match(/\/d\/([a-zA-Z0-9_-]+)/) || foto.match(/id=([a-zA-Z0-9_-]+)/);
              if (fileIdMatch && fileIdMatch[1]) {
                foto = `https://lh3.googleusercontent.com/u/0/d/${fileIdMatch[1]}`;
              }
            }

            const inisial = nama !== 'Nama Guru' ? nama.charAt(0) : 'G';
            const imageHtml = foto 
              ? `<img src="${foto}" alt="${nama}" class="w-full h-full object-cover object-top group-hover:scale-105 transition duration-500" loading="lazy" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" /><div class="w-full h-full bg-gradient-to-b from-slate-800 to-slate-950 hidden items-center justify-center text-slate-600 font-black text-6xl">${inisial}</div>`
              : `<div class="w-full h-full bg-gradient-to-b from-slate-800 to-slate-950 flex items-center justify-center text-slate-600 font-black text-6xl">${inisial}</div>`;

            // Render Kartu dengan 2 Baris Keterangan
            card.innerHTML = `
              ${imageHtml}
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/70 to-transparent flex flex-col justify-end p-4 text-left">
                <h4 class="font-bold text-amber-400 text-sm sm:text-base leading-snug line-clamp-2">
                  ${nama}
                </h4>
                <p class="text-xs text-white mt-1.5 line-clamp-1 font-semibold">
                  ${baris1}
                </p>
                <p class="text-[11px] text-slate-300 mt-0.5 line-clamp-1 font-medium">
                  ${baris2}
                </p>
              </div>
            `;

            homeGuruTrack.appendChild(card);
          });
        }
      })
      .catch((err) => {
        console.error('Gagal memuat data guru di beranda:', err);
      });
  }
</script>