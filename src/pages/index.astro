---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

// 1. Mengimpor data Galeri dari src/data/galeri.ts
import * as galeriModule from '../data/galeri';
const semuaGaleri = (galeriModule.daftarGaleri || galeriModule.galeri || galeriModule.galeriData || galeriModule.default || []) as any[];
const galeriPreview = semuaGaleri.slice(0, 4);

// 2. Mengambil data berita dengan proteksi jika data masih kosong
let beritaUtama: any[] = [];
try {
  const semuaBerita = (await getCollection('berita')) || [];
  beritaUtama = semuaBerita
    .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
    .slice(0, 4);
} catch (e) {
  beritaUtama = [];
}

// 3. Data Slide Banner
const bannerSlides = [
  {
    image: "https://media.discordapp.net/attachments/381265047957012484/1551409800611495936/1789955294323.jpg?ex=6ab48178&is=6ab32ff8&hm=52cc1284bf5a532c569f48d32d44a88b8cefd62aa3a50edb100fbfb07f334c4a&=&format=webp&width=768&height=345",
    tag: "Tahun Ajaran 2026/2027",
    title: "Membangun Masa Depan Bangsa",
    desc: "Mewujudkan generasi cendekia yang berkarakter kokoh, berwawasan global, dan adaptif terhadap transformasi digital.",
    btnText: "Daftar SPMB / PPDB",
    btnLink: "#ppdb"
  },
  {
    image: "https://media.discordapp.net/attachments/381265047957012484/1551410394403184761/IMG_20260905_103736.jpg?ex=6ab48205&is=6ab33085&hm=d6870ace44646d3576ed4a6f55afa0ca04ad2b0ceb57833a411f117981665937&=&format=webp&width=431&height=768",
    tag: "Komunitas Pembelajar",
    title: "Unggul dalam Prestasi & Budi Pekerti",
    desc: "Mengasah talenta akademik, seni budaya, serta kepemimpinan pemuda dalam kerangka Kurikulum Merdeka.",
    btnText: "Dokumentasi Kegiatan",
    btnLink: "/galeri"
  },
  {
    image: "https://media.discordapp.net/attachments/381265047957012484/1551411086937292930/IMG_20260606_113124.jpg?ex=6ab482aa&is=6ab3312a&hm=8f3590095765d52e626ca67e97dc622fa456ac0b7cceadfd71b628cfab18983c&=&format=webp&width=768&height=345",
    tag: "Layanan Terpadu",
    title: "Layanan Pendidikan Terbuka & Transparan",
    desc: "Pusat informasi publik rilis berita resmi, arsip akademik, dan direktori kependidikan terintegrasi.",
    btnText: "Direktori Guru & Tendik",
    btnLink: "/guru"
  }
];

// 5. Data Program Unggulan
const programUnggulan = [
  { ikon: "💡", nama: "Program Riset & Sains", desc: "Pembinaan karya ilmiah remaja, olimpiade sains nasional, dan penguasaan teknologi dasar." },
  { ikon: "📖", nama: "Penguatan Karakter", desc: "Penanaman nilai budi pekerti, disiplin positif, serta kebiasaan literasi pagi terjadwal." },
  { ikon: "💻", nama: "Digitalisasi Pembelajaran", desc: "Integrasi sistem pembelajaran digital terpadu dan pembekalan literasi komputer." }
];

// 6. Data Ekstrakurikuler
const ekskulList = [
  { nama: "Pramuka", ikon: "⛺" },
  { nama: "Paskibra", ikon: "🇮🇩" },
  { nama: "PMR", ikon: "🩺" },
  { nama: "Futsal", ikon: "⚽" },
  { nama: "Voli", ikon: "🏐" },
  { nama: "Seni Tari Alor", ikon: "💃" },
  { nama: "Paduan Suara", ikon: "🎵" },
  { nama: "TIK / Komputer", ikon: "💻" },
  { nama: "Kerohanian", ikon: "🤲" },
  { nama: "English Club", ikon: "🗣️" }
];
---

<Layout title="SMA Negeri Alor Kecil - Berkarakter, Unggul, Berdaya Saing">

  <!-- ==================== 1. SLIDER HERO BANNER (DENGAN ZOOM SLOW-MOTION) ==================== -->
  <section class="relative bg-slate-950 h-[560px] sm:h-[600px] lg:h-[660px] overflow-hidden select-none">
    <div id="hero-slider" class="relative w-full h-full">
      {bannerSlides.map((slide, index) => (
        <div 
          class={`slide-banner absolute inset-0 transition-opacity duration-1000 ease-in-out ${index === 0 ? 'opacity-100 z-10 is-active' : 'opacity-0 z-0 pointer-events-none'}`}
        >
          <img 
            src={slide.image} 
            alt={slide.title} 
            class="slide-img w-full h-full object-cover object-center transform transition-transform duration-[8000ms] ease-out"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-emerald-950/95 via-slate-950/80 to-slate-950/35"></div>

          <div class="absolute inset-0 flex items-center">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
              <div class="max-w-2xl text-left pt-6 sm:pt-0">
                <span class="inline-flex items-center gap-1.5 px-3 py-1 sm:px-3.5 sm:py-1.5 bg-emerald-600/90 backdrop-blur-sm border border-emerald-400/40 text-emerald-100 text-[11px] sm:text-xs font-bold uppercase tracking-wider rounded-lg mb-3 sm:mb-4 shadow-xs">
                  ★ {slide.tag}
                </span>
                
                <h1 class="text-2xl sm:text-4xl lg:text-6xl font-black text-white uppercase tracking-tight leading-tight drop-shadow-md">
                  {slide.title}
                </h1>
                
                <p class="mt-3 sm:mt-4 text-slate-200 text-xs sm:text-base lg:text-lg leading-relaxed font-normal drop-shadow max-w-xl">
                  {slide.desc}
                </p>
                
                <div class="mt-6 sm:mt-8 flex flex-wrap items-center gap-3 sm:gap-4">
                  <a 
                    href={slide.btnLink} 
                    class="bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold px-6 sm:px-7 py-3 sm:py-3.5 rounded-xl transition-all duration-300 shadow-lg shadow-amber-500/20 text-xs sm:text-sm uppercase tracking-wider flex items-center gap-2 hover:scale-105 active:scale-95"
                  >
                    <span>{slide.btnText}</span>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
                  </a>
                  
                  <a 
                    href="/profil/sambutan" 
                    class="bg-white/10 hover:bg-white/20 text-white backdrop-blur-md border border-white/20 font-bold px-6 sm:px-7 py-3 sm:py-3.5 rounded-xl transition-all duration-300 text-xs sm:text-sm uppercase tracking-wider hover:scale-105 active:scale-95"
                  >
                    Profil Sekolah
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Tombol Panah Kiri -->
    <button 
      id="btnPrevSlide"
      type="button"
      aria-label="Slide Sebelumnya"
      class="hidden sm:flex absolute left-4 sm:left-6 top-1/2 -translate-y-1/2 z-30 w-11 h-11 sm:w-12 sm:h-12 rounded-full bg-slate-950/60 hover:bg-slate-900/90 text-white backdrop-blur-md border border-white/20 items-center justify-center transition-all duration-300 shadow-lg hover:scale-110 active:scale-95 cursor-pointer"
    >
      <svg class="w-5 h-5 text-amber-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/>
      </svg>
    </button>

    <!-- Tombol Panah Kanan -->
    <button 
      id="btnNextSlide"
      type="button"
      aria-label="Slide Berikutnya"
      class="hidden sm:flex absolute right-4 sm:right-6 top-1/2 -translate-y-1/2 z-30 w-11 h-11 sm:w-12 sm:h-12 rounded-full bg-slate-950/60 hover:bg-slate-900/90 text-white backdrop-blur-md border border-white/20 items-center justify-center transition-all duration-300 shadow-lg hover:scale-110 active:scale-95 cursor-pointer"
    >
      <svg class="w-5 h-5 text-amber-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
      </svg>
    </button>

    <!-- Dots Slider -->
    <div class="absolute bottom-6 sm:bottom-8 left-0 right-0 z-30 flex justify-center items-center gap-2.5">
      {bannerSlides.map((_, index) => (
        <button 
          type="button"
          class={`dot-slider h-2 rounded-full transition-all duration-500 cursor-pointer ${index === 0 ? 'bg-amber-400 w-8' : 'bg-white/40 w-2 hover:bg-white/70'}`} 
          data-slide={index}
          aria-label={`Pindah ke slide ${index + 1}`}
        ></button>
      ))}
    </div>
  </section>

  <!-- ==================== 2. SAMBUTAN KEPALA SEKOLAH (SCROLL REVEAL) ==================== -->
  <section id="sambutan" class="reveal-section max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-20">
    <div class="bg-white rounded-3xl p-6 sm:p-12 border border-slate-200/80 shadow-xs grid grid-cols-1 lg:grid-cols-12 gap-10 items-center hover:shadow-xl transition-shadow duration-500">
      
      <!-- FOTO KEPALA SEKOLAH -->
      <div class="lg:col-span-4 flex justify-center">
        <div class="relative w-56 sm:w-64 aspect-[3/4] rounded-3xl overflow-hidden shadow-lg border-4 border-emerald-50 bg-emerald-950 group">
          <img 
            src="/admin/kepala-sekolah.jpg" 
            alt="Rahmad Kapitan, S.Pd - Kepala SMA Negeri Alor Kecil" 
            class="w-full h-full object-cover object-top group-hover:scale-105 transition duration-700 ease-out"
            loading="lazy"
          />
          <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-slate-950 via-slate-950/70 to-transparent p-4 text-center">
            <span class="text-xs sm:text-sm font-black text-amber-300 block tracking-wide">
              Rahmad Kapitan, S.Pd
            </span>
            <span class="text-[10px] text-slate-300 font-medium block mt-0.5">
              Kepala Sekolah
            </span>
          </div>
        </div>
      </div>

      <!-- NARASI SAMBUTAN -->
      <div class="lg:col-span-8">
        <div class="inline-flex items-center gap-2 bg-emerald-50 border border-emerald-100 px-3 py-1 rounded-full mb-3">
          <span class="w-2 h-2 rounded-full bg-emerald-600 animate-ping"></span>
          <span class="text-[11px] font-black text-emerald-800 uppercase tracking-wider">Sambutan Pimpinan</span>
        </div>

        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-black text-slate-900 tracking-tight leading-tight">
          “Membina Generasi Berkarakter Luhur, Cerdas Nalar, dan Adaptif Zaman”
        </h2>

        <div class="mt-4 space-y-3 text-slate-600 leading-relaxed text-xs sm:text-base">
          <p class="font-medium text-slate-700 italic">
            Assalamu’alaikum Warahmatullahi Wabarakatuh, Salam Sejahtera bagi Kita Semua.
          </p>
          <p>
            Selamat datang di portal resmi SMA Negeri Alor Kecil. Di era keterbukaan informasi dan percepatan teknologi saat ini, website ini dihadirkan sebagai jembatan komunikasi, transparansi, serta jendela kreasi bagi seluruh keluarga besar sekolah, orang tua, alumni, dan masyarakat luas.
          </p>
          <p>
            Kami berkomitmen mewujudkan lingkungan belajar yang berakar pada kearifan lokal, berkarakter luhur, dan adaptif terhadap kemajuan zaman. Bersama-sama, mari kita kawal langkah generasi muda Alor Kecil untuk bertumbuh menjadi insan yang berintegritas dan siap berkontribusi bagi kemajuan bangsa.
          </p>
        </div>

        <div class="mt-8 pt-6 border-t border-slate-100 flex flex-col sm:flex-row justify-between sm:items-center gap-4">
          <div>
            <p class="font-black text-slate-900 text-sm sm:text-base">Rahmad Kapitan, S.Pd</p>
            <p class="text-xs text-slate-400 font-medium">Kepala SMA Negeri Alor Kecil</p>
          </div>
          
          <a 
            href="/profil/sambutan" 
            class="inline-flex items-center justify-center gap-2 bg-emerald-700 hover:bg-emerald-800 text-white font-bold px-5 py-2.5 rounded-xl text-xs uppercase tracking-wider transition shadow-sm hover:shadow hover:-translate-y-0.5 self-start sm:self-auto"
          >
            <span>Baca Selengkapnya</span>
            <span>&rarr;</span>
          </a>
        </div>
      </div>

    </div>
  </section>

  <!-- ==================== 3. BERITA & AGENDA (SCROLL REVEAL) ==================== -->
  <section id="berita" class="reveal-section bg-white py-14 sm:py-20 border-y border-slate-200/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex flex-col sm:flex-row justify-between sm:items-end mb-8 sm:mb-10 pb-4 border-b border-slate-100">
        <div>
          <span class="text-xs font-black text-emerald-700 uppercase tracking-widest">Publikasi Sekolah</span>
          <h2 class="text-2xl sm:text-3xl font-black text-slate-900 uppercase tracking-tight mt-1">Berita & Agenda Terkini</h2>
        </div>
        <a href="/berita" class="text-xs font-bold text-emerald-700 hover:text-emerald-800 uppercase tracking-wider flex items-center gap-1 mt-2 sm:mt-0 group">
          <span>Lihat Semua Berita</span>
          <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
        </a>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        
        <!-- KOLOM KIRI: BERITA (8 KOLOM) -->
        <div class="lg:col-span-8">
          {beritaUtama.length === 0 ? (
            <div class="p-10 text-center bg-slate-50 rounded-2xl border border-dashed border-slate-200">
              <p class="text-slate-500 text-sm">Belum ada artikel publikasi. Buka <a href="/admin" class="text-emerald-700 underline font-bold">Panel Admin CMS</a> untuk menulis berita pertama.</p>
            </div>
          ) : (
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              {beritaUtama.map((item) => {
                const linkSlug = item.slug || item.id?.replace(/\.md$/, '') || '';
                const tanggalText = item.data?.date 
                  ? new Date(item.data.date).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' })
                  : '-';
                
                return (
                  <article class="bg-white rounded-2xl border border-slate-200/80 overflow-hidden shadow-xs hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col group">
                    <div class="h-44 overflow-hidden bg-emerald-50 relative">
                      {item.data?.thumbnail ? (
                        <img 
                          src={item.data.thumbnail} 
                          alt={item.data.title} 
                          class="w-full h-full object-cover object-top group-hover:scale-108 transition duration-500 ease-out" 
                        />
                      ) : (
                        <div class="w-full h-full flex items-center justify-center text-emerald-700/60 font-bold text-xs bg-emerald-50">
                          Dokumentasi Sekolah
                        </div>
                      )}
                    </div>
                    <div class="p-5 flex flex-col flex-1">
                      <div class="flex justify-between items-center text-[11px] text-slate-400 mb-2">
                        <span class="font-bold text-emerald-700 uppercase tracking-wider">{item.data?.category || 'Informasi'}</span>
                        <span>{tanggalText}</span>
                      </div>
                      <h3 class="font-bold text-base text-slate-900 line-clamp-2 group-hover:text-emerald-700 transition">
                        <a href={`/berita/${linkSlug}`}>{item.data?.title}</a>
                      </h3>
                      <p class="text-xs text-slate-500 mt-2 line-clamp-2 leading-relaxed flex-1">
                        {item.data?.description}
                      </p>
                      <a href={`/berita/${linkSlug}`} class="mt-4 pt-3 border-t border-slate-100 text-xs font-bold text-emerald-700 hover:text-emerald-800 inline-flex items-center gap-1 group-hover:translate-x-1 transition-transform">
                        <span>Baca Selengkapnya</span>
                        <span>&rarr;</span>
                      </a>
                    </div>
                  </article>
                );
              })}
            </div>
          )}
        </div>

        <!-- KOLOM KANAN: AGENDA & PENGUMUMAN (4 KOLOM) -->
        <div class="lg:col-span-4 bg-emerald-50/60 rounded-3xl p-6 border border-emerald-100/80 flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-2 mb-5">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-600 animate-pulse"></span>
              <h3 class="font-black text-xs sm:text-sm uppercase tracking-wider text-slate-900">
                Agenda Kegiatan & Pengumuman
              </h3>
            </div>

            <!-- Skeleton Loading -->
            <div id="berandaAgendaLoading" class="space-y-3">
              {[1, 2, 3, 4].map(() => (
                <div class="h-16 bg-white/80 rounded-2xl border border-slate-100 animate-pulse"></div>
              ))}
            </div>

            <!-- Kontainer Agenda Dinamis -->
            <div id="berandaAgendaList" class="space-y-3 hidden"></div>

            <!-- Tampilan Kosong -->
            <div id="berandaAgendaEmpty" class="hidden text-center py-8">
              <p class="text-xs text-slate-400">Belum ada agenda atau edaran terkini.</p>
            </div>
          </div>

          <a 
            href="/pengumuman" 
            class="mt-6 block text-center py-2.5 px-4 bg-emerald-100 hover:bg-emerald-200 text-emerald-900 font-bold text-xs rounded-xl transition duration-200 hover:scale-[1.02] active:scale-95"
          >
            Lihat Papan Pengumuman &rarr;
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- ==================== 4. PROGRAM UNGGULAN SEKOLAH (SCROLL REVEAL) ==================== -->
  <section id="program" class="reveal-section max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-20">
    <div class="text-center max-w-2xl mx-auto mb-10 sm:mb-12">
      <span class="text-xs font-black text-emerald-700 uppercase tracking-widest">Pilar Pendidikan</span>
      <h2 class="text-2xl sm:text-3xl font-black text-slate-900 uppercase tracking-tight mt-1">Program Unggulan</h2>
      <p class="text-slate-500 text-xs sm:text-sm mt-2">Fondasi pembinaan akademik, kepribadian, dan literasi teknologi modern.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {programUnggulan.map((prog) => (
        <div class="group bg-white rounded-3xl p-7 border border-slate-200/80 shadow-xs hover:-translate-y-2 hover:border-emerald-300 hover:shadow-xl transition-all duration-300">
          <div class="w-14 h-14 rounded-2xl bg-emerald-50 text-2xl flex items-center justify-center mb-5 group-hover:scale-110 group-hover:bg-emerald-100 group-hover:rotate-6 transition-all duration-300">
            {prog.ikon}
          </div>
          <h3 class="font-bold text-base sm:text-lg text-slate-900 group-hover:text-emerald-800 transition">{prog.nama}</h3>
          <p class="text-slate-600 text-xs sm:text-sm mt-2.5 leading-relaxed">{prog.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ==================== 5. PITA STATISTIK HIJAU TUA (COUNTING UP ANIMATION) ==================== -->
  <section id="counterSection" class="reveal-section bg-gradient-to-r from-emerald-950 via-emerald-900 to-emerald-950 text-white py-12 sm:py-16 shadow-inner">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 text-center divide-y sm:divide-y-0 sm:divide-x divide-emerald-800/80">
        
        <!-- Counter 1: Peserta Didik -->
        <div class="pt-3 sm:pt-0">
          <span 
            class="stat-counter block text-3xl sm:text-4xl lg:text-5xl font-black text-amber-400 font-mono tracking-tight"
            data-target="90" 
            data-suffix="+"
          >
            0
          </span>
          <span class="text-[11px] sm:text-xs font-bold text-emerald-200 uppercase tracking-widest mt-1.5 block">Peserta Didik</span>
        </div>

        <!-- Counter 2: Guru & Tendik -->
        <div class="pt-3 sm:pt-0 sm:pl-6">
          <span 
            class="stat-counter block text-3xl sm:text-4xl lg:text-5xl font-black text-white font-mono tracking-tight"
            data-target="22" 
            data-suffix="+"
          >
            0
          </span>
          <span class="text-[11px] sm:text-xs font-bold text-emerald-200 uppercase tracking-widest mt-1.5 block">Pendidik & Tendik</span>
        </div>

        <!-- Counter 3: Tahun Berdiri -->
        <div class="pt-3 sm:pt-0 sm:pl-6">
          <span 
            class="stat-counter block text-3xl sm:text-4xl lg:text-5xl font-black text-amber-400 font-mono tracking-tight"
            data-target="2013" 
            data-suffix=""
            data-is-year="true"
          >
            0
          </span>
          <span class="text-[11px] sm:text-xs font-bold text-emerald-200 uppercase tracking-widest mt-1.5 block">Tahun Berdiri</span>
        </div>

        <!-- Counter 4: Prestasi Terukir -->
        <div class="pt-3 sm:pt-0 sm:pl-6">
          <span 
            class="stat-counter block text-3xl sm:text-4xl lg:text-5xl font-black text-white font-mono tracking-tight"
            data-target="36" 
            data-suffix="+"
          >
            0
          </span>
          <span class="text-[11px] sm:text-xs font-bold text-emerald-200 uppercase tracking-widest mt-1.5 block">Prestasi Terukir</span>
        </div>

      </div>
    </div>
  </section>

  <!-- ==================== 6. DAFTAR GURU (SLIDER OTOMATIS BERJALAN) ==================== -->
  <section id="guru" class="reveal-section max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20">
    
    <div class="text-center mb-10">
      <h2 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">
        Daftar Guru & Pendidik
      </h2>
      <div class="w-12 h-1 bg-amber-400 mx-auto mt-2.5 rounded-full"></div>
      <p class="text-xs text-slate-400 mt-2">Geser atau tunggu untuk melihat profil tenaga pengajar SMA Negeri Alor Kecil</p>
    </div>

    <!-- Kontainer Slider Guru -->
    <div class="relative group max-w-6xl mx-auto">
      
      <!-- Tombol Panah Kiri -->
      <button 
        id="btnSliderGuruPrev"
        type="button"
        aria-label="Geser Guru Sebelumnya"
        class="absolute -left-3 sm:-left-5 top-1/2 -translate-y-1/2 z-20 w-10 h-10 sm:w-11 sm:h-11 rounded-full bg-slate-900/85 hover:bg-slate-950 text-white flex items-center justify-center shadow-xl transition-all duration-300 hover:scale-110 active:scale-95 cursor-pointer opacity-80 group-hover:opacity-100"
      >
        <svg class="w-5 h-5 text-slate-100" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/>
