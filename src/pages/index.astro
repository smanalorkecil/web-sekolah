---
import { getCollection } from 'astro:content';
import '../styles/global.css';

// Mengambil data berita dari Decap CMS / Content Collections
const semuaBerita = (await getCollection('berita'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const beritaUtama = semuaBerita.slice(0, 4);

// Data Slide Banner
const bannerSlides = [
  {
    image: "https://images.unsplash.com/photo-1523050854058-8df90110c9f1?q=80&w=1600&auto=format&fit=crop",
    tag: "Tahun Ajaran 2026/2027",
    title: "Membangun Masa Depan Bangsa",
    desc: "Mewujudkan generasi cendekia yang berkarakter kokoh, berwawasan global, dan adaptif terhadap transformasi digital.",
    btnText: "Daftar SPMB / PPDB",
    btnLink: "#ppdb"
  },
  {
    image: "https://images.unsplash.com/photo-1577896851231-70ef18881754?q=80&w=1600&auto=format&fit=crop",
    tag: "Komunitas Pembelajar",
    title: "Unggul dalam Prestasi & Budi Pekerti",
    desc: "Mengasah talenta akademik, seni budaya, serta kepemimpinan pemuda dalam kerangka Kurikulum Merdeka.",
    btnText: "Dokumentasi Kegiatan",
    btnLink: "/galeri"
  },
  {
    image: "https://images.unsplash.com/photo-1509062522246-3755977927d7?q=80&w=1600&auto=format&fit=crop",
    tag: "Layanan Terpadu",
    title: "Layanan Pendidikan Terbuka & Transparan",
    desc: "Pusat informasi publik rilis berita resmi, arsip akademik, dan direktori kependidikan terintegrasi.",
    btnText: "Direktori Guru & Tendik",
    btnLink: "/guru"
  }
];

// Data Agenda Kegiatan Sekolah
const daftarAgenda = [
  { tgl: "15", bln: "OKT", judul: "Asesmen Sumatif Tengah Semester Ganjil", tempat: "Ruang Kelas & Lab Komputer" },
  { tgl: "22", bln: "OKT", judul: "Peringatan Hari Santri & Kegiatan Rohani", tempat: "Lapangan Utama Sekolah" },
  { tgl: "28", bln: "OKT", judul: "Upacara Peringatan Hari Sumpah Pemuda", tempat: "Halaman Upacara" },
  { tgl: "10", bln: "NOV", judul: "Gelar Karya Proyek P5 & Pentas Seni Siswa", tempat: "Aula Pertemuan" }
];

// Data Program Unggulan
const programUnggulan = [
  { ikon: "💡", nama: "Program Riset & Sains", desc: "Pembinaan karya ilmiah remaja, olimpiade sains nasional, dan penguasaan teknologi dasar." },
  { ikon: "📖", nama: "Penguatan Karakter", desc: "Penanaman nilai budi pekerti, disiplin positif, serta kebiasaan literasi pagi terjadwal." },
  { ikon: "💻", nama: "Digitalisasi Pembelajaran", desc: "Integrasi sistem pembelajaran digital terpadu dan pembekalan literasi komputer." }
];

// Cuplikan Direktori Guru di Beranda
const daftarGuruPreview = [
  { nama: "Drs. H. Ahmad Fauzi, M.Pd", mapel: "Matematika", nip: "19720415 199802 1 002" },
  { nama: "Siti Rahmawati, S.Pd, M.Si", mapel: "Bahasa Indonesia", nip: "19810320 200501 2 007" },
  { nama: "Budi Santoso, S.Kom", mapel: "Informatika / TIK", nip: "19880812 201101 1 005" },
  { nama: "Nurul Hidayah, S.Pd", mapel: "Bahasa Inggris", nip: "19920516 201903 2 011" }
];

// Data Ekstrakurikuler
const ekskulList = [
  { nama: "Pramuka", ikon: "⛺" },
  { nama: "Paskibra", ikon: "🇮🇩" },
  { nama: "PMR", ikon: "🩺" },
  { nama: "Futsal", ikon: "⚽" },
  { nama: "Voli", ikon: "🏐" },
  { nama: "Seni Tari Alor", ikon: "💃" },
  { nama: "Paduan Suara", ikon: "🎵" },
  { nama: "TIK / Komputer", ikon: "💻" },
  { nama: "Kerohanian", ikon: "🤲" },
  { nama: "English Club", ikon: "🗣️" }
];
---

<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SMA Negeri Alor Kecil - Berkarakter, Unggul, Berdaya Saing</title>
  </head>
  <body class="bg-slate-50 text-slate-800 antialiased font-sans">

    <!-- 1. TOP BAR INFORMASI RESMI -->
    <div class="bg-emerald-950 text-emerald-100 text-xs py-2 px-4 border-b border-emerald-900 hidden md:block">
      <div class="max-w-7xl mx-auto flex justify-between items-center">
        <div class="flex items-center gap-6">
          <span class="flex items-center gap-2">
            <svg class="w-3.5 h-3.5 text-amber-400" fill="currentColor" viewBox="0 0 20 20"><path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 4V3z"/></svg>
            (0386) 211234
          </span>
          <span class="flex items-center gap-2">
            <svg class="w-3.5 h-3.5 text-amber-400" fill="currentColor" viewBox="0 0 20 20"><path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"/><path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"/></svg>
            smanalorkecil2013@gmail.com
          </span>
        </div>
        <div class="flex items-center gap-4 text-emerald-200">
          <span>Senin – Jumat: 07:15 – 14:00 WITA</span>
          <a href="/admin" class="text-amber-300 hover:text-amber-200 font-semibold flex items-center gap-1">
            Panel Admin CMS &rarr;
          </a>
        </div>
      </div>
    </div>

    <!-- 2. NAVBAR UTAMA -->
    <header class="bg-white/95 backdrop-blur-md sticky top-0 z-50 shadow-sm border-b border-slate-100">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
        
        <a href="/" class="flex items-center gap-3">
          <img 
            src="/logo.png" 
            alt="Logo SMA Negeri Alor Kecil" 
            class="w-12 h-12 object-contain drop-shadow-sm"
            onerror="this.style.display='none'; document.getElementById('alt-logo').style.display='flex';"
          />
          <div id="alt-logo" class="w-12 h-12 rounded-xl bg-emerald-700 text-amber-300 font-black hidden items-center justify-center text-xl shadow-inner">
            AK
          </div>
          <div>
            <span class="block font-black text-lg text-slate-900 leading-none tracking-tight">SMA NEGERI ALOR KECIL</span>
            <span class="text-[11px] font-semibold text-emerald-700 tracking-wider uppercase">Kab. Alor, Nusa Tenggara Timur</span>
          </div>
        </a>

<!-- Menu Navigasi Lengkap -->
        <nav class="hidden xl:flex items-center gap-7 text-xs font-bold text-slate-700 uppercase tracking-wide">
          <a href="/" class="text-emerald-700 border-b-2 border-emerald-600 pb-1">Beranda</a>

          <!-- DROPDOWN PROFIL SEKOLAH -->
          <div class="relative group py-4">
            <button class="flex items-center gap-1 hover:text-emerald-700 transition uppercase tracking-wide focus:outline-none">
              <span>Profil</span>
              <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-emerald-700 group-hover:rotate-180 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/>
              </svg>
            </button>

            <!-- Menu Melayang Dropdown -->
            <div class="absolute left-0 top-full hidden group-hover:block w-64 pt-2 z-50">
              <div class="bg-white rounded-2xl shadow-xl border border-slate-100 p-2.5 flex flex-col gap-0.5 text-xs font-semibold normal-case text-slate-700">
                <a href="#sambutan" class="px-3.5 py-2 rounded-xl hover:bg-emerald-50 hover:text-emerald-800 transition flex items-center gap-2.5">
                  <span class="text-emerald-600 text-sm">🎙️</span> Sambutan Kepala Sekolah
                </a>
                <a href="/profil/sejarah" class="px-3.5 py-2 rounded-xl hover:bg-emerald-50 hover:text-emerald-800 transition flex items-center gap-2.5">
                  <span class="text-emerald-600 text-sm">📜</span> Sejarah Singkat
                </a>
                <a href="/profil/visi-misi" class="px-3.5 py-2 rounded-xl hover:bg-emerald-50 hover:text-emerald-800 transition flex items-center gap-2.5">
                  <span class="text-emerald-600 text-sm">🎯</span> Visi & Misi
                </a>
                <a href="/profil/kondisi-sekolah" class="px-3.5 py-2 rounded-xl hover:bg-emerald-50 hover:text-emerald-800 transition flex items-center gap-2.5">
                  <span class="text-emerald-600 text-sm">🏫</span> Kondisi Sekolah
                </a>
                <a href="/profil/sarana-prasarana" class="px-3.5 py-2 rounded-xl hover:bg-emerald-50 hover:text-emerald-800 transition flex items-center gap-2.5">
                  <span class="text-emerald-600 text-sm">🏢</span> Sarana & Prasarana
                </a>
                <a href="/profil/struktur-organisasi" class="px-3.5 py-2 rounded-xl hover:bg-emerald-50 hover:text-emerald-800 transition flex items-center gap-2.5">
                  <span class="text-emerald-600 text-sm">👥</span> Struktur Organisasi
                </a>
                <a href="/profil/lambang-sekolah" class="px-3.5 py-2 rounded-xl hover:bg-emerald-50 hover:text-emerald-800 transition flex items-center gap-2.5">
                  <span class="text-emerald-600 text-sm">🛡️</span> Lambang & Makna Logo
                </a>
                <a href="/profil/akreditasi" class="px-3.5 py-2 rounded-xl hover:bg-emerald-50 hover:text-emerald-800 transition flex items-center gap-2.5">
                  <span class="text-emerald-600 text-sm">⭐</span> Akreditasi Sekolah
                </a>
                <a href="/profil/prestasi" class="px-3.5 py-2 rounded-xl hover:bg-emerald-50 hover:text-emerald-800 transition flex items-center gap-2.5">
                  <span class="text-emerald-600 text-sm">🏆</span> Prestasi Sekolah
                </a>
              </div>
            </div>
          </div>

          <a href="#program" class="hover:text-emerald-700 transition">Akademik</a>
          <a href="#guru" class="hover:text-emerald-700 transition">Guru & Tendik</a>
          <a href="#ekskul" class="hover:text-emerald-700 transition">Kesiswaan</a>
          <a href="/berita" class="hover:text-emerald-700 transition">Berita</a>
          <a href="/galeri" class="hover:text-emerald-700 transition">Galeri</a>
          <a href="#ppdb" class="bg-amber-500 hover:bg-amber-400 text-slate-950 font-black px-4 py-2 rounded-xl transition shadow-sm">
            SPMB 2026
          </a>
        </nav>
      </div>
    </header>

    <!-- 3. SLIDER HERO BANNER -->
    <section class="relative bg-slate-950 h-[520px] sm:h-[600px] lg:h-[660px] overflow-hidden">
      <div id="hero-slider" class="relative w-full h-full">
        {bannerSlides.map((slide, index) => (
          <div 
            class={`slide-banner absolute inset-0 transition-opacity duration-1000 ease-in-out ${index === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0 pointer-events-none'}`}
          >
            <img 
              src={slide.image} 
              alt={slide.title} 
              class="w-full h-full object-cover object-center"
            />
            
            <div class="absolute inset-0 bg-gradient-to-t md:bg-gradient-to-r from-emerald-950/95 via-slate-950/75 to-slate-950/30"></div>

            <div class="absolute inset-0 flex items-center">
              <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
                <div class="max-w-2xl text-left">
                  <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 bg-emerald-600/90 backdrop-blur-sm border border-emerald-400/40 text-emerald-100 text-xs font-bold uppercase tracking-wider rounded-lg mb-4">
                    ★ {slide.tag}
                  </span>
                  <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black text-white uppercase tracking-tight leading-tight drop-shadow-md">
                    {slide.title}
                  </h1>
                  <p class="mt-4 text-slate-200 text-sm sm:text-base lg:text-lg leading-relaxed font-normal drop-shadow">
                    {slide.desc}
                  </p>
                  <div class="mt-8 flex flex-wrap gap-4">
                    <a 
                      href={slide.btnLink} 
                      class="bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold px-7 py-3.5 rounded-xl transition shadow-lg shadow-amber-500/20 text-xs sm:text-sm uppercase tracking-wider flex items-center gap-2"
                    >
                      {slide.btnText}
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
                    </a>
                    <a 
                      href="#sambutan" 
                      class="bg-white/10 hover:bg-white/20 text-white backdrop-blur-md border border-white/20 font-bold px-7 py-3.5 rounded-xl transition text-xs sm:text-sm uppercase tracking-wider"
                    >
                      Profil Sekolah
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>

      <button id="btnPrevSlide" aria-label="Slide sebelumnya" class="absolute left-4 sm:left-8 top-1/2 -translate-y-1/2 z-30 p-3 rounded-full bg-emerald-950/60 hover:bg-emerald-600 text-white backdrop-blur-md border border-white/10 transition">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/></svg>
      </button>
      <button id="btnNextSlide" aria-label="Slide berikutnya" class="absolute right-4 sm:right-8 top-1/2 -translate-y-1/2 z-30 p-3 rounded-full bg-emerald-950/60 hover:bg-emerald-600 text-white backdrop-blur-md border border-white/10 transition">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
      </button>

      <div class="absolute bottom-8 left-0 right-0 z-30 flex justify-center items-center gap-2.5">
        {bannerSlides.map((_, index) => (
          <button 
            class={`dot-slider h-2 rounded-full transition-all duration-300 ${index === 0 ? 'bg-amber-400 w-8' : 'bg-white/40 w-2'}`} 
            data-slide={index}
            aria-label={`Pindah ke slide ${index + 1}`}
          ></button>
        ))}
      </div>
    </section>

    <!-- 4. SAMBUTAN KEPALA SEKOLAH -->
    <section id="sambutan" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
      <div class="bg-white rounded-3xl p-8 sm:p-12 border border-slate-200/80 shadow-sm grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-4 flex justify-center">
          <div class="relative w-60 h-72 sm:w-64 sm:h-80 rounded-2xl overflow-hidden shadow-xl border-4 border-emerald-50 bg-emerald-900">
            <img 
              src="https://images.unsplash.com/photo-1560250097-0b93528c311a?q=80&w=600&auto=format&fit=crop" 
              alt="Kepala SMA Negeri Alor Kecil" 
              class="w-full h-full object-cover object-top"
            />
            <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-emerald-950 p-4 text-center">
              <span class="text-xs font-bold text-amber-300 block">Pimpinan Sekolah</span>
            </div>
          </div>
        </div>

        <div class="lg:col-span-8">
          <span class="text-xs font-black text-emerald-700 uppercase tracking-widest">Sambutan Resmi</span>
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-black text-slate-900 tracking-tight mt-2 leading-tight">
            “Pendidikan Adalah Investasi Terbaik untuk Masa Depan”
          </h2>
          <p class="mt-4 text-slate-600 leading-relaxed text-sm sm:text-base">
            Salam sejahtera dan selamat datang di portal resmi SMA Negeri Alor Kecil. Website ini dihadirkan sebagai jembatan informasi yang akuntabel, transparan, dan dapat diakses oleh seluruh orang tua, peserta didik, serta masyarakat umum. Kami terus berupaya membina generasi yang cerdas nalar dan beretika luhur.
          </p>

          <div class="mt-6 pt-6 border-t border-slate-100 flex flex-col sm:flex-row justify-between sm:items-center gap-4">
            <div>
              <p class="font-bold text-slate-900 text-base">Kepala Sekolah</p>
              <p class="text-xs text-slate-400">SMA Negeri Alor Kecil</p>
            </div>
            <a href="#program" class="bg-emerald-700 hover:bg-emerald-800 text-white font-bold px-5 py-2.5 rounded-xl text-xs uppercase tracking-wider transition self-start sm:self-auto">
              Profil Sekolah Lengkap &rarr;
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- 5. BERITA & AGENDA -->
    <section id="berita" class="bg-white py-20 border-y border-slate-200/80">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col sm:flex-row justify-between sm:items-end mb-10 pb-4 border-b border-slate-100">
          <div>
            <span class="text-xs font-black text-emerald-700 uppercase tracking-widest">Publikasi Sekolah</span>
            <h2 class="text-2xl sm:text-3xl font-black text-slate-900 uppercase tracking-tight mt-1">Berita & Agenda Terkini</h2>
          </div>
          <a href="/berita" class="text-xs font-bold text-emerald-700 hover:text-emerald-800 uppercase tracking-wider flex items-center gap-1 mt-2 sm:mt-0">
            Lihat Semua Berita &rarr;
          </a>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
          <div class="lg:col-span-8">
            {beritaUtama.length === 0 ? (
              <div class="p-12 text-center bg-slate-50 rounded-2xl border border-dashed border-slate-200">
                <p class="text-slate-500 text-sm">Belum ada artikel publikasi. Buka <a href="/admin" class="text-emerald-700 underline font-bold">Panel Admin CMS</a> untuk menulis berita pertama.</p>
              </div>
            ) : (
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                {beritaUtama.map((item) => (
                  <article class="bg-white rounded-2xl border border-slate-200/80 overflow-hidden shadow-sm hover:shadow-md transition flex flex-col group">
                    <div class="h-44 overflow-hidden bg-emerald-50">
                      {item.data.thumbnail ? (
                        <img src={item.data.thumbnail} alt={item.data.title} class="w-full h-full object-cover group-hover:scale-105 transition duration-300" />
                      ) : (
                        <div class="w-full h-full flex items-center justify-center text-emerald-700/60 font-bold text-xs bg-emerald-50">
                          Dokumentasi Sekolah
                        </div>
                      )}
                    </div>
                    <div class="p-5 flex flex-col flex-1">
                      <div class="flex justify-between items-center text-[11px] text-slate-400 mb-2">
                        <span class="font-bold text-emerald-700 uppercase tracking-wider">{item.data.category}</span>
                        <span>{item.data.date.toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' })}</span>
                      </div>
                      <h3 class="font-bold text-base text-slate-900 line-clamp-2 group-hover:text-emerald-700 transition">
                        <a href={`/berita/${item.id}`}>{item.data.title}</a>
                      </h3>
                      <p class="text-xs text-slate-500 mt-2 line-clamp-2 leading-relaxed flex-1">
                        {item.data.description}
                      </p>
                      <a href={`/berita/${item.id}`} class="mt-4 pt-3 border-t border-slate-100 text-xs font-bold text-emerald-700 hover:text-emerald-800 inline-block">
                        Baca Selengkapnya &rarr;
                      </a>
                    </div>
                  </article>
                ))}
              </div>
            )}
          </div>

          <div class="lg:col-span-4">
            <div class="bg-emerald-50/70 border border-emerald-100 rounded-2xl p-6">
              <h3 class="font-black text-slate-900 text-sm uppercase tracking-wider mb-5 flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-emerald-600"></span>
                Agenda Kegiatan
              </h3>

              <div class="space-y-4">
                {daftarAgenda.map((agenda) => (
                  <div class="bg-white p-4 rounded-xl border border-emerald-100 shadow-xs flex items-center gap-4">
                    <div class="w-12 h-12 rounded-xl bg-emerald-700 text-white flex flex-col items-center justify-center flex-shrink-0 shadow-sm">
                      <span class="text-base font-black leading-none">{agenda.tgl}</span>
                      <span class="text-[9px] font-bold uppercase tracking-wider">{agenda.bln}</span>
                    </div>
                    <div>
                      <h4 class="font-bold text-xs text-slate-900 leading-snug line-clamp-2">{agenda.judul}</h4>
                      <p class="text-[11px] text-slate-400 mt-1">📍 {agenda.tempat}</p>
                    </div>
                  </div>
                ))}
              </div>

              <a href="/berita" class="mt-5 block text-center py-2.5 text-xs font-bold text-emerald-800 bg-emerald-100/60 hover:bg-emerald-100 rounded-xl transition">
                Lihat Kalender Lengkap
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 6. PROGRAM UNGGULAN SEKOLAH -->
    <section id="program" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="text-xs font-black text-emerald-700 uppercase tracking-widest">Pilar Pendidikan</span>
        <h2 class="text-2xl sm:text-3xl font-black text-slate-900 uppercase tracking-tight mt-1">Program Unggulan</h2>
        <p class="text-slate-500 text-xs sm:text-sm mt-2">Fondasi pembinaan akademik, kepribadian, dan literasi teknologi modern.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {programUnggulan.map((prog) => (
          <div class="bg-white rounded-2xl p-8 border border-slate-200/80 shadow-sm hover:-translate-y-1 transition duration-300">
            <div class="w-14 h-14 rounded-2xl bg-emerald-50 text-2xl flex items-center justify-center mb-6">
              {prog.ikon}
            </div>
            <h3 class="font-bold text-lg text-slate-900">{prog.nama}</h3>
            <p class="text-slate-600 text-xs sm:text-sm mt-3 leading-relaxed">{prog.desc}</p>
          </div>
