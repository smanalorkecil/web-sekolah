---
import { getCollection } from 'astro:content';
import '../styles/global.css'; // <-- Tambahkan baris ini!

// Mengambil data berita yang sudah diurutkan dari yang terbaru
const beritaList = (await getCollection('berita'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 6);
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Portal Resmi Sekolah</title>
  </head>
  <body class="bg-gray-50 text-gray-800 antialiased">
    <!-- Navbar -->
    <header class="bg-white border-b border-gray-100 sticky top-0 z-50">
      <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">
        <span class="font-extrabold text-xl text-blue-700 tracking-tight">SMA NEGERI CONTOH</span>
        <nav class="hidden md:flex gap-6 text-sm font-medium text-gray-600">
          <a href="/" class="text-blue-600 font-semibold">Beranda</a>
          <a href="/berita" class="hover:text-blue-600">Berita</a>
          <a href="/galeri" class="hover:text-blue-600">Galeri</a>
          <a href="/admin" class="bg-blue-600 text-white px-3 py-1.5 rounded-lg hover:bg-blue-700 transition">Panel Admin</a>
        </nav>
      </div>
    </header>

    <!-- Hero Section -->
    <section class="bg-gradient-to-r from-blue-700 to-indigo-800 text-white py-20 px-4">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-3xl md:text-5xl font-black leading-tight">Membangun Generasi Cerdas, Mandiri, dan Berkarakter</h1>
        <p class="mt-4 text-blue-100 text-base md:text-lg">Portal informasi resmi kegiatan akademik, pengumuman, dan prestasi civitas akademika.</p>
      </div>
    </section>

    <!-- Bagian Berita & Dokumentasi Terbaru -->
    <main class="max-w-6xl mx-auto px-4 py-16">
      <div class="flex justify-between items-end mb-8">
        <div>
          <h2 class="text-2xl font-bold text-gray-900">Kabar & Agenda Terbaru</h2>
          <p class="text-gray-500 text-sm mt-1">Dokumentasi kegiatan dan rilis informasi resmi sekolah.</p>
        </div>
      </div>

      {beritaList.length === 0 ? (
        <div class="text-center py-12 bg-white rounded-2xl border border-gray-100">
          <p class="text-gray-500 text-sm">Belum ada artikel yang diterbitkan. Buat artikel baru melalui <a href="/admin" class="text-blue-600 font-semibold underline">Panel Admin</a>.</p>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {beritaList.map((item) => (
            <article class="bg-white rounded-2xl border border-gray-100 overflow-hidden shadow-sm hover:shadow-md transition">
              {item.data.thumbnail && (
                <img src={item.data.thumbnail} alt={item.data.title} class="w-full h-48 object-cover" />
              )}
              <div class="p-5">
                <span class="text-xs font-semibold text-blue-600 bg-blue-50 px-2.5 py-1 rounded-full">{item.data.category}</span>
                <h3 class="font-bold text-lg text-gray-900 mt-3 line-clamp-2 hover:text-blue-600">
                  <a href={`/berita/${item.id}`}>{item.data.title}</a>
                </h3>
                <p class="text-xs text-gray-400 mt-2">
                  {item.data.date.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })}
                </p>
                <p class="text-sm text-gray-600 mt-3 line-clamp-2">{item.data.description}</p>
              </div>
            </article>
          ))}
        </div>
      )}
    </main>
  </body>
</html>