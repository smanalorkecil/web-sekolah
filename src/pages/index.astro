  </section>

  <!-- ==================== 7. EKSTRAKURIKULER (SCROLL REVEAL & HOVER POP) ==================== -->
  <section id="ekskul" class="reveal-section max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-20 border-t border-slate-200/80">
    <div class="text-center max-w-2xl mx-auto mb-10">
