---
import { getCollection } from 'astro:content';
import '../styles/global.css';

// Ambil berita terbaru (maksimal 6)
const beritaList = (await getCollection('berita'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 6);

// Data slide banner (bisa diganti foto asli sekolah nanti)
const slides = [
  {
    image: "https://images.unsplash.com/photo-1523050854058-8df90110c9f1?q=80&w=1600&auto=format&fit=crop",
    tag: "Tahun Ajaran Baru",
    title: "Membangun Generasi Cerdas, Mandiri, dan Berkarakter",
    desc: "Menyediakan ekosistem belajar yang adaptif terhadap teknologi digital dan berakar pada nilai integritas.",
    link: "/berita",
    btnText: "Jelajahi Berita"
  },
  {
    image: "https://images.unsplash.com/photo-1577896851231-70ef18881754?q=80&w=1600&auto=format&fit=crop",
    tag: "Prestasi Siswa",
    title: "Mengukir Prestasi di Tingkat Wilayah dan Nasional",
    desc: "Wadah pengembangan potensi akademik, sains, seni, dan kepemimpinan pemuda.",
    link: "/galeri",
    btnText: "Lihat Dokumentasi"
  },
  {
    image: "https://images.unsplash.com/photo-1509062522246-3755977927d7?q=80&w=1600&auto=format&fit=crop",
    tag: "Fasilitas & Layanan",
    title: "Transformasi Digital dalam Layanan Sekolah",
    desc: "Akses informasi pengumuman resmi dan arsip administrasi secara transparan dan terpadu.",
    link: "/admin",
    btnText: "Portal Pengelola"
  }
];
---

<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Portal Resmi Sekolah</title>
  </head>
  <body class="bg-slate-50 text-slate-800 antialiased selection:bg-blue-600 selection:text-white">

    <!-- Header / Navbar Modern -->
    <header class="bg-white/90 backdrop-blur-md border-b border-slate-200/80 sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
        <a href="/" class="flex items-center gap-3">
          <div class="w-11 h-11 rounded-xl bg-gradient-to-tr from-blue-700 to-indigo-600 flex items-center justify-center text-white font-black text-xl shadow-md shadow-blue-500/20">
            S
          </div>
          <div>
            <span class="block font-black text-lg sm:text-xl text-slate-900 tracking-tight leading-none">SMA NEGERI CONTOH</span>
            <span class="text-xs text-slate-500 font-medium tracking-wide">Unggul, Berakhlak, Berdaya Saing</span>
          </div>
        </a>

        <nav class="hidden md:flex items-center gap-8 text-sm font-semibold text-slate-600">
          <a href="/" class="text-blue-600">Beranda</a>
          <a href="/berita" class="hover:text-blue-600 transition-colors">Berita</a>
          <a href="/galeri" class="hover:text-blue-600 transition-colors">Galeri</a>
          <a href="/admin" class="bg-slate-900 hover:bg-blue-600 text-white px-4 py-2 rounded-xl transition-all shadow-sm">
            Panel Staf
          </a>
        </nav>
      </div>
    </header>

    <!-- Banner Slider Modern -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-12">
      <div class="relative h-[480px] sm:h-[540px] md:h-[580px] rounded-3xl overflow-hidden shadow-2xl shadow-slate-300/50 bg-slate-950">
        
        <!-- Wadah Item Slide -->
        <div id="slider-container" class="relative w-full h-full">
          {slides.map((slide, index) => (
            <div 
              class={`slide-item absolute inset-0 transition-opacity duration-1000 ease-in-out ${index === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0 pointer-events-none'}`}
            >
              <!-- Gambar Banner -->
              <img 
                src={slide.image} 
                alt={slide.title} 
                class="w-full h-full object-cover object-center"
              />
              
              <!-- Gradient Overlay agar teks terbaca tajam -->
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950/95 via-slate-900/50 to-black/20"></div>

              <!-- Teks Konten Slide -->
              <div class="absolute inset-0 flex flex-col justify-end p-6 sm:p-12 md:p-16 max-w-3xl z-20">
                <span class="inline-block w-fit px-3 py-1 bg-blue-600/90 backdrop-blur-sm text-white text-xs font-bold uppercase tracking-wider rounded-full mb-3">
                  {slide.tag}
                </span>
                <h1 class="text-2xl sm:text-4xl md:text-5xl font-black text-white leading-tight mb-4 drop-shadow-sm">
                  {slide.title}
                </h1>
                <p class="text-sm sm:text-base text-slate-200 font-normal leading-relaxed mb-6 line-clamp-2 sm:line-clamp-3">
                  {slide.desc}
                </p>
                <div>
                  <a 
                    href={slide.link} 
                    class="inline-flex items-center gap-2 bg-white hover:bg-blue-50 text-slate-900 font-bold px-6 py-3 rounded-xl transition-all shadow-lg hover:shadow-xl text-sm"
                  >
                    {slide.btnText}
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                  </a>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- Tombol Navigasi Kiri & Kanan -->
        <button id="prevBtn" aria-label="Slide sebelumnya" class="absolute left-4 top-1/2 -translate-y-1/2 z-30 p-2.5 rounded-full bg-white/20 hover:bg-white text-white hover:text-slate-900 backdrop-blur-md transition-all">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/></svg>
        </button>
        <button id="nextBtn" aria-label="Slide berikutnya" class="absolute right-4 top-1/2 -translate-y-1/2 z-30 p-2.5 rounded-full bg-white/20 hover:bg-white text-white hover:text-slate-900 backdrop-blur-md transition-all">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
        </button>

        <!-- Titik Indikator Slider -->
        <div class="absolute bottom-6 right-6 sm:right-12 z-30 flex items-center gap-2">
          {slides.map((_, index) => (
            <button 
              class={`dot-btn w-2.5 h-2.5 rounded-full transition-all duration-300 ${index === 0 ? 'bg-white w-8' : 'bg-white/40'}`} 
              data-index={index}
              aria-label={`Buka slide ${index + 1}`}
            ></button>
          ))}
        </div>
      </div>
    </section>

    <!-- Kartu Statistik & Keunggulan -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-16">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6">
        <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm text-center">
          <span class="block text-3xl sm:text-4xl font-black text-blue-600">A</span>
          <span class="text-xs sm:text-sm font-semibold text-slate-500 uppercase tracking-wider mt-1 block">Akreditasi BAN-SM</span>
        </div>
        <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm text-center">
          <span class="block text-3xl sm:text-4xl font-black text-indigo-600">36+</span>
          <span class="text-xs sm:text-sm font-semibold text-slate-500 uppercase tracking-wider mt-1 block">Pendidik & Tenaga Ahli</span>
        </div>
        <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm text-center">
          <span class="block text-3xl sm:text-4xl font-black text-emerald-600">500+</span>
          <span class="text-xs sm:text-sm font-semibold text-slate-500 uppercase tracking-wider mt-1 block">Siswa Aktif</span>
        </div>
        <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm text-center">
          <span class="block text-3xl sm:text-4xl font-black text-amber-500">100%</span>
          <span class="text-xs sm:text-sm font-semibold text-slate-500 uppercase tracking-wider mt-1 block">Kelulusan</span>
        </div>
      </div>
    </section>

    <!-- Bagian Berita & Dokumentasi Terbaru -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-20">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 pb-4 border-b border-slate-200">
        <div>
          <span class="text-blue-600 font-bold text-xs uppercase tracking-wider">Publikasi Resmi</span>
          <h2 class="text-2xl sm:text-3xl font-black text-slate-900 mt-1">Kabar & Agenda Sekolah</h2>
        </div>
        <a href="/berita" class="text-sm font-bold text-blue-600 hover:text-blue-800 flex items-center gap-1 mt-2 sm:mt-0">
          Lihat Semua Berita &rarr;
        </a>
      </div>

      {beritaList.length === 0 ? (
        <div class="text-center py-16 bg-white rounded-3xl border border-dashed border-slate-300">
          <p class="text-slate-500 font-medium">Belum ada artikel publikasi yang diterbitkan.</p>
          <a href="/admin" class="inline-block mt-4 text-xs font-bold text-white bg-blue-600 px-4 py-2.5 rounded-xl hover:bg-blue-700 transition">
            Tulis Berita Pertama di Panel Admin
          </a>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {beritaList.map((item) => (
            <article class="bg-white rounded-2xl border border-slate-200/80 overflow-hidden shadow-sm hover:shadow-md transition group flex flex-col">
              {item.data.thumbnail ? (
                <div class="h-48 overflow-hidden bg-slate-100">
                  <img src={item.data.thumbnail} alt={item.data.title} class="w-full h-full object-cover group-hover:scale-105 transition duration-500" />
                </div>
              ) : (
                <div class="h-48 bg-gradient-to-tr from-slate-100 to-slate-200 flex items-center justify-center text-slate-400 font-semibold text-xs">
                  Dokumentasi Foto
                </div>
              )}
              <div class="p-6 flex flex-col flex-grow">
                <span class="w-fit text-xs font-bold text-blue-700 bg-blue-50 px-2.5 py-1 rounded-md mb-3">
                  {item.data.category}
                </span>
                <h3 class="font-bold text-lg text-slate-900 line-clamp-2 group-hover:text-blue-600 transition">
                  <a href={`/berita/${item.id}`}>{item.data.title}</a>
                </h3>
                <p class="text-xs text-slate-400 mt-2">
                  {item.data.date.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })}
                </p>
                <p class="text-sm text-slate-600 mt-3 line-clamp-2 leading-relaxed flex-grow">
                  {item.data.description}
                </p>
                <div class="mt-4 pt-4 border-t border-slate-100 flex justify-between items-center text-xs font-semibold text-blue-600">
                  <span>Baca Selengkapnya</span>
                  <span>&rarr;</span>
                </div>
              </div>
            </article>
          ))}
        </div>
      )}
    </main>

    <!-- Footer Sekolah -->
    <footer class="bg-slate-900 text-slate-400 text-sm py-12 border-t border-slate-800">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row justify-between items-center gap-4">
        <p>&copy; {new Date().getFullYear()} SMA Negeri Contoh. Seluruh Hak Cipta Dilindungi.</p>
        <div class="flex gap-6 text-xs">
          <a href="/admin" class="hover:text-white transition">Masuk Staf</a>
          <a href="/galeri" class="hover:text-white transition">Galeri Foto</a>
        </div>
      </div>
    </footer>

    <!-- Script Slider Interaktif (Autoplay + Transisi Halus) -->
    <script>
      let currentIndex = 0;
      const slides = document.querySelectorAll<HTMLElement>('.slide-item');
      const dots = document.querySelectorAll<HTMLElement>('.dot-btn');
      const totalSlides = slides.length;
      let slideInterval: any;

      function updateSlide(nextIndex: number) {
        // Reset slide saat ini
        slides[currentIndex].classList.remove('opacity-100', 'z-10');
        slides[currentIndex].classList.add('opacity-0', 'z-0', 'pointer-events-none');
        dots[currentIndex].classList.remove('bg-white', 'w-8');
        dots[currentIndex].classList.add('bg-white/40');

        // Pindah index
        currentIndex = (nextIndex + totalSlides) % totalSlides;

        // Tampilkan slide berikutnya
        slides[currentIndex].classList.remove('opacity-0', 'z-0', 'pointer-events-none');
        slides[currentIndex].classList.add('opacity-100', 'z-10');
        dots[currentIndex].classList.remove('bg-white/40');
        dots[currentIndex].classList.add('bg-white', 'w-8');
      }

      function startAutoPlay() {
        slideInterval = setInterval(() => {
          updateSlide(currentIndex + 1);
        }, 5000); // Berganti otomatis setiap 5 detik
      }

      function resetAutoPlay() {
        clearInterval(slideInterval);
        startAutoPlay();
      }

      document.getElementById('nextBtn')?.addEventListener('click', () => {
        updateSlide(currentIndex + 1);
        resetAutoPlay();
      });

      document.getElementById('prevBtn')?.addEventListener('click', () => {
        updateSlide(currentIndex - 1);
        resetAutoPlay();
      });

      dots.forEach((dot) => {
        dot.addEventListener('click', (e) => {
          const target = e.currentTarget as HTMLElement;
          const idx = parseInt(target.getAttribute('data-index') || '0', 10);
          updateSlide(idx);
          resetAutoPlay();
        });
      });

      // Jalankan slider saat halaman dibuka
      startAutoPlay();
    </script>
  </body>
</html>