---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

// 1. Mengimpor data Galeri dari src/data/galeri.ts (Mendukung named maupun default export)
import * as galeriModule from '../data/galeri';
const semuaGaleri = (galeriModule.daftarGaleri || galeriModule.galeri || galeriModule.galeriData || galeriModule.default || []) as any[];
const galeriPreview = semuaGaleri.slice(0, 4);

// 2. Mengambil data berita dengan proteksi jika data masih kosong
let beritaUtama: any[] = [];
try {
  const semuaBerita = (await getCollection('berita')) || [];
  beritaUtama = semuaBerita
    .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
    .slice(0, 4);
} catch (e) {
  beritaUtama = [];
}

// 3. Data Slide Banner
const bannerSlides = [
  {
    image: "https://images.unsplash.com/photo-1523050854058-8df90110c9f1?q=80&w=1600&auto=format&fit=crop",
    tag: "Tahun Ajaran 2026/2027",
    title: "Membangun Masa Depan Bangsa",
    desc: "Mewujudkan generasi cendekia yang berkarakter kokoh, berwawasan global, dan adaptif terhadap transformasi digital.",
    btnText: "Daftar SPMB / PPDB",
    btnLink: "#ppdb"
  },
  {
    image: "https://images.unsplash.com/photo-1577896851231-70ef18881754?q=80&w=1600&auto=format&fit=crop",
    tag: "Komunitas Pembelajar",
    title: "Unggul dalam Prestasi & Budi Pekerti",
    desc: "Mengasah talenta akademik, seni budaya, serta kepemimpinan pemuda dalam kerangka Kurikulum Merdeka.",
    btnText: "Dokumentasi Kegiatan",
    btnLink: "/galeri"
  },
  {
    image: "https://images.unsplash.com/photo-1509062522246-3755977927d7?q=80&w=1600&auto=format&fit=crop",
    tag: "Layanan Terpadu",
    title: "Layanan Pendidikan Terbuka & Transparan",
    desc: "Pusat informasi publik rilis berita resmi, arsip akademik, dan direktori kependidikan terintegrasi.",
    btnText: "Direktori Guru & Tendik",
    btnLink: "/guru"
  }
];

// 4. Data Agenda Kegiatan Sekolah
const daftarAgenda = [
  { tgl: "15", bln: "OKT", judul: "Asesmen Sumatif Tengah Semester Ganjil", tempat: "Ruang Kelas & Lab Komputer" },
  { tgl: "22", bln: "OKT", judul: "Peringatan Hari Santri & Kegiatan Rohani", tempat: "Lapangan Utama Sekolah" },
  { tgl: "28", bln: "OKT", judul: "Upacara Peringatan Hari Sumpah Pemuda", tempat: "Halaman Upacara" },
  { tgl: "10", bln: "NOV", judul: "Gelar Karya Proyek P5 & Pentas Seni Siswa", tempat: "Aula Pertemuan" }
];

// 5. Data Program Unggulan
const programUnggulan = [
  { ikon: "💡", nama: "Program Riset & Sains", desc: "Pembinaan karya ilmiah remaja, olimpiade sains nasional, dan penguasaan teknologi dasar." },
  { ikon: "📖", nama: "Penguatan Karakter", desc: "Penanaman nilai budi pekerti, disiplin positif, serta kebiasaan literasi pagi terjadwal." },
  { ikon: "💻", nama: "Digitalisasi Pembelajaran", desc: "Integrasi sistem pembelajaran digital terpadu dan pembekalan literasi komputer." }
];

// 6. Data Ekstrakurikuler
const ekskulList = [
  { nama: "Pramuka", ikon: "⛺" },
  { nama: "Paskibra", ikon: "🇮🇩" },
  { nama: "PMR", ikon: "🩺" },
  { nama: "Futsal", ikon: "⚽" },
  { nama: "Voli", ikon: "🏐" },
  { nama: "Seni Tari Alor", ikon: "💃" },
  { nama: "Paduan Suara", ikon: "🎵" },
  { nama: "TIK / Komputer", ikon: "💻" },
  { nama: "Kerohanian", ikon: "🤲" },
  { nama: "English Club", ikon: "🗣️" }
];
---

<Layout title="SMA Negeri Alor Kecil - Berkarakter, Unggul, Berdaya Saing">

  <!-- ==================== 1. SLIDER HERO BANNER ==================== -->
  <section class="relative bg-slate-950 h-[560px] sm:h-[600px] lg:h-[660px] overflow-hidden">
    <div id="hero-slider" class="relative w-full h-full">
      {bannerSlides.map((slide, index) => (
        <div 
          class={`slide-banner absolute inset-0 transition-opacity duration-1000 ease-in-out ${index === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0 pointer-events-none'}`}
        >
          <img 
            src={slide.image} 
            alt={slide.title} 
            class="w-full h-full object-cover object-center"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-emerald-950/95 via-slate-950/80 to-slate-950/35"></div>

          <div class="absolute inset-0 flex items-center">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
              <div class="max-w-2xl text-left pt-6 sm:pt-0">
                <span class="inline-flex items-center gap-1.5 px-3 py-1 sm:px-3.5 sm:py-1.5 bg-emerald-600/90 backdrop-blur-sm border border-emerald-400/40 text-emerald-100 text-[11px] sm:text-xs font-bold uppercase tracking-wider rounded-lg mb-3 sm:mb-4 shadow-xs">
                  ★ {slide.tag}
                </span>
                
                <h1 class="text-2xl sm:text-4xl lg:text-6xl font-black text-white uppercase tracking-tight leading-tight drop-shadow-md">
                  {slide.title}
                </h1>
                
                <p class="mt-3 sm:mt-4 text-slate-200 text-xs sm:text-base lg:text-lg leading-relaxed font-normal drop-shadow max-w-xl">
                  {slide.desc}
                </p>
                
                <div class="mt-6 sm:mt-8 flex flex-wrap items-center gap-3 sm:gap-4">
                  <a 
                    href={slide.btnLink} 
                    class="bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold px-6 sm:px-7 py-3 sm:py-3.5 rounded-xl transition shadow-lg shadow-amber-500/20 text-xs sm:text-sm uppercase tracking-wider flex items-center gap-2"
                  >
                    <span>{slide.btnText}</span>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
                  </a>
                  
                  <a 
                    href="/profil/sambutan" 
                    class="bg-white/10 hover:bg-white/20 text-white backdrop-blur-md border border-white/20 font-bold px-6 sm:px-7 py-3 sm:py-3.5 rounded-xl transition text-xs sm:text-sm uppercase tracking-wider"
                  >
                    Profil Sekolah
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Tombol Panah Kiri (Tablet & Desktop) -->
    <button 
      id="btnPrevSlide"
      type="button"
      aria-label="Slide Sebelumnya"
      class="hidden sm:flex absolute left-4 sm:left-6 top-1/2 -translate-y-1/2 z-30 w-11 h-11 sm:w-12 sm:h-12 rounded-full bg-slate-950/60 hover:bg-slate-900/90 text-white backdrop-blur-md border border-white/20 items-center justify-center transition shadow-lg hover:scale-105 active:scale-95"
    >
      <svg class="w-5 h-5 text-amber-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/>
      </svg>
    </button>

    <!-- Tombol Panah Kanan (Tablet & Desktop) -->
    <button 
      id="btnNextSlide"
      type="button"
      aria-label="Slide Berikutnya"
      class="hidden sm:flex absolute right-4 sm:right-6 top-1/2 -translate-y-1/2 z-30 w-11 h-11 sm:w-12 sm:h-12 rounded-full bg-slate-950/60 hover:bg-slate-900/90 text-white backdrop-blur-md border border-white/20 items-center justify-center transition shadow-lg hover:scale-105 active:scale-95"
    >
      <svg class="w-5 h-5 text-amber-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
      </svg>
    </button>

    <!-- Dots Slider -->
    <div class="absolute bottom-6 sm:bottom-8 left-0 right-0 z-30 flex justify-center items-center gap-2.5">
      {bannerSlides.map((_, index) => (
        <button 
          type="button"
          class={`dot-slider h-2 rounded-full transition-all duration-300 ${index === 0 ? 'bg-amber-400 w-8' : 'bg-white/40 w-2'}`} 
          data-slide={index}
          aria-label={`Pindah ke slide ${index + 1}`}
        ></button>
      ))}
    </div>
  </section>

  <!-- ==================== 2. SAMBUTAN KEPALA SEKOLAH ==================== -->
  <section id="sambutan" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-20">
    <div class="bg-white rounded-3xl p-6 sm:p-12 border border-slate-200/80 shadow-xs grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
      
      <div class="lg:col-span-4 flex justify-center">
        <div class="relative w-52 h-64 sm:w-64 sm:h-80 rounded-2xl overflow-hidden shadow-md border-4 border-emerald-50 bg-emerald-900">
          <img 
            src="https://images.unsplash.com/photo-1560250097-0b93528c311a?q=80&w=600&auto=format&fit=crop" 
            alt="Kepala SMA Negeri Alor Kecil" 
            class="w-full h-full object-cover object-top"
          />
          <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-emerald-950 p-3 text-center">
            <span class="text-xs font-bold text-amber-300 block">Rahmad Kapitan, S.Pd</span>
          </div>
        </div>
      </div>

      <div class="lg:col-span-8">
        <span class="text-xs font-black text-emerald-700 uppercase tracking-widest">Sambutan Resmi</span>
        <h2 class="text-xl sm:text-3xl lg:text-4xl font-black text-slate-900 tracking-tight mt-2 leading-tight">
          “Pendidikan Adalah Investasi Terbaik untuk Masa Depan”
        </h2>
        <p class="mt-4 text-slate-600 leading-relaxed text-xs sm:text-base">
          Salam sejahtera dan selamat datang di portal resmi SMA Negeri Alor Kecil. Website ini dihadirkan sebagai jembatan informasi yang akuntabel, transparan, dan dapat diakses oleh seluruh orang tua, peserta didik, serta masyarakat umum. Kami terus berupaya membina generasi yang cerdas nalar dan beretika luhur.
        </p>

        <div class="mt-6 pt-6 border-t border-slate-100 flex flex-col sm:flex-row justify-between sm:items-center gap-4">
          <div>
            <p class="font-bold text-slate-900 text-sm sm:text-base">Kepala Sekolah</p>
            <p class="text-xs text-slate-400">SMA Negeri Alor Kecil</p>
          </div>
          <a 
            href="/profil/sambutan" 
            class="bg-emerald-700 hover:bg-emerald-800 text-white font-bold px-5 py-2.5 rounded-xl text-xs uppercase tracking-wider transition self-start sm:self-auto"
          >
            Baca Sambutan Lengkap &rarr;
          </a>
        </div>
      </div>

    </div>
  </section>

  <!-- ==================== 3. BERITA & AGENDA ==================== -->
  <section id="berita" class="bg-white py-14 sm:py-20 border-y border-slate-200/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex flex-col sm:flex-row justify-between sm:items-end mb-8 sm:mb-10 pb-4 border-b border-slate-100">
        <div>
          <span class="text-xs font-black text-emerald-700 uppercase tracking-widest">Publikasi Sekolah</span>
          <h2 class="text-2xl sm:text-3xl font-black text-slate-900 uppercase tracking-tight mt-1">Berita & Agenda Terkini</h2>
        </div>
        <a href="/berita" class="text-xs font-bold text-emerald-700 hover:text-emerald-800 uppercase tracking-wider flex items-center gap-1 mt-2 sm:mt-0">
          Lihat Semua Berita &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        
        <div class="lg:col-span-8">
          {beritaUtama.length === 0 ? (
            <div class="p-10 text-center bg-slate-50 rounded-2xl border border-dashed border-slate-200">
              <p class="text-slate-500 text-sm">Belum ada artikel publikasi. Buka <a href="/admin" class="text-emerald-700 underline font-bold">Panel Admin CMS</a> untuk menulis berita pertama.</p>
            </div>
          ) : (
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              {beritaUtama.map((item) => {
                const linkSlug = item.slug || item.id?.replace(/\.md$/, '') || '';
                const tanggalText = item.data?.date 
                  ? new Date(item.data.date).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' })
                  : '-';
                
                return (
                  <article class="bg-white rounded-2xl border border-slate-200/80 overflow-hidden shadow-xs hover:shadow-md transition flex flex-col group">
                    <div class="h-44 overflow-hidden bg-emerald-50">
                      {item.data?.thumbnail ? (
                        <img src={item.data.thumbnail} alt={item.data.title} class="w-full h-full object-cover group-hover:scale-105 transition duration-300" />
                      ) : (
                        <div class="w-full h-full flex items-center justify-center text-emerald-700/60 font-bold text-xs bg-emerald-50">
                          Dokumentasi Sekolah
                        </div>
                      )}
                    </div>
                    <div class="p-5 flex flex-col flex-1">
                      <div class="flex justify-between items-center text-[11px] text-slate-400 mb-2">
                        <span class="font-bold text-emerald-700 uppercase tracking-wider">{item.data?.category || 'Informasi'}</span>
                        <span>{tanggalText}</span>
                      </div>
                      <h3 class="font-bold text-base text-slate-900 line-clamp-2 group-hover:text-emerald-700 transition">
                        <a href={`/berita/${linkSlug}`}>{item.data?.title}</a>
                      </h3>
                      <p class="text-xs text-slate-500 mt-2 line-clamp-2 leading-relaxed flex-1">
                        {item.data?.description}
                      </p>
                      <a href={`/berita/${linkSlug}`} class="mt-4 pt-3 border-t border-slate-100 text-xs font-bold text-emerald-700 hover:text-emerald-800 inline-block">
                        Baca Selengkapnya &rarr;
                      </a>
                    </div>
                  </article>
                );
              })}
            </div>
          )}
        </div>

        <div class="lg:col-span-4">
          <div class="bg-emerald-50/70 border border-emerald-100 rounded-3xl p-6">
            <h3 class="font-black text-slate-900 text-sm uppercase tracking-wider mb-5 flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-600"></span>
              Agenda Kegiatan
            </h3>

            <div class="space-y-3.5">
              {daftarAgenda.map((agenda) => (
                <div class="bg-white p-3.5 rounded-2xl border border-emerald-100 shadow-xs flex items-center gap-3.5">
                  <div class="w-12 h-12 rounded-xl bg-emerald-700 text-white flex flex-col items-center justify-center flex-shrink-0 shadow-xs">
                    <span class="text-base font-black leading-none">{agenda.tgl}</span>
                    <span class="text-[9px] font-bold uppercase tracking-wider">{agenda.bln}</span>
                  </div>
                  <div>
                    <h4 class="font-bold text-xs text-slate-900 leading-snug line-clamp-2">{agenda.judul}</h4>
                    <p class="text-[11px] text-slate-400 mt-1">📍 {agenda.tempat}</p>
                  </div>
                </div>
              ))}
            </div>

            <a href="/pengumuman" class="mt-5 block text-center py-2.5 text-xs font-bold text-emerald-800 bg-emerald-100/70 hover:bg-emerald-100 rounded-xl transition">
              Lihat Papan Pengumuman &rarr;
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ==================== 4. PROGRAM UNGGULAN SEKOLAH ==================== -->
  <section id="program" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-20">
    <div class="text-center max-w-2xl mx-auto mb-10 sm:mb-12">
      <span class="text-xs font-black text-emerald-700 uppercase tracking-widest">Pilar Pendidikan</span>
      <h2 class="text-2xl sm:text-3xl font-black text-slate-900 uppercase tracking-tight mt-1">Program Unggulan</h2>
      <p class="text-slate-500 text-xs sm:text-sm mt-2">Fondasi pembinaan akademik, kepribadian, dan literasi teknologi modern.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {programUnggulan.map((prog) => (
        <div class="bg-white rounded-3xl p-7 border border-slate-200/80 shadow-xs hover:-translate-y-1 hover:border-emerald-300 transition duration-300">
          <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-2xl flex items-center justify-center mb-5">
            {prog.ikon}
          </div>
          <h3 class="font-bold text-base sm:text-lg text-slate-900">{prog.nama}</h3>
          <p class="text-slate-600 text-xs sm:text-sm mt-2.5 leading-relaxed">{prog.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ==================== 5. PITA STATISTIK HIJAU TUA ==================== -->
  <section class="bg-gradient-to-r from-emerald-950 via-emerald-900 to-emerald-950 text-white py-12 sm:py-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 text-center divide-y sm:divide-y-0 sm:divide-x divide-emerald-800">
        <div class="pt-3 sm:pt-0">
          <span class="block text-3xl sm:text-4xl lg:text-5xl font-black text-amber-400">90+</span>
          <span class="text-[11px] sm:text-xs font-bold text-emerald-200 uppercase tracking-widest mt-1.5 block">Peserta Didik</span>
        </div>
        <div class="pt-3 sm:pt-0 sm:pl-6">
          <span class="block text-3xl sm:text-4xl lg:text-5xl font-black text-white">22+</span>
          <span class="text-[11px] sm:text-xs font-bold text-emerald-200 uppercase tracking-widest mt-1.5 block">Pendidik & Tendik</span>
        </div>
        <div class="pt-3 sm:pt-0 sm:pl-6">
          <span class="block text-3xl sm:text-4xl lg:text-5xl font-black text-amber-400">2013</span>
          <span class="text-[11px] sm:text-xs font-bold text-emerald-200 uppercase tracking-widest mt-1.5 block">Tahun Berdiri</span>
        </div>
        <div class="pt-3 sm:pt-0 sm:pl-6">
          <span class="block text-3xl sm:text-4xl lg:text-5xl font-black text-white">36+</span>
          <span class="text-[11px] sm:text-xs font-bold text-emerald-200 uppercase tracking-widest mt-1.5 block">Prestasi Terukir</span>
        </div>
      </div>
    </div>
  </section>

<!-- ==================== 6. DAFTAR GURU (SLIDER POTRET ELEGAN) ==================== -->
  <section id="guru" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20">
    
    <!-- Judul dengan Garis Aksen Emas Sesuai Gambar -->
    <div class="text-center mb-10">
      <h2 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">
        Daftar Guru
      </h2>
      <div class="w-12 h-1 bg-amber-400 mx-auto mt-2.5 rounded-full"></div>
    </div>

    <!-- Kontainer Slider Guru -->
    <div class="relative group max-w-6xl mx-auto">
      
      <!-- Tombol Panah Kiri Bulat Gelap -->
      <button 
        id="btnSliderGuruPrev"
        type="button"
        aria-label="Geser Guru Sebelumnya"
        class="absolute -left-3 sm:-left-5 top-1/2 -translate-y-1/2 z-20 w-10 h-10 sm:w-11 sm:h-11 rounded-full bg-slate-900/85 hover:bg-slate-950 text-white flex items-center justify-center shadow-xl transition-all duration-200 hover:scale-105 active:scale-95"
      >
        <svg class="w-5 h-5 text-slate-100" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/>
        </svg>
      </button>

      <!-- Track Slider (Dapat digeser horizontal atau dengan tombol) -->
      <div 
        id="homeGuruTrack" 
        class="flex gap-4 sm:gap-5 overflow-x-auto scroll-smooth snap-x snap-mandatory py-3 px-1 no-scrollbar"
        style="scrollbar-width: none; -ms-overflow-style: none;"
      >
        <!-- Skeleton Loading Sementara Saat Mengambil dari Google Sheets -->
        {[1, 2, 3, 4, 5].map(() => (
          <div class="w-52 sm:w-60 flex-shrink-0 aspect-[3/4] rounded-2xl bg-slate-200 animate-pulse snap-start"></div>
        ))}
      </div>

      <!-- Tombol Panah Kanan Bulat Gelap -->
      <button 
        id="btnSliderGuruNext"
        type="button"
        aria-label="Geser Guru Berikutnya"
        class="absolute -right-3 sm:-right-5 top-1/2 -translate-y-1/2 z-20 w-10 h-10 sm:w-11 sm:h-11 rounded-full bg-slate-900/85 hover:bg-slate-950 text-white flex items-center justify-center shadow-xl transition-all duration-200 hover:scale-105 active:scale-95"
      >
        <svg class="w-5 h-5 text-slate-100" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
        </svg>
      </button>

    </div>

    <!-- Tautan di Bawah Kanan Sesuai Gambar -->
    <div class="text-right max-w-6xl mx-auto mt-6 pr-2">
      <a 
        href="/guru" 
        class="text-xs sm:text-sm font-bold text-slate-600 hover:text-emerald-700 inline-flex items-center gap-1 transition"
      >
        <span>Daftar Guru Selengkapnya</span>
        <span>&raquo;</span>
      </a>
    </div>

  </section>

  <!-- ==================== 7. EKSTRAKURIKULER ==================== -->
  <section id="ekskul" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-20 border-t border-slate-200/80">
    <div class="text-center max-w-2xl mx-auto mb-10">
      <span class="text-xs font-black text-emerald-700 uppercase tracking-widest">Kreativitas & Minat</span>
      <h2 class="text-2xl sm:text-3xl font-black text-slate-900 uppercase tracking-tight mt-1">Ekstrakurikuler</h2>
      <p class="text-slate-500 text-xs sm:text-sm mt-2">Wadah eksplorasi potensi di bidang kepemimpinan, seni, olahraga, dan sains.</p>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-3.5">
      {ekskulList.map((ekskul) => (
        <div class="bg-white rounded-2xl p-4 sm:p-5 border border-slate-200/80 shadow-xs text-center flex flex-col items-center hover:border-emerald-400 hover:shadow-xs transition">
