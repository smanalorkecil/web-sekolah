    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

<!-- Script Bersatu: Animasi Counter Up, Slider Guru Auto-Glide, Scroll Reveal, Banner, Galeri, & Agenda -->
<script>
  const SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbyznE6zNM03r4D0GVTQ1AixI2DhOlodr6pvW2hTyX4xUi476zuZQvpnNTeQPb81Q8lTNw/exec';

  function ambilNilai(obj: any, daftarNamaKunci: string[]) {
    if (!obj || typeof obj !== 'object') return '';
    const keys = Object.keys(obj);
    for (const kunci of daftarNamaKunci) {
      if (obj[kunci] !== undefined && obj[kunci] !== null && String(obj[kunci]).trim() !== '') {
        return String(obj[kunci]).trim();
      }
      const kunciBersih = kunci.toLowerCase().replace(/[\s_-]/g, '');
      const keyCocok = keys.find((k) => k.toLowerCase().replace(/[\s_-]/g, '') === kunciBersih);
      if (keyCocok && obj[keyCocok] !== undefined && obj[keyCocok] !== null && String(obj[keyCocok]).trim() !== '') {
        return String(obj[keyCocok]).trim();
      }
    }
    return '';
  }

  // ==========================================
  // 1. ANIMASI SCROLL REVEAL (EFEK MUNCUL HALUS)
  // ==========================================
  const revealSections = document.querySelectorAll('.reveal-section');
  const revealObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-revealed');
        // Jika section yang muncul adalah counter statistik, jalankan animasi angka bertambah!
        if (entry.target.id === 'counterSection') {
          jalankanAnimasiCounter();
        }
      }
    });
  }, { threshold: 0.15 });

  revealSections.forEach((section) => revealObserver.observe(section));

  // ==========================================
  // 2. ANIMASI COUNTING UP STATISTIK (DARI 0 KE TARGET)
  // ==========================================
  let counterStarted = false;
  function jalankanAnimasiCounter() {
    if (counterStarted) return;
    counterStarted = true;

    const counters = document.querySelectorAll<HTMLElement>('.stat-counter');
    const durasi = 2000; // 2 detik durasi animasi

    counters.forEach((counter) => {
      const target = parseInt(counter.getAttribute('data-target') || '0', 10);
      const suffix = counter.getAttribute('data-suffix') || '';
      const isYear = counter.getAttribute('data-is-year') === 'true';
      const startTime = performance.now();

      function updateNumber(now: number) {
        const elapsed = now - startTime;
        const progress = Math.min(elapsed / durasi, 1);
        
        // Easing cubic-out agar pelan di akhir
        const easeOut = 1 - Math.pow(1 - progress, 3);
        const current = Math.floor(easeOut * target);

        if (isYear) {
          // Tahun tidak pakai pemisah ribuan
          counter.textContent = current.toString() + suffix;
        } else {
          counter.textContent = current.toLocaleString('id-ID') + suffix;
        }

        if (progress < 1) {
          requestAnimationFrame(updateNumber);
        } else {
          counter.textContent = (isYear ? target.toString() : target.toLocaleString('id-ID')) + suffix;
        }
      }

      requestAnimationFrame(updateNumber);
    });
  }

  // ==========================================
  // 3. KONTROL SLIDER BANNER DENGAN ZOOM OTOMATIS
  // ==========================================
  let currentIndex = 0;
  const slides = document.querySelectorAll<HTMLElement>('.slide-banner');
  const dots = document.querySelectorAll<HTMLElement>('.dot-slider');
  const totalSlides = slides.length;
  let bannerTimer: any;

  function goToSlide(targetIndex: number) {
    if (slides.length === 0) return;
    
    slides[currentIndex]?.classList.remove('opacity-100', 'z-10', 'is-active');
    slides[currentIndex]?.classList.add('opacity-0', 'z-0', 'pointer-events-none');
    dots[currentIndex]?.classList.remove('bg-amber-400', 'w-8');
    dots[currentIndex]?.classList.add('bg-white/40', 'w-2');

    currentIndex = (targetIndex + totalSlides) % totalSlides;

    slides[currentIndex]?.classList.remove('opacity-0', 'z-0', 'pointer-events-none');
    slides[currentIndex]?.classList.add('opacity-100', 'z-10', 'is-active');
    dots[currentIndex]?.classList.remove('bg-white/40', 'w-2');
    dots[currentIndex]?.classList.add('bg-amber-400', 'w-8');
  }

  function startBannerTimer() {
    bannerTimer = setInterval(() => {
      goToSlide(currentIndex + 1);
    }, 6500);
  }

  function resetBannerTimer() {
    clearInterval(bannerTimer);
    startBannerTimer();
  }

  document.getElementById('btnNextSlide')?.addEventListener('click', () => {
    goToSlide(currentIndex + 1);
    resetBannerTimer();
  });

  document.getElementById('btnPrevSlide')?.addEventListener('click', () => {
    goToSlide(currentIndex - 1);
    resetBannerTimer();
  });

  dots.forEach((dot) => {
    dot.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLElement;
      const idx = parseInt(target.getAttribute('data-slide') || '0', 10);
      goToSlide(idx);
      resetBannerTimer();
    });
  });

  startBannerTimer();

  // ==========================================
  // 4. SLIDER DAFTAR GURU: AUTO-GLIDE (GESER OTOMATIS)
  // ==========================================
  const homeGuruTrack = document.getElementById('homeGuruTrack');
  const btnGuruPrev = document.getElementById('btnSliderGuruPrev');
  const btnGuruNext = document.getElementById('btnSliderGuruNext');
  let autoScrollGuruTimer: any = null;

  function geserGuruOtomatis() {
    if (!homeGuruTrack) return;
    const maxScroll = homeGuruTrack.scrollWidth - homeGuruTrack.clientWidth;
    // Jika sudah di ujung kanan, balik ke awal dengan mulus
    if (homeGuruTrack.scrollLeft >= maxScroll - 15) {
      homeGuruTrack.scrollTo({ left: 0, behavior: 'smooth' });
    } else {
      homeGuruTrack.scrollBy({ left: 260, behavior: 'smooth' });
    }
  }

  function mulaiAutoScrollGuru() {
    hentikanAutoScrollGuru();
    autoScrollGuruTimer = setInterval(geserGuruOtomatis, 3500);
  }

  function hentikanAutoScrollGuru() {
    if (autoScrollGuruTimer) clearInterval(autoScrollGuruTimer);
  }

  if (homeGuruTrack) {
    // Berhenti geser otomatis saat pointer mouse atau sentuhan berada di atas slider
    homeGuruTrack.addEventListener('mouseenter', hentikanAutoScrollGuru);
    homeGuruTrack.addEventListener('mouseleave', mulaiAutoScrollGuru);
    homeGuruTrack.addEventListener('touchstart', hentikanAutoScrollGuru, { passive: true });
    homeGuruTrack.addEventListener('touchend', mulaiAutoScrollGuru, { passive: true });
  }

  if (btnGuruPrev && homeGuruTrack) {
    btnGuruPrev.addEventListener('click', () => {
      homeGuruTrack.scrollBy({ left: -260, behavior: 'smooth' });
      hentikanAutoScrollGuru();
      mulaiAutoScrollGuru();
    });
  }
  if (btnGuruNext && homeGuruTrack) {
    btnGuruNext.addEventListener('click', () => {
      homeGuruTrack.scrollBy({ left: 260, behavior: 'smooth' });
      hentikanAutoScrollGuru();
      mulaiAutoScrollGuru();
    });
  }

  if (homeGuruTrack) {
    fetch(SCRIPT_URL + '?tab=Guru')
      .then((res) => res.json())
      .then((data) => {
        if (Array.isArray(data) && data.length > 0) {
          homeGuruTrack.innerHTML = '';

          data.forEach((guru) => {
            const card = document.createElement('div');
            card.className = 'w-52 sm:w-60 flex-shrink-0 aspect-[3/4] rounded-2xl overflow-hidden relative shadow-md bg-slate-900 snap-start group select-none hover:shadow-2xl transition duration-500';

            const nama = ambilNilai(guru, ['NamaLengkap', 'Nama Lengkap', 'namalengkap', 'Nama', 'nama']) || 'Nama Guru';
            const tugas = ambilNilai(guru, ['TugasTambaha', 'TugasTambahan', 'Tugas Tambahan', 'tugastambahan', 'tugas']);
            const mapel = ambilNilai(guru, ['Mapel', 'mapel', 'Mata Pelajaran', 'matapelajaran']);
            const jabatan = ambilNilai(guru, ['Jabatan', 'jabatan']);

            let baris1 = '';
            let baris2 = '';
            const teksMapel = (mapel && mapel !== '-') 
              ? (mapel.toLowerCase().startsWith('guru') ? mapel : `Guru ${mapel}`) 
              : '';

            if (tugas && tugas !== '-') {
              baris1 = tugas;
              baris2 = teksMapel || 'Tenaga Pendidik';
            } else {
              baris1 = teksMapel || (jabatan && jabatan !== '-' ? jabatan : 'Guru Mata Pelajaran');
              baris2 = 'Tenaga Pendidik';
            }

            let foto = ambilNilai(guru, ['Foto', 'foto', 'avatar', 'image']);
            if (foto && foto.includes('drive.google.com')) {
              const fileIdMatch = foto.match(/\/d\/([a-zA-Z0-9_-]+)/) || foto.match(/id=([a-zA-Z0-9_-]+)/);
              if (fileIdMatch && fileIdMatch[1]) {
                foto = `https://lh3.googleusercontent.com/u/0/d/${fileIdMatch[1]}`;
              }
            }

            const inisial = nama !== 'Nama Guru' ? nama.charAt(0) : 'G';
            const imageHtml = foto 
              ? `<img src="${foto}" alt="${nama}" class="w-full h-full object-cover object-top group-hover:scale-108 transition duration-700 ease-out" loading="lazy" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" /><div class="w-full h-full bg-gradient-to-b from-slate-800 to-slate-950 hidden items-center justify-center text-slate-600 font-black text-6xl">${inisial}</div>`
              : `<div class="w-full h-full bg-gradient-to-b from-slate-800 to-slate-950 flex items-center justify-center text-slate-600 font-black text-6xl">${inisial}</div>`;

            card.innerHTML = `
              ${imageHtml}
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/70 to-transparent flex flex-col justify-end p-4 text-left">
                <h4 class="font-bold text-amber-400 text-sm sm:text-base leading-snug line-clamp-2 group-hover:text-amber-300 transition">
                  ${nama}
                </h4>
                <p class="text-xs text-white mt-1.5 line-clamp-1 font-semibold">
                  ${baris1}
                </p>
                <p class="text-[11px] text-slate-300 mt-0.5 line-clamp-1 font-medium">
                  ${baris2}
                </p>
              </div>
            `;

            homeGuruTrack.appendChild(card);
          });

          // Mulai geser otomatis setelah kartu selesai di-render
          mulaiAutoScrollGuru();
        }
      })
      .catch((err) => {
        console.error('Gagal memuat data guru di beranda:', err);
      });
  }

  // ==========================================
  // 5. PREVIEW GALERI KEGIATAN (REALTIME DRIVE)
  // ==========================================
  const homeGaleriGrid = document.getElementById('homeGaleriGrid');
  if (homeGaleriGrid) {
    fetch(SCRIPT_URL + '?tab=galeri')
      .then((res) => res.json())
      .then((data) => {
        if (Array.isArray(data) && data.length > 0) {
          homeGaleriGrid.innerHTML = '';
          const previewAlbum = data.slice(0, 4);

          previewAlbum.forEach((album) => {
            let imgCover = album.fotoSampul || album.cover || '';
            if (!imgCover && Array.isArray(album.foto) && album.foto.length > 0) {
              imgCover = typeof album.foto[0] === 'string' ? album.foto[0] : (album.foto[0].thumbnail || album.foto[0].url);
            }
            if (!imgCover) imgCover = '/logo.png';

            const jumlah = album.totalFoto || album.jumlahFoto || (album.foto ? album.foto.length : 0);

            const item = document.createElement('a');
            item.href = '/galeri';
            item.className = 'group relative rounded-2xl overflow-hidden aspect-square bg-slate-900 block shadow-xs hover:shadow-xl transition-all duration-300 hover:-translate-y-1';
            
            item.innerHTML = `
              <img 
                src="${imgCover}" 
                alt="${album.judul}" 
                class="w-full h-full object-cover group-hover:scale-110 transition duration-700 ease-out" 
                loading="lazy" 
                referrerpolicy="no-referrer"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950/85 via-slate-950/20 to-transparent opacity-0 group-hover:opacity-100 transition duration-300 flex flex-col justify-end p-3.5 text-left">
                <span class="text-[10px] font-bold text-amber-300 bg-emerald-950/80 px-2 py-0.5 rounded-md w-fit mb-1">
                  📷 ${jumlah} Foto
                </span>
                <h4 class="text-white text-xs font-bold line-clamp-2 leading-snug">
                  ${album.judul}
                </h4>
              </div>
            `;
            homeGaleriGrid.appendChild(item);
          });
        }
      })
      .catch((err) => {
        console.error('Gagal memuat galeri beranda:', err);
      });
  }

  // ==========================================
  // 6. AGENDA & PENGUMUMAN DARI SPREADSHEET
  // ==========================================
  const agendaLoading = document.getElementById('berandaAgendaLoading')!;
  const agendaList = document.getElementById('berandaAgendaList')!;
  const agendaEmpty = document.getElementById('berandaAgendaEmpty')!;

  const bulanIndo: { [key: string]: number } = {
    jan: 0, januari: 0, feb: 1, februari: 1, mar: 2, maret: 2,
    apr: 3, april: 3, mei: 4, jun: 5, juni: 5, jul: 6, juli: 6,
    agu: 7, ags: 7, agustus: 7, sep: 8, september: 8, okt: 9, oktober: 9,
    nov: 10, november: 10, des: 11, desember: 11
  };
  const namaBulanSingkat = ['JAN', 'FEB', 'MAR', 'APR', 'MEI', 'JUN', 'JUL', 'AGU', 'SEP', 'OKT', 'NOV', 'DES'];

  function parseTanggalInfo(teksTgl: string) {
    let tglAngka = '--';
    let blnSingkat = 'INFO';
    let timestamp = 0;

    if (!teksTgl) return { tglAngka, blnSingkat, timestamp };

    const parts = teksTgl.trim().toLowerCase().split(/[\s,/-]+/);
    if (parts.length >= 3) {
      let d = parseInt(parts[0], 10);
      let mKey = parts[1];
      let y = parseInt(parts[2], 10);

      if (parts[0].length === 4) {
        y = parseInt(parts[0], 10);
        mKey = parts[1];
        d = parseInt(parts[2], 10);
      }

      let mIdx = bulanIndo[mKey];
      if (mIdx === undefined) mIdx = parseInt(mKey, 10) - 1;

      if (!isNaN(d) && mIdx >= 0 && !isNaN(y)) {
        tglAngka = String(d).padStart(2, '0');
        blnSingkat = namaBulanSingkat[mIdx] || 'INFO';
        timestamp = new Date(y, mIdx, d).getTime();
        return { tglAngka, blnSingkat, timestamp };
      }
    }

    const fallbackDate = new Date(teksTgl);
    if (!isNaN(fallbackDate.getTime())) {
      tglAngka = String(fallbackDate.getDate()).padStart(2, '0');
      blnSingkat = namaBulanSingkat[fallbackDate.getMonth()] || 'INFO';
      timestamp = fallbackDate.getTime();
    }

    return { tglAngka, blnSingkat, timestamp };
  }

  fetch(SCRIPT_URL + '?tab=Pengumuman')
    .then((res) => res.json())
    .then((data) => {
      agendaLoading.classList.add('hidden');

      if (Array.isArray(data) && data.length > 0) {
        agendaList.classList.remove('hidden');
        agendaList.innerHTML = '';

        data.sort((a, b) => {
          const tglA = parseTanggalInfo(ambilNilai(a, ['Tanggal', 'tgl'])).timestamp;
          const tglB = parseTanggalInfo(ambilNilai(b, ['Tanggal', 'tgl'])).timestamp;
          return tglB - tglA;
        });

        const daftarTampil = data.slice(0, 4);

        daftarTampil.forEach((item) => {
          const rawTanggal = ambilNilai(item, ['Tanggal', 'tgl']);
          const { tglAngka, blnSingkat } = parseTanggalInfo(rawTanggal);
          const judul = ambilNilai(item, ['Judul', 'Perihal', 'Pengumuman']) || 'Pengumuman';
          const nomor = ambilNilai(item, ['NomorSurat', 'Nomor', 'no']);
          const linkLampiran = ambilNilai(item, ['LinkLampiran', 'Lampiran', 'Link']);

          const card = document.createElement('a');
          card.href = linkLampiran || '/pengumuman';
          if (linkLampiran) {
            card.target = '_blank';
            card.rel = 'noopener noreferrer';
          }
          card.className = 'bg-white rounded-2xl p-3 border border-slate-100 shadow-2xs hover:shadow-md hover:border-emerald-200 transition-all duration-300 flex items-center gap-3.5 group hover:-translate-y-0.5';

          card.innerHTML = `
            <div class="w-12 h-12 rounded-xl bg-emerald-800 text-white flex flex-col items-center justify-center flex-shrink-0 group-hover:bg-emerald-700 transition">
              <span class="text-base font-black leading-none">${tglAngka}</span>
              <span class="text-[9px] uppercase font-bold tracking-wider leading-tight mt-0.5 text-amber-300">
                ${blnSingkat}
              </span>
            </div>
            <div class="flex-1 min-w-0">
              <h4 class="font-bold text-xs sm:text-sm text-slate-800 group-hover:text-emerald-700 transition line-clamp-2 leading-snug">
                ${judul}
              </h4>
              <p class="text-[11px] text-slate-400 mt-0.5 truncate">
                ${nomor ? 'No: ' + nomor : (rawTanggal ? '📅 ' + rawTanggal : 'Pemberitahuan Resmi')}
              </p>
            </div>
          `;

          agendaList.appendChild(card);
        });
      } else {
        agendaEmpty.classList.remove('hidden');
      }
    })
    .catch((err) => {
      console.error('Gagal sinkron agenda beranda:', err);
      agendaLoading.innerHTML = '<p class="text-xs text-rose-500 text-center py-4">Gagal memuat agenda.</p>';
    });
</script>