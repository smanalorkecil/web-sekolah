---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

let pengumumanList: any[] = [];
try {
  const semua = (await getCollection('berita')) || [];
  pengumumanList = semua
    .filter((item) => item.data?.category?.toLowerCase() === 'pengumuman')
    .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
} catch (e) {
  pengumumanList = [];
}

// Data Pengumuman Cadangan (Jika belum ada entri di Decap CMS)
const fallbackPengumuman = [
  {
    nomor: "421.3/084/SMAN-AK/IX/2026",
    judul: "Jadwal Pelaksanaan Asesmen Sumatif Tengah Semester (ASTS) Ganjil 2026/2027",
    tanggal: "15 September 2026",
    lampiran: true
  },
  {
    nomor: "421.3/072/SMAN-AK/VIII/2026",
    judul: "Pemberitahuan Aktivasi Rekening SimPel Program Indonesia Pintar (PIP) Tahap II",
    tanggal: "28 Agustus 2026",
    lampiran: false
  },
  {
    nomor: "421.3/065/SMAN-AK/VII/2026",
    judul: "Ketentuan Seragam dan Jadwal Masuk Pembelajaran Semester Ganjil",
    tanggal: "12 Juli 2026",
    lampiran: true
  }
];
---

<Layout title="Pengumuman Resmi - SMA Negeri Alor Kecil">
  <main class="max-w-5xl mx-auto px-4 sm:px-6 py-12">
    <!-- Header Halaman -->
    <div class="text-center max-w-xl mx-auto mb-12">
      <span class="text-xs font-black text-emerald-700 uppercase tracking-widest">Papan Informasi</span>
      <h1 class="text-3xl sm:text-4xl font-black text-slate-900 mt-1">Pengumuman Resmi Sekolah</h1>
      <p class="text-slate-500 text-xs sm:text-sm mt-2">
        Surat edaran kedinasan, agenda sekolah, dan pemberitahuan penting untuk civitas akademika.
      </p>
    </div>

    <!-- Papan Pengumuman -->
    {pengumumanList.length > 0 ? (
      <div class="space-y-4 mb-10">
        {pengumumanList.map((item) => {
          const slug = item.slug || item.id?.replace(/\.md$/, '') || '';
          const tgl = item.data?.date 
            ? new Date(item.data.date).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })
            : '-';

          return (
            <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-xs hover:border-emerald-500 transition flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <div>
                <div class="flex items-center gap-2 mb-2">
                  <span class="bg-amber-100 text-amber-900 font-black text-[10px] px-2.5 py-0.5 rounded-md uppercase">
                    Pengumuman Resmi
                  </span>
                  <span class="text-xs text-slate-400 font-mono">{tgl}</span>
                </div>
                <h2 class="text-base font-bold text-slate-900 hover:text-emerald-700 transition">
                  <a href={`/berita/${slug}`}>{item.data.title}</a>
                </h2>
                <p class="text-xs text-slate-500 mt-1 line-clamp-2">{item.data.description}</p>
              </div>

              <a 
                href={`/berita/${slug}`} 
                class="bg-emerald-50 text-emerald-800 hover:bg-emerald-700 hover:text-white font-bold px-4 py-2 rounded-xl text-xs transition self-start sm:self-center flex-shrink-0"
              >
                Baca Edaran &rarr;
              </a>
            </div>
          );
        })}
      </div>
    ) : (
      <div class="bg-white rounded-3xl border border-slate-200/80 shadow-xs overflow-hidden mb-10">
        <div class="bg-emerald-900 text-white p-5 flex items-center justify-between">
          <div class="flex items-center gap-3">
            <span class="text-2xl">📢</span>
            <div>
              <h2 class="font-bold text-sm">Papan Edaran & Maklumat Terkini</h2>
              <p class="text-[11px] text-emerald-200">Diterbitkan oleh Tata Usaha & Humas SMA Negeri Alor Kecil</p>
            </div>
          </div>
        </div>

        <div class="divide-y divide-slate-100">
          {fallbackPengumuman.map((item) => (
            <div class="p-6 hover:bg-slate-50 transition flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <div>
                <span class="text-[11px] font-mono text-emerald-700 font-bold block mb-1">
                  Nomor: {item.nomor}
                </span>
                <h3 class="text-sm sm:text-base font-bold text-slate-900 leading-snug">
                  {item.judul}
                </h3>
                <span class="text-xs text-slate-400 mt-1 block">🕒 Tanggal: {item.tanggal}</span>
              </div>

              <div class="flex items-center gap-2 self-start sm:self-center">
                {item.lampiran && (
                  <span class="text-[11px] font-semibold bg-amber-50 text-amber-800 px-3 py-1 rounded-lg border border-amber-200">
                    📎 Ada Lampiran
                  </span>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- Layanan Informasi -->
    <div class="bg-emerald-50 rounded-2xl p-6 border border-emerald-100 text-xs text-emerald-900 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div>
        <h4 class="font-bold text-sm mb-1">Butuh Salinan Surat Fisik?</h4>
        <p class="text-emerald-800/80">Silakan kunjungi Ruang Tata Usaha (TU) SMAN Alor Kecil pada jam kerja (07.15 – 14.00 WITA).</p>
      </div>
      <a href="https://wa.me/6281234567890" target="_blank" class="bg-emerald-800 hover:bg-emerald-700 text-white font-bold px-4 py-2.5 rounded-xl transition flex-shrink-0">
        Hubungi Staf TU
      </a>
    </div>
  </main>
</Layout>