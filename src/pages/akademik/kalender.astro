---
import Layout from '../../layouts/Layout.astro';

const agendaSemester = [
  { tanggal: "14 Juli 2026", kegiatan: "Hari Pertama Masuk Sekolah & Pembukaan MPLS", kategori: "Awal Semester" },
  { tanggal: "17 – 19 Agustus 2026", kegiatan: "Peringatan HUT Kemerdekaan RI ke-81", kategori: "Hari Besar" },
  { tanggal: "21 – 26 September 2026", kegiatan: "Asesmen Sumatif Tengah Semester (ASTS) Ganjil", kategori: "Ujian" },
  { tanggal: "23 – 28 November 2026", kegiatan: "Asesmen Sumatif Akhir Semester (ASAS) Ganjil", kategori: "Ujian" },
  { tanggal: "18 Desember 2026", kegiatan: "Pembagian Laporan Hasil Belajar (Rapor Semester Ganjil)", kategori: "Akademik" },
  { tanggal: "21 – 31 Desember 2026", kegiatan: "Libur Akhir Semester Ganjil", kategori: "Libur" }
];
---

<Layout title="Kalender Pendidikan - SMAN Alor Kecil">
    <main class="max-w-5xl mx-auto px-4 py-12">
      <div class="text-center max-w-xl mx-auto mb-10">
        <span class="text-xs font-bold text-emerald-700 uppercase tracking-widest">Tahun Ajaran 2026/2027</span>
        <h1 class="text-2xl sm:text-3xl font-black text-slate-900 mt-1">Kalender Akademik Sekolah</h1>
        <p class="text-slate-500 text-xs sm:text-sm mt-2">Jadwal kegiatan belajar mengajar, pelaksanaan asesmen, dan libur semester.</p>
      </div>

      <!-- Tabel Agenda Kaldik -->
      <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden mb-8">
        <div class="p-4 sm:p-6 bg-emerald-900 text-white flex flex-col sm:flex-row justify-between sm:items-center gap-3">
          <div>
            <h2 class="font-bold text-base">Semester Ganjil 2026/2027</h2>
            <p class="text-xs text-emerald-200">Ditetapkan berdasarkan pedoman Dinas Pendidikan Provinsi NTT</p>
          </div>
          <button class="bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold px-4 py-2 rounded-xl text-xs transition self-start sm:self-auto">
            Unduh Kaldik (PDF)
          </button>
        </div>

        <div class="divide-y divide-slate-100">
          {agendaSemester.map((item) => (
            <div class="p-4 sm:p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-2 hover:bg-slate-50/80 transition">
              <div>
                <span class="text-xs font-bold text-emerald-700 block sm:inline-block sm:w-44">{item.tanggal}</span>
                <span class="text-sm font-semibold text-slate-900">{item.kegiatan}</span>
              </div>
              <span class="w-fit text-[11px] font-bold px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-600">
                {item.kategori}
              </span>
            </div>
          ))}
        </div>
      </div>
    </main>
</Layout>