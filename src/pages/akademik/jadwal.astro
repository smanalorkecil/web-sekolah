---
import Layout from '../../layouts/Layout.astro';

const jamKBM = [
  { jamKe: "0", waktu: "07.15 – 07.30", kegiatan: "Apel Pagi / Literasi & Doa Bersama" },
  { jamKe: "1 – 2", waktu: "07.30 – 08.50", kegiatan: "Kegiatan Belajar Mengajar (KBM)" },
  { jamKe: "3 – 4", waktu: "08.50 – 10.10", kegiatan: "Kegiatan Belajar Mengajar (KBM)" },
  { jamKe: "-", waktu: "10.10 – 10.30", kegiatan: "Istirahat I" },
  { jamKe: "5 – 6", waktu: "10.30 – 11.50", kegiatan: "Kegiatan Belajar Mengajar (KBM)" },
  { jamKe: "7", waktu: "11.50 – 12.30", kegiatan: "Kegiatan Belajar Mengajar (KBM)" },
  { jamKe: "-", waktu: "12.30 – 13.00", kegiatan: "Istirahat II / Ibadah Siang" },
  { jamKe: "8 – 9", waktu: "13.00 – 14.20", kegiatan: "Kegiatan Belajar Mengajar (KBM)" }
];
---

<Layout title="Jadwal Pembelajaran - SMA Negeri Alor Kecil">
  <main class="max-w-5xl mx-auto px-4 py-12">
    <div class="text-center max-w-xl mx-auto mb-10">
      <span class="text-xs font-bold text-emerald-700 uppercase tracking-widest">Jam Operasional Belajar</span>
      <h1 class="text-2xl sm:text-3xl font-black text-slate-900 mt-1">Alokasi Waktu KBM</h1>
      <p class="text-slate-500 text-xs sm:text-sm mt-2">Ketentuan jam belajar harian tatap muka untuk seluruh jenjang kelas X, XI, dan XII.</p>
    </div>

    <!-- Tabel Waktu KBM -->
    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden mb-10">
      <table class="w-full text-left text-xs sm:text-sm">
        <thead class="bg-emerald-900 text-white font-bold text-xs uppercase tracking-wider">
          <tr>
            <th class="p-4 text-center w-24">Jam Ke</th>
            <th class="p-4 w-40">Waktu (WITA)</th>
            <th class="p-4">Aktivitas / Kegiatan</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          {jamKBM.map((baris) => (
            <tr class={baris.jamKe === '-' ? 'bg-amber-50/70 font-semibold text-amber-900' : 'hover:bg-slate-50/80'}>
              <td class="p-4 text-center font-bold">{baris.jamKe}</td>
              <td class="p-4 font-mono text-xs">{baris.waktu}</td>
              <td class="p-4">{baris.kegiatan}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </main>
</Layout>