---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = (await getCollection('berita')) || [];
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: { post, allPosts: posts },
  }));
}

const { post, allPosts } = Astro.props;
const { Content } = await render(post);

// Filter berita terkini untuk sidebar (selain berita yang sedang dibaca)
const beritaTerkini = allPosts
  .filter((p) => p.id !== post.id)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 4);

const tanggalRilis = post.data?.date 
  ? new Date(post.data.date).toLocaleDateString('id-ID', { 
      weekday: 'long', 
      day: 'numeric', 
      month: 'long', 
      year: 'numeric',
    })
  : '-';

const jamRilis = post.data?.date 
  ? new Date(post.data.date).toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }) + ' WITA'
  : '';

// Pengaturan posisi fokus gambar thumbnail
const posisiFoto = post.data?.thumbnail_pos === 'center' 
  ? 'object-center' 
  : post.data?.thumbnail_pos === 'bottom' 
  ? 'object-bottom' 
  : 'object-top';

// Inisial avatar penulis
const namaPenulis = post.data?.author || 'Tim Jurnalistik SMAN Alor Kecil';
const inisialPenulis = namaPenulis
  .split(' ')
  .slice(0, 2)
  .map((kata: string) => kata[0])
  .join('')
  .toUpperCase();

const urlLengkap = Astro.url.href;
---

<Layout 
  title={`${post.data.title} - Warta SMAN Alor Kecil`}
  description={post.data.description}
  image={post.data.thumbnail}
>
  <div class="bg-slate-50 border-b border-slate-200/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
      <!-- 1. BREADCRUMB -->
      <nav class="flex items-center gap-2 text-xs text-slate-500 font-medium">
        <a href="/" class="hover:text-emerald-700 transition">Beranda</a>
        <span>/</span>
        <a href="/berita" class="hover:text-emerald-700 transition">Berita</a>
        <span>/</span>
        <span class="text-emerald-800 font-bold uppercase">{post.data.category || 'Warta'}</span>
      </nav>
    </div>
  </div>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
      
      <!-- ==================== KOLOM UTAMA (ARTIKEL) ==================== -->
      <div class="lg:col-span-8">
        <article class="bg-white rounded-3xl p-6 sm:p-10 border border-slate-200/80 shadow-xs">
          
          <!-- Kategori & Judul Headline -->
          <div class="mb-4">
            <span class="inline-block bg-emerald-100 text-emerald-800 text-[11px] font-black px-3 py-1 rounded-md uppercase tracking-wider mb-3">
              {post.data.category || 'Warta Sekolah'}
            </span>
            <h1 class="text-2xl sm:text-4xl lg:text-[38px] font-black text-slate-900 leading-tight tracking-tight">
              {post.data.title}
            </h1>
          </div>

          <!-- Ringkasan / Lead Paragraph Khas Berita -->
          {post.data.description && (
            <p class="text-slate-600 text-sm sm:text-base font-medium leading-relaxed mb-6 border-l-4 border-emerald-600 pl-4 py-1.5 bg-slate-50/70 rounded-r-xl">
              {post.data.description}
            </p>
          )}

          <!-- Info Redaksi & Waktu Publikasi -->
          <div class="py-4 border-y border-slate-100 flex flex-wrap items-center justify-between gap-4 mb-8">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-emerald-900 text-amber-300 font-black text-xs flex items-center justify-center shadow-xs">
                {inisialPenulis}
              </div>
              <div>
                <span class="block text-xs font-bold text-slate-900">{namaPenulis}</span>
                <span class="text-[11px] text-slate-400 font-medium">
                  {tanggalRilis} {jamRilis && `• ${jamRilis}`}
                </span>
              </div>
            </div>

            <!-- Tombol Bagikan (Share Bar) -->
            <div class="flex items-center gap-2">
              <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider hidden sm:inline">Bagikan:</span>
              
              <!-- WhatsApp -->
              <a 
                href={`https://api.whatsapp.com/send?text=${encodeURIComponent(post.data.title + '\n' + urlLengkap)}`} 
                target="_blank" 
                rel="noopener noreferrer"
                class="w-8 h-8 rounded-full bg-emerald-500 hover:bg-emerald-600 text-white flex items-center justify-center transition shadow-xs"
                title="Bagikan ke WhatsApp"
              >
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.275.072.376-.044c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.42-.099.825z"/></svg>
              </a>

              <!-- Facebook -->
              <a 
                href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(urlLengkap)}`} 
                target="_blank" 
                rel="noopener noreferrer"
                class="w-8 h-8 rounded-full bg-blue-600 hover:bg-blue-700 text-white flex items-center justify-center transition shadow-xs"
                title="Bagikan ke Facebook"
              >
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M9 8H6v4h3v12h5V12h3.642L18 8h-4V6.333C14 5.374 14.5 5 15.667 5H18V0h-3.808C10.595 0 9 1.583 9 4.615V8z"/></svg>
              </a>

              <!-- Salin Tautan -->
              <button 
                id="btnCopyLink" 
                class="w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-700 flex items-center justify-center transition shadow-xs"
                title="Salin Tautan Berita"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
              </button>
            </div>
          </div>

          <!-- Gambar Utama + Kredit Foto -->
          {post.data.thumbnail && (
            <figure class="mb-8">
              <div class="rounded-2xl overflow-hidden shadow-sm bg-slate-900 flex items-center justify-center">
                <img 
                  src={post.data.thumbnail} 
                  alt={post.data.title} 
                  class={`w-full max-h-[520px] object-cover ${posisiFoto} rounded-2xl`}
                  loading="eager"
                />
              </div>
              <figcaption class="text-[11px] text-slate-400 mt-2.5 flex items-center gap-1.5 italic font-mono">
                <span>📷</span> Foto: {post.data.photographer || 'Dokumentasi Sekolah'}
              </figcaption>
            </figure>
          )}

          <!-- Isi Lengkap Berita (Prose Editor) -->
          <div 
            id="article-content" 
            class="prose prose-slate prose-emerald prose-headings:font-black prose-p:leading-relaxed prose-img:rounded-2xl prose-img:mx-auto max-w-none text-slate-800 text-base sm:text-lg"
          >
            <Content />
          </div>

          <!-- Dokumentasi Tambahan (Jika Ada Lampiran Galeri di CMS) -->
          {post.data.gallery && post.data.gallery.length > 0 && (
            <section class="mt-12 pt-8 border-t border-slate-100">
              <h3 class="text-base sm:text-lg font-black text-slate-900 mb-4 flex items-center gap-2">
                <span>📷</span> Dokumentasi Terkait
              </h3>
              <div class="grid grid-cols-2 sm:grid-cols-3 gap-3.5 sm:gap-4">
                {post.data.gallery.map((item: any) => (
                  <div class="space-y-1.5">
                    <div class="aspect-square rounded-2xl overflow-hidden bg-slate-900 shadow-xs border border-slate-200/80">
                      <img 
                        src={item.image} 
                        alt={item.caption || post.data.title} 
                        class="w-full h-full object-cover object-center hover:scale-105 transition duration-500" 
                        loading="lazy"
                      />
                    </div>
                    {item.caption && (
                      <p class="text-[11px] text-slate-500 italic text-center leading-snug">
                        {item.caption}
                      </p>
                    )}
                  </div>
                ))}
              </div>
            </section>
          )}

          <!-- Wadah Navigasi Paginasi Halaman (Otomatis jika artikel berisi pembatas ---) -->
          <div id="pagination-wrapper" class="hidden mt-10 pt-6 border-t border-slate-100">
            <div class="flex flex-col sm:flex-row items-center justify-between gap-4 bg-slate-50 p-4 rounded-2xl border border-slate-200/70">
              <span class="text-xs font-bold text-slate-600">
                Halaman <span id="current-page-num" class="text-emerald-700 font-extrabold">1</span> dari <span id="total-pages-num">1</span>
              </span>

              <div id="pagination-buttons" class="flex items-center gap-1.5 flex-wrap"></div>
            </div>
          </div>

          <!-- Tag & Catatan Redaksi Bawah -->
          <div class="mt-12 pt-6 border-t border-slate-100">
            <div class="flex flex-wrap items-center gap-2 mb-6">
              <span class="text-xs font-bold text-slate-400">Topik Terkait:</span>
              <span class="bg-slate-100 text-slate-700 text-xs font-semibold px-3 py-1 rounded-lg">#SMANAlorKecil</span>
              <span class="bg-slate-100 text-slate-700 text-xs font-semibold px-3 py-1 rounded-lg">#{post.data.category || 'Pendidikan'}</span>
              <span class="bg-slate-100 text-slate-700 text-xs font-semibold px-3 py-1 rounded-lg">#AlorBaratLaut</span>
            </div>

            <!-- Kotak Penutup Redaksi -->
            <div class="bg-emerald-50/60 rounded-2xl p-5 border border-emerald-100 flex items-center justify-between text-xs text-slate-600">
              <div>
                <p class="font-bold text-emerald-950">Redaksi & Publikasi SMAN Alor Kecil</p>
                <p class="text-[11px] text-slate-500 mt-0.5">Menerima rilis kegiatan kesiswaan, kejuaraan, liputan ekskul, dan karya sastra siswa.</p>
              </div>
              <a href="/berita" class="font-bold text-emerald-700 hover:underline flex-shrink-0">
                &larr; Indeks Berita
              </a>
            </div>
          </div>

        </article>
      </div>

      <!-- ==================== KOLOM KANAN (SIDEBAR) ==================== -->
      <aside class="lg:col-span-4 space-y-8">
        
        <!-- Widget 1: Berita Terkini Lainnya -->
        <div class="bg-white rounded-3xl p-6 border border-slate-200/80 shadow-xs">
          <div class="flex items-center gap-2 pb-3 mb-5 border-b border-slate-100">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-600"></span>
            <h3 class="font-black text-sm uppercase tracking-wider text-slate-900">Kabar Terkini</h3>
          </div>

          {beritaTerkini.length === 0 ? (
            <p class="text-xs text-slate-400 py-4 text-center">Belum ada warta lainnya.</p>
          ) : (
            <div class="space-y-4">
              {beritaTerkini.map((item, index) => {
                const slugLain = item.id.replace(/\.md$/, '');
                const tglLain = item.data?.date 
                  ? new Date(item.data.date).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' })
                  : '-';

                return (
                  <article class="flex items-start gap-3.5 group pb-4 border-b border-slate-100 last:border-none last:pb-0">
                    <span class="font-black text-lg text-slate-300 group-hover:text-emerald-700 transition w-4">
                      {index + 1}
                    </span>
                    <div class="flex-1">
                      <span class="text-[10px] font-bold text-emerald-700 uppercase">{item.data?.category || 'Berita'}</span>
                      <h4 class="font-bold text-xs sm:text-sm text-slate-900 group-hover:text-emerald-700 transition leading-snug line-clamp-2 mt-0.5">
                        <a href={`/berita/${slugLain}`}>{item.data?.title}</a>
                      </h4>
                      <span class="text-[10px] text-slate-400 font-mono mt-1 block">{tglLain}</span>
                    </div>
                  </article>
                );
              })}
            </div>
          )}

          <a href="/berita" class="mt-5 block text-center py-2.5 rounded-xl bg-slate-50 hover:bg-emerald-50 text-emerald-800 text-xs font-bold transition">
            Buka Semua Berita &rarr;
          </a>
        </div>

        <!-- Widget 2: Papan Pengumuman Kilat -->
        <div class="bg-gradient-to-br from-emerald-950 to-emerald-900 text-white rounded-3xl p-6 shadow-md">
          <div class="flex items-center gap-2 mb-3">
            <span class="text-lg">📢</span>
            <h3 class="font-black text-xs uppercase tracking-widest text-amber-400">Papan Edaran</h3>
          </div>
          <p class="text-xs text-emerald-100 leading-relaxed mb-4">
            Informasi surat edaran resmi, jadwal asesmen, dan edaran beasiswa PIP dapat diakses pada laman pengumuman.
          </p>
          <a 
            href="/pengumuman" 
            class="inline-block w-full text-center bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold px-4 py-2.5 rounded-xl text-xs uppercase tracking-wider transition shadow-sm"
          >
            Lihat Pengumuman Resmi
          </a>
        </div>

        <!-- Widget 3: Layanan Kontak & Pengaduan -->
        <div class="bg-white rounded-3xl p-6 border border-slate-200/80 shadow-xs text-center">
          <span class="text-3xl mb-2 block">💬</span>
          <h4 class="font-bold text-sm text-slate-900">Layanan Informasi</h4>
          <p class="text-xs text-slate-500 mt-1">Ada pertanyaan mengenai berita atau agenda sekolah?</p>
          <a 
            href="/kontak" 
            class="mt-4 inline-flex items-center justify-center gap-2 w-full py-2.5 px-4 bg-emerald-700 hover:bg-emerald-800 text-white text-xs font-bold rounded-xl transition"
          >
            Hubungi Tata Usaha (TU)
          </a>
        </div>

      </aside>

    </div>
  </main>
</Layout>

<style>
  article :global(img[width]) {
    width: auto;
    max-width: 100%;
    height: auto;
    display: block;
    margin-left: auto;
    margin-right: auto;
  }
</style>

<!-- Script Gabungan: Salin Tautan & Paginasi Artikel Berita -->
<script>
  // 1. Salin Tautan Berita
  document.getElementById('btnCopyLink')?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(window.location.href);
      alert('Tautan berita berhasil disalin ke clipboard!');
    } catch (err) {
      prompt('Salin tautan berita ini:', window.location.href);
    }
  });

  // 2. Logika Paginasi Multi-Halaman Artikel
  function initPagination() {
    const article = document.getElementById('article-content');
    const paginationWrapper = document.getElementById('pagination-wrapper');
    const paginationButtons = document.getElementById('pagination-buttons');
    const currentPageNum = document.getElementById('current-page-num');
    const totalPagesNum = document.getElementById('total-pages-num');

    if (!article || !paginationWrapper || !paginationButtons) return;

    const elements = Array.from(article.children);
    const hasHr = elements.some((el) => el.tagName === 'HR');

    if (!hasHr) return;

    const pages = [];
    let currentPageElements = [];

    elements.forEach((el) => {
      if (el.tagName === 'HR') {
        if (currentPageElements.length > 0) {
          pages.push(currentPageElements);
          currentPageElements = [];
        }
      } else {
        currentPageElements.push(el);
      }
    });

    if (currentPageElements.length > 0) {
      pages.push(currentPageElements);
    }

    if (pages.length <= 1) return;

    article.innerHTML = '';
    const pageNodes = pages.map((pageEls, index) => {
      const pageDiv = document.createElement('div');
      pageDiv.className = `article-page ${index !== 0 ? 'hidden' : ''}`;
      pageEls.forEach((el) => pageDiv.appendChild(el));
      article.appendChild(pageDiv);
      return pageDiv;
    });

    paginationWrapper.classList.remove('hidden');
    if (totalPagesNum) totalPagesNum.textContent = pages.length.toString();

    let activeIndex = 0;

    function renderControls() {
      paginationButtons.innerHTML = '';

      // Tombol Prev
      const prevBtn = document.createElement('button');
      prevBtn.innerHTML = '&larr; Sebelumnya';
      prevBtn.className = `px-3 py-1.5 rounded-xl text-xs font-bold transition ${
        activeIndex === 0
          ? 'bg-slate-200 text-slate-400 cursor-not-allowed'
          : 'bg-white text-slate-700 hover:bg-emerald-50 hover:text-emerald-800 border border-slate-200 shadow-2xs'
      }`;
      prevBtn.disabled = activeIndex === 0;
      prevBtn.onclick = () => goTo(activeIndex - 1);
      paginationButtons.appendChild(prevBtn);

      // Tombol Nomor Halaman
      pages.forEach((_, idx) => {
        const numBtn = document.createElement('button');
        numBtn.textContent = (idx + 1).toString();
        numBtn.className = `w-8 h-8 rounded-xl text-xs font-bold transition ${
          idx === activeIndex
            ? 'bg-emerald-700 text-white shadow-2xs'
            : 'bg-white text-slate-700 hover:bg-emerald-50 hover:text-emerald-800 border border-slate-200 shadow-2xs'
        }`;
        numBtn.onclick = () => goTo(idx);
        paginationButtons.appendChild(numBtn);
      });

      // Tombol Next
      const nextBtn = document.createElement('button');
      nextBtn.innerHTML = 'Selanjutnya &rarr;';
      nextBtn.className = `px-3 py-1.5 rounded-xl text-xs font-bold transition ${
        activeIndex === pages.length - 1
          ? 'bg-slate-200 text-slate-400 cursor-not-allowed'
          : 'bg-white text-slate-700 hover:bg-emerald-50 hover:text-emerald-800 border border-slate-200 shadow-2xs'
      }`;
      nextBtn.disabled = activeIndex === pages.length - 1;
      nextBtn.onclick = () => goTo(activeIndex + 1);
      paginationButtons.appendChild(nextBtn);
    }

    function goTo(index) {
      if (index < 0 || index >= pages.length) return;
      activeIndex = index;

      pageNodes.forEach((node, idx) => {
        if (idx === index) {
          node.classList.remove('hidden');
        } else {
          node.classList.add('hidden');
        }
      });

      if (currentPageNum) currentPageNum.textContent = (index + 1).toString();
      renderControls();

      article.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    renderControls();
  }

  initPagination();
  document.addEventListener('astro:page-load', initPagination);
</script>